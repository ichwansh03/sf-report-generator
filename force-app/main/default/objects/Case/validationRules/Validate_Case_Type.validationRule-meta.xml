<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Case_Type</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Type, &apos;Inquiry&apos;),
OR(ISPICKVAL(Case_Type_Config__c, &apos;&apos;),ContactId == null), 
NOT( Non_Inquiry__c )
)</errorConditionFormula>
    <errorMessage>Case Type and Contact cannot be empty!</errorMessage>
</ValidationRule>
