<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Aging_Closed_Working_Days__c</fullName>
    <externalId>false</externalId>
    <formula>IF(IsClosed, 
(5*FLOOR((DATEVALUE(ClosedDate)-DATE(1900,1,1))/7) + 
MIN(5, MOD(DATEVALUE(ClosedDate)-DATE(1900,1,1), 7))) - 
(5*FLOOR((DATEVALUE(CreatedDate)-DATE(1900,1,1))/7) + 
MIN(5, MOD(DATEVALUE(CreatedDate)-DATE(1900,1,1), 7))), 
null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Aging Closed (Working Days)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
