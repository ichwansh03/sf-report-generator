<apex:page controller="EmailSMSLog_CustomPage_ctrl" showHeader="{!isConsole}" sidebar="{!isConsole}">
    <style>
        .efhpTitle {
        font-size: 1.8em;
        font-weight: bold;
        color: rgb(73, 75, 78);
        padding-bottom: 7px;
        }
        .efhpRow {
        padding-bottom: 3px;
        }
        .efhpDescription {
        word-wrap: break-word;
        color: #494b4e;
        min-height: 25px;
        }
        .efhpValue a {
        color: #015ba7;
        text-decoration: none;
        overflow: hidden;
        }
        .vl {
        border-left: 1px solid #dbdfe0;
        height: 70px;
        }
    </style>
    <br/>
    <table cellspacing="0" cellpadding="0">
        <tr>
            <td width="50%">
                <table>
                    <tr>
                        <td style="vertical-align: middle;" rowspan="2"><img src="/img/icon/custom51_100/chip32.png"/></td>
                        <td><div><STRONG>Email &#38; SMS Log</STRONG></div></td>
                    </tr>
                    <tr>
                        <td style="vertical-align: bottom;"><div class="efhpTitle">{!log.data.Name}</div></td>
                    </tr>
                </table>
                <!--div class="efhpRow ">
                    <div class="efhpValue efhpDescription">{!log.data.Description}</div>
                </div>-->
            </td>
        </tr>
    </table>
    <apex:form id="formId">
        <apex:pageMessages />        
        <apex:pageBlock id="LogDetail" mode="maindetail" tabStyle="Email_SMS_Log__c" title="">
            <br/>
            <apex:pageBlockButtons >
                <!--apex:commandButton action="{!save}" value="Save" status="actStatusId"/>-->
            </apex:pageBlockButtons>
            <apex:pageBlockSection title="Email & SMS Log Detail" columns="2" collapsible="false" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Email & SMS Log No"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Name}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Owner"></apex:outputLabel>
                    <apex:outputPanel ><img style="vertical-align: bottom;" width="15" height="15" src="/profilephoto/005/T"/>&nbsp;<apex:outputLink value="//{!log.data.ownerId}" >{!log.data.ownerid_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Status_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Exclude From"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Exclude_From_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Send Admin"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Send_Admin_flag_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Exclude From2"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Exclude_From2_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Template Email"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Template_Email_c}" >{!log.data.Template_Email_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Case Open Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!log.data.Case_Open_Date_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Template SMS"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Template_SMS_c}" >{!log.data.Template_SMS_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Case Type"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Case_Type_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Description"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Description_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="First Send"></apex:outputLabel>
                    <apex:outputText value="{!log.data.firstsend_s}"/>	
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status Have Email & SMS Log"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Have_Email_SMS_Log_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="First Send_F"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.First_Send_F_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="External ID"></apex:outputLabel>
                    <apex:outputText value="{!log.data.External_ID_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Ready To Send"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Ready_To_Send_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="ICF Non CCC"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.ICF_Non_CCC_c}" >{!log.data.ICF_Non_CCC_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Survey Taken"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Survey_Taken_c}" >{!log.data.Survey_Taken_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="MOT"></apex:outputLabel>
                    <apex:outputText value="{!log.data.MOT_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Response Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!log.data.Response_Date_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Use Contact Email"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Use_Contact_Email_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="ICF Walk-IN"></apex:outputLabel>
                    <apex:outputText value="{!log.data.ICF_Walk_IN_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Insurance Type"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Insurance_Type_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="SMS Information" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Division"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Division_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Short URL"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Bitly_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="MessageId JATIS"></apex:outputLabel>
                    <apex:outputText value="{!log.data.MessageId_JATIS_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="retry get status delivery"></apex:outputLabel>
                    <apex:outputText value="{!log.data.retry_status_delivery_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status JATIS"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Status_JATIS_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Description Status JATIS"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Description_Status_JATIS_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status Deliver"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Status_Deliver_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Description Status Deliver"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Description_Status_Deliver_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Date Hit JATIS"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!log.data.Date_Hit_JATIS_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >&nbsp;</apex:outputLabel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Date Received JATIS"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!log.data.Date_Received_JATIS_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Respondent Information" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Case"></apex:outputLabel>
                    <apex:outputLink value="/apex/Case_RecordDetailPage?id={!log.data.Case_c}" >{!log.data.Case_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Ext ID - IDAS"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Ext_ID_IDAS_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Account"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Account_c}" >{!log.data.Account_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Email"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Email_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Contact"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Contact_c}" >{!log.data.Contact_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Mobile"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Mobile_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Contact Short Name"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Contact_Short_Name_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Mobile_Fix"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Mobile_Fix_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Policy Number"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Policy_Number_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Mobile_Fix_Check"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Mobile_Fix_Check_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Entity"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Entity_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Case List"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Case_List_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Instant Customer Feedback Configuration" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Send Flag"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Send_Flag_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Request Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.Request_Date_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Category"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Category_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Start Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.Start_Date_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Type"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Type_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="End Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.End_Date_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Method"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Method_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Loop"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Loop_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Survey Type"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Survey_Type_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Loop Date 1"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.Loop_Date_1_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Survey"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Survey_c}" >{!log.data.Survey_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Loop Date 2"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.Loop_Date_2_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Survey_URL"></apex:outputLabel> 
                    <apex:outputText value="{!log.data.Survey_URL_c}"/> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Loop Date 3"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!log.data.Loop_Date_3_c}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="WalkIN Survey URL"></apex:outputLabel>
                    <apex:outputLink value="{!log.data.walkIN_Survey_URL_c}" >{!log.data.walkIN_Survey_URL_c}</apex:outputLink>  
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Email & SMS Template"></apex:outputLabel>
                    <apex:outputLink value="/{!log.data.Email_SMS_Template_c}" >{!log.data.Email_SMS_Template_name}</apex:outputLink>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Fg Update Contact"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!log.data.Fg_Update_Contact_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Email/SMS Text"></apex:outputLabel>
                    <apex:outputText value="{!log.data.Email_Text_c}"/>
                </apex:pageBlockSectionItem>
            
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Created By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputLink value="/{!log.data.CreatedById}" >{!log.data.CreatedBy_name}</apex:outputLink>,&nbsp;
                        <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!log.data.CreatedDate}" /> </apex:outputText>
                    </apex:outputLabel> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Last Modified By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputLink value="/{!log.data.LastModifiedById}" >{!log.data.LastModifiedBy_name}</apex:outputLink>,&nbsp;
                        <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!log.data.LastModifiedDate}" /> </apex:outputText>
                    </apex:outputLabel> 
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>