<apex:page controller="ChatTranscript_CustomPage_ctrl" showHeader="{!isConsole}" sidebar="{!isConsole}">
    <style>
        .efhpTitle {
        font-size: 1.8em;
        font-weight: bold;
        color: rgb(73, 75, 78);
        padding-bottom: 7px;
        }
        .efhpRow {
        padding-bottom: 3px;
        }
        .efhpDescription {
        word-wrap: break-word;
        color: #494b4e;
        min-height: 25px;
        }
        .efhpValue a {
        color: #015ba7;
        text-decoration: none;
        overflow: hidden;
        }
        .vl {
        border-left: 1px solid #dbdfe0;
        height: 70px;
        }
    </style>
    <br/>
    <table cellspacing="0" cellpadding="0">
        <tr>
            <td width="50%">
                <table>
                    <tr>
                        <td style="vertical-align: middle;" rowspan="2"><img src="/img/icon/livechattranscript32.png"/></td>
                        <td><div><STRONG>Chat Transcript</STRONG></div></td>
                    </tr>
                    <tr>
                        <td style="vertical-align: bottom;"><div class="efhpTitle">{!chat_transcript.data.name}</div></td>
                    </tr>
                </table>
                <!--div class="efhpRow ">
                    <div class="efhpValue efhpDescription">{!chat_transcript.data.Description}</div>
                </div>-->
            </td>
        </tr>
    </table>
    <apex:form id="formId">
        <apex:pageMessages />        
        <apex:pageBlock id="ChatTranscriptDetail" mode="maindetail" tabStyle="LiveChatTranscript" title="">
            <br/>
            <apex:pageBlockButtons >
                <!--apex:commandButton action="{!save}" value="Save" status="actStatusId"/>-->
            </apex:pageBlockButtons>
            <apex:pageBlockSection title="Chat Transcript Detail" columns="2" collapsible="false" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Chat Transcript Name"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Name}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Status}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Request Time"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.RequestTime}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Deployment"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.liveChatDeploymentId}" >{!chat_transcript.data.deployement_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Start Time"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.StartTime}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Chat Button"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.liveChatButtonId}" >{!chat_transcript.data.chatbutton_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="End Time"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.EndTime}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Primary Skill"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.skillId}" >{!chat_transcript.data.skill_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Wait Time"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.WaitTime}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Ended By"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.EndedBy}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Chat Duration"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.ChatDuration}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Owner"></apex:outputLabel>
                    <apex:outputPanel ><img style="vertical-align: bottom;" width="15" height="15" src="/profilephoto/005/T"/>&nbsp;<apex:outputLink value="/{!chat_transcript.data.OwnerId}" >{!chat_transcript.data.Owner_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Network"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.VisitorNetwork}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Refresh Manual"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.refresh_Manual_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Entity"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Entity_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Channel Type"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Channel_Type_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Ticket Number"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.ticket_Number_c}"/>
                </apex:pageBlockSectionItem>
                 <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Interval Chat"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.interval_Chat_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Live Chat Transcript in Hours"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.live_Chat_Transcript_in_Hours_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Transcript" columns="1" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Body"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.body}"  escape="false"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Body Custom"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.body_Custom_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="History Chatbot"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.History_Chatbot_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Attached Records" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Case"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/apex/Case_RecordDetailPage?id={!chat_transcript.data.CaseId}" >{!chat_transcript.data.case_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Account Name"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.AccountId}" >{!chat_transcript.data.Account_Name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Contact Name"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.ContactId}" >{!chat_transcript.data.Contact_Name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Lead"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.LeadId}" >{!chat_transcript.data.Lead_Name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="List Agent"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.list_Agent_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Visitor Details" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Chat Visitor"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!chat_transcript.data.liveChatVisitorId}" >{!chat_transcript.data.liveChatVisitorName}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Referring Site"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.referrerUri}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor Name"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.visitor_Name_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Browser"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Browser}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor Phone Number"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.visitor_Phone_Number_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Browser Language"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.browserLanguage}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor Email"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.visitor_Email_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Platform"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Platform}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Location"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.Location}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Screen Resolution"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.screenResolution}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor IP Address"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.ipAddress}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="User Agent"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.userAgent}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputPanel >&nbsp;</apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="TriggerOff"></apex:outputLabel>
                    <img src="/img/checkbox_{!IF(!chat_transcript.data.triggerOff_c, 'un', '')}checked.gif"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputPanel >&nbsp;</apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Supervisor Transcript Body"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.supervisorTranscriptBody}" escape="false"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Metrics" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor Average Response Time"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.averageResponseTimeVisitor}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Agent Average Response Time"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.averageResponseTimeOperator}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor Message Count"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.visitorMessageCount}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Agent Message Count"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.operatorMessageCount}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Visitor Maximum Response Time"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.maxResponseTimeVisitor}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Agent Maximum Response Time"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.maxResponseTimeOperator}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Abandoned After"></apex:outputLabel>
                    <apex:outputText value="{!chat_transcript.data.abandoned}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Date" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Created By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputLink value="/{!chat_transcript.data.CreatedById}" >{!chat_transcript.data.CreatedBy_Name}</apex:outputLink>,&nbsp;
                        <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.CreatedDate}" /> </apex:outputText>
                    </apex:outputLabel> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Last Modified By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputLink value="/{!chat_transcript.data.LastModifiedById}" >{!chat_transcript.data.LastModifiedBy_Name}</apex:outputLink>,&nbsp;
                        <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.LastModifiedDate}" /> </apex:outputText>
                    </apex:outputLabel> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Created Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.CreatedDate}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Last Modified Date"></apex:outputLabel>
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!chat_transcript.data.LastModifiedDate}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="StartTimeOnly"></apex:outputLabel>
                    <apex:outputText value="{0,date,hh:mm a}"> <apex:param value="{!chat_transcript.data.startTime}" /> </apex:outputText>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
        
        
        <apex:pageblock id="ChatTranscriptEvent" title="Chat Transcript Events" tabStyle="LiveChatTranscriptEvent">
                <apex:actionStatus id="status" >
                    <apex:facet name="start">
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel >
                            <apex:commandButton value="Reload" action="{!loadChatTranscriptEvent}" rerender="ChatTranscriptEvent" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus><br/>
                 <apex:pageBlockTable value="{!list_chat_events}" var="ts" rendered="{!list_chat_events.size != 0}">  
                   <apex:column headerValue="Time"><apex:outputText value="{0,date,MM/dd/yyyy hh:mm a}"> <apex:param value="{!ts.event_time}" /> </apex:outputText></apex:column>
                   <apex:column headerValue="Agent"><apex:outputLink value="/{!ts.agentId}">{!ts.agentName}</apex:outputLink> </apex:column>
                   <apex:column headerValue="Type" value="{!ts.event_type}"/>
                   <apex:column headerValue="Detail" value="{!ts.detail}"/>
               </apex:pageBlockTable>
                <apex:outputLabel value="No records to display" rendered="{!list_chat_events.size == 0}" styleClass="noRowsHeader"></apex:outputLabel>
            </apex:pageblock>
    </apex:form>
</apex:page>