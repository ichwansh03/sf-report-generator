<apex:page sidebar="false" showHeader="false" controller="ALIDashBoardEmailController">
<apex:form id="formid">
    <pbe:PageBlockTableEnhancerADV targetPbTableIds="idbackend1,idtrxpym,idtrxcla,idtrxcla2,idPHtrx" pageSizeOptions="10,50,100,200" defaultPageSize="10" enableExport="false"/>
       
   <!--body-->
    <apex:pageMessages />
    <apex:pageBlock mode="maindetail" tabStyle="Contact" >

        <!-- apex:pageBlockButtons -->
            <!-- apex:commandButton value="Refresh" reRender="formid" onclick="window.location.reload();" status="ajaxStatus"/-->
        <!-- /apex:pageBlockButtons -->
    <!-- Detail Contact-->
        <!-- apex:pageBlockSection columns="1" -->
            <!-- input type="button" value="Refresh" onClick="window.location.reload();" / -->
        <!-- /apex:pageBlockSection -->
        <apex:pageBlockSection columns="2" >
        <!-- A1 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value=""></apex:outputLabel>
        </apex:pageBlockSectionItem>
        <!-- A2 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value=""></apex:outputLabel>
        </apex:pageBlockSectionItem>
        <!-- 1 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Last Open Email All"></apex:outputLabel>
            <!-- apex:outputText value="{!LastOpenEmailAll}" ></apex:outputText -->
            <apex:outputText value="{0, date, dd-MM-yyyy HH:mm}"><apex:param value="{!LastOpenEmailAll + OffSet}" /></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 2 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Last Open Email Agent"></apex:outputLabel>
            <!-- apex:outputText value="{!LastOpenEmailAgent}"></apex:outputText -->
            <apex:outputText value="{0, date, dd-MM-yyyy HH:mm}"><apex:param value="{!LastOpenEmailAgent + OffSet}" /></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 1 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Last Open Email All - Case Number"></apex:outputLabel>
            <!-- apex:outputText value="{!LastOpenEmailAll}" ></apex:outputText -->
            <apex:outputLink value="{!$Site.prefix}/{!LastOpenEmailAllID}">{!LastOpenEmailAllNumber}</apex:outputLink>
        </apex:pageBlockSectionItem>
        <!-- 2 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Last Open Email Agent - Case Number"></apex:outputLabel>
            <apex:outputLink value="{!$Site.prefix}/{!LastOpenEmailAgentID}">{!LastOpenEmailAgentNumber}</apex:outputLink>
        </apex:pageBlockSectionItem>
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="">&nbsp;</apex:outputLabel>
        </apex:pageBlockSectionItem>
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="">&nbsp;</apex:outputLabel>
        </apex:pageBlockSectionItem>
        <!-- 3 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="First Open Email All"></apex:outputLabel>
            <!-- apex:outputText value="{!FirstOpenEmailAll}" ></apex:outputText -->
            <apex:outputText value="{0, date, dd-MM-yyyy HH:mm}"><apex:param value="{!FirstOpenEmailAll + OffSet}" /></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 4 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="First Open Email Agent"></apex:outputLabel>
            <!-- apex:outputText value="{!FirstOpenEmailAgent}"></apex:outputText -->
            <apex:outputText value="{0, date, dd-MM-yyyy HH:mm}"><apex:param value="{!FirstOpenEmailAgent + OffSet}" /></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 3 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="First Open Email All - Case Number"></apex:outputLabel>
            <apex:outputLink value="{!$Site.prefix}/{!FirstOpenEmailAllID}">{!FirstOpenEmailAllNumber}</apex:outputLink>
        </apex:pageBlockSectionItem>
        <!-- 4 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="First Open Email Agent - Case Number"></apex:outputLabel>
            <apex:outputLink value="{!$Site.prefix}/{!FirstOpenEmailAgentID}">{!FirstOpenEmailAgentNumber}</apex:outputLink>
        </apex:pageBlockSectionItem>
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="">&nbsp;</apex:outputLabel>
        </apex:pageBlockSectionItem>
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="">&nbsp;</apex:outputLabel>
        </apex:pageBlockSectionItem>
        <!-- 5 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Total Open Case All"></apex:outputLabel>
            <apex:outputText value="{!CountOpenCaseAll}" ></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 6 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Total Open Case Agent"></apex:outputLabel>
            <apex:outputText value="{!CountOpenCaseAgent}"></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 7 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Total Closed Case All - Today"></apex:outputLabel>
            <apex:outputText value="{!CountClosedCaseAll}" ></apex:outputText>
        </apex:pageBlockSectionItem>
        <!-- 8 -->
        <apex:pageBlockSectionItem >
            <apex:outputLabel value="Total Closed Case Agent - Today"></apex:outputLabel>
            <apex:outputText value="{!CountClosedCaseAgent}"></apex:outputText>
        </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
        
    </apex:pageBlock>
</apex:form>
</apex:page>