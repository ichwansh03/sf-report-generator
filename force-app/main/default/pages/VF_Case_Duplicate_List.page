<apex:page controller="CaseDuplicateListController" >
    <apex:includeScript value="/support/console/46.0/integration.js"/>
    <style>
        h1.page-title {
            padding-top: 20px;
        }
    </style>

    <apex:form style="padding-top:30px">
        <apex:pageBlock title="Duplicate Case List">

            <!-- Tombol pindah ke atas -->
            <!-- <apex:pageBlockButtons location="top">
                <apex:commandButton value="Close" onclick="closeThisTab(); return false;" />
            </apex:pageBlockButtons> -->

            <!-- Show detail always if caseItem is not null -->
            <apex:pageBlockSection title="Case Detail" columns="2" rendered="{!NOT(ISNULL(caseItem))}">
                <apex:outputField label="Case Number" value="{!caseItem.CaseNumber}" />
                <apex:outputField label="Subject" value="{!caseItem.Subject}" />
                <apex:outputField label="Status" value="{!caseItem.Status}" />
                <apex:outputField label="Priority" value="{!caseItem.Priority}" />
                <apex:outputField label="Created Date" value="{!caseItem.CreatedDate}" />
                <apex:outputField label="Email Nasabah" value="{!caseItem.SuppliedEmail}" />
                <apex:outputField label="Description" value="{!caseItem.Description}" />
            </apex:pageBlockSection>

            <!-- Show table if list is not empty -->            <apex:includeScript value="/support/console/46.0/integration.js"/>
            <apex:pageBlockTable value="{!cases}" var="c" rendered="{!NOT(ISNULL(cases)) && (cases.size > 0)}">
                
                <apex:column headerValue="Case Number">
                    <a href="javascript:void(0);" onclick="openCaseInConsole('{!c.Id}', '{!c.CaseNumber}');">{!c.CaseNumber}</a>
                </apex:column>

                <apex:column headerValue="Subject" value="{!c.Subject}"/>
                <apex:column headerValue="Status" value="{!c.Status}"/>
                <apex:column headerValue="Priority" value="{!c.Priority}"/>
                <apex:column headerValue="Created Date" value="{!c.CreatedDate}"/>
                <apex:column headerValue="Description" value="{!c.Description}"/>
            </apex:pageBlockTable>

            <!-- Show message if list is empty -->
            <apex:outputPanel rendered="{!ISNULL(cases) || (cases.size == 0)}">
                <p style="padding: 10px; font-style: italic;">Tidak ada case yang duplikat.</p>
            </apex:outputPanel>

        </apex:pageBlock>
    </apex:form>

    <script>
        function closeThisTab() {
            if (typeof sforce != 'undefined' && sforce.console && sforce.console.isInConsole()) {
                        console.log('close :>> ', true);
                        // Untuk Lightning Console
                        if (window.sforce && sforce.one) {
                            sforce.one.closeTab();
                        } else {
                            // Untuk Classic Console
                            sforce.console.getEnclosingTabId(function(result) {
                                var tabId = result.id;
                                sforce.console.closeTab(tabId);
                            });
                        }
                    } else {
                        // Jika bukan di console, bisa redirect atau tutup window
                    
                        window.close();
                    }
        }
  function openCaseInConsole(recordId, caseNumber) {
    // Selalu buka di window/tab browser baru
    window.open('/' + recordId, '_blank');
  }


    </script>
</apex:page>