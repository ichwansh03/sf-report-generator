                <apex:column > <apex:facet name="header">Description</apex:facet> {!claim.Description}</apex:column>
                <apex:column > <apex:facet name="header">Accident<br/>Place</apex:facet> {!claim.AccidentPlace}</apex:column>
                <apex:column > <apex:facet name="header">Repair<br/>Shop</apex:facet> {!claim.RepairShop}</apex:column>
                <apex:column > <apex:facet name="header">Approval<br/>Payment Date</apex:facet> <apex:outputText value="{0, date, dd-MM-yyyy}"><apex:param value="{!claim.ApprPayDate}" /></apex:outputText></apex:column>
                <apex:column > <apex:facet name="header">Payment<br/>Date</apex:facet> <apex:outputText value="{0, date, dd-MM-yyyy}"><apex:param value="{!claim.PaymentDate}" /></apex:outputText></apex:column>
                <apex:column > <apex:facet name="header">Driver Name</apex:facet> {!claim.DriverName}</apex:column>
            </apex:pageBlockTable>
        </apex:pageBlockSection>
        
        <apex:pageBlockSection title="Endorsement" collapsible="true" columns="6">
            <apex:pageBlockTable id="idendorse" value="{!giEndorsementList}" var="endor" style="overflow:auto;width:1000px;" align="center" border="1">
                <!-- <apex:column headerValue="Policy No">{!endor.PolicyNo}</apex:column>  -->
                <apex:column headerValue="Certificate No">{!endor.CertificateNo}</apex:column>
                <apex:column headerValue="Contract Type">{!endor.ContractType}</apex:column>
                <apex:column headerValue="Inforce Date"><apex:outputText value="{0, date, dd-MM-yyyy}"><apex:param value="{!endor.InforceDate}" /></apex:outputText></apex:column>
                <apex:column headerValue="Start Date"><apex:outputText value="{0, date, dd-MM-yyyy}"><apex:param value="{!endor.StartDate}" /></apex:outputText></apex:column>
                <apex:column headerValue="End Date"><apex:outputText value="{0, date, dd-MM-yyyy}"><apex:param value="{!endor.EndDate}" /></apex:outputText></apex:column>
                <apex:column headerValue="Endorsement Remark">{!endor.EndorsementRemark}</apex:column>
                <apex:column headerValue="Status">{!endor.Status}</apex:column>
                <apex:column headerValue="Type">{!endor.TypeGI}</apex:column>
            </apex:pageBlockTable>
        </apex:pageBlockSection>
        
        <apex:pageBlockSection title="Interest Info" collapsible="true" columns="6">
            <apex:pageBlockTable id="idinterest" value="{!interestInfoList}" var="inter" style="overflow:auto;width:1000px;" align="center" border="1">
                <apex:column headerValue="Add Cover Code">{!inter.AddCoverCode}</apex:column>
                <apex:column headerValue="Add Cover Name">{!inter.AddCoverName}</apex:column>
                <apex:column headerValue="Add Cover Type">{!inter.AddCoverType}</apex:column>
                <apex:column headerValue="Add Cover Premium" style="text-align: right;"><apex:outputText value="{!polisRider.MataUang}{0, number, ###,###,###,###.00}"> <apex:param value="{!inter.AddCoverPremium}"/></apex:outputText></apex:column>
                <apex:column headerValue="Sum Insured of Add Cover" style="text-align: right;"><apex:outputText value="{!polisRider.MataUang}{0, number, ###,###,###,###.00}"> <apex:param value="{!inter.SIofAddCover}"/></apex:outputText></apex:column>
            </apex:pageBlockTable>
        </apex:pageBlockSection>
    </apex:pageBlock>
    <!-- End of block for GI policy -->
  </div>
