                            <h1 class="question">
                                <span class="questionNumber">{!qPreview.orderNumber}. </span>
                                    {!qPreview.question}
                                <!--
                                <apex:outputPanel rendered="{!qPreview.required}" styleClass="requiredText">
                                    ({!$Label.LABS_SF_Required})
                                </apex:outputPanel>
                                -->
                                <span style="font-style:italic; font-weight: normal; display:{!if(qPreview.questionTranslate!=null,"inline","none")};">
                                    <br/>
                                    {!qPreview.orderNumber}. 
                                    <apex:outputText style="font-style:italic; font-weight: normal;" value="{!qPreview.questionTranslate}"></apex:outputText>
                                </span>
                            </h1>
                            <div id="radio"> 
                                <apex:selectRadio layout="pageDirection" rendered="{!qPreview.renderSelectRadio}" value="{!qPreview.selectedOption}" disabled="TRUE">
                                    <apex:selectOptions value="{!qPreview.singleOptions}"/>
                                </apex:selectRadio>
                            </div>
                            <div id="checkbox">
                                <apex:selectCheckboxes layout="pageDirection" rendered="{!qPreview.renderSelectCheckboxes}" value="{!qPreview.selectedOptions}" >
                                    <apex:selectOptions value="{!qPreview.multiOptions}"/>
                                </apex:selectCheckboxes> 
                            </div>
                            <div id="text"> 
                               <apex:inputTextArea cols="50" rows="10" rendered="{!qPreview.renderFreeText}" value="{!qPreview.choices}"/>  
                            </div>
                            <div id="row" style="display:{!if(isAnswerImage,"none","block")};">
                              <apex:selectRadio id="rdSelectRow" rendered="{!qPreview.renderSelectRow}" value="{!qPreview.selectedOption}">
                                <apex:selectOptions value="{!qPreview.rowOptions}"/>
                              </apex:selectRadio>
                            </div>
                            <div id="rowImage" style="display:{!if(isAnswerImage,"block","none")};">

                                <!-- apex:outputText rendered="{!qPreview.renderSelectRow}"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {!IF (rowNum == 0,"Sangat Puas (Most Satisfied)",IF(rowNum == 5,"Sangat Ingin (Most Likely)", "Sangat Setuju (Most Agree)"))} &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {!IF (rowNum == 0,"Sangat Tidak Puas (Least Satisfied)",IF(rowNum == 5,"Sangat Tidak Ingin (Least Likely)", "Sangat Tidak Setuju (Least Agree)"))} </apex:outputText -->
