<apex:page id="takeSurvey" standardcontroller="Survey__c" extensions="ViewSurveyLiveChatController" cache="false" sidebar="false" showheader="false">
    <apex:includeScript value="{!$Resource.jquery_1_10_2}"/>
    <script src="/soap/ajax/34.0/connection.js"></script>
    <script id="clientEventHandlersJS" language="javascript">
        $(document).ready(function() {
            
        });
        
        function syncAnswer(elem) {
            var ansRowElementName = elem.id;
            var ansRowElementIndex = ansRowElementName.substring(8,9);
            var ansRowElementValue = elem.value;
            var ansOriginalElementId = 'takeSurvey:theForm:pbMainQuestion:aQPreview:' + ansRowElementIndex + ':pblock:rdSelectRow';
            $("input[type='radio'][name$='" + ansOriginalElementId + "'][value='" + ansRowElementValue + "']").prop('checked',true);
        }    
    </script>   
    
    <style>
        <apex:outputText value="{!surveyContainerCss}" />
    </style>

    <div id="survey_container">
        <apex:form id="theForm">
            <!-- HEADER -->
            <apex:outputPanel id="seeSurvey" rendered="{!thankYouRendered == false}" >
                <apex:outputField value="{!Survey__c.Survey_Header__c}"/>
                <h1><apex:outputField value="{!Survey__c.Name}" rendered="{!Survey__c.Hide_Survey_Name__c == false}" /></h1>
            </apex:outputPanel>
            <apex:pageMessages id="errorMsg" />
            
            <!-- MAIN QUESTION -->
            <apex:pageBlock id="pbMainQuestion" rendered="{!thankYouRendered == false}" > 
