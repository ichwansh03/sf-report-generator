<apex:page standardController="Case">
    <script src="/soap/ajax/37.0/connection.js" type="text/javascript"></script>
    <script src="/soap/ajax/37.0/apex.js" type="text/javascript"></script>
    <script src="/support/console/26.0/integration.js" type="text/javascript"></script>
    <script>
        
        function updateStatusThenRedirect(){
            sforce.connection.sessionId="{!$Api.Session_ID}";
            var rs = sforce.connection.query("Select Email_Status__c, Id from Case where Id = '{!$CurrentPage.parameters.Id}' and (Email_Status__c = 'Unread' or Email_Status__c = '')");
            records = rs.getArray("records");
            //alert('found : '+records.length);
            if(records.length>0){
                //var cs = new sforce.SObject("Case");
                //cs.Id = "{!$CurrentPage.parameters.Id}";
                var cs = records[0];
                cs.Email_Status__c = "Read";    
                var result = sforce.connection.update([cs]);
                //alert(result);
                if(result[0].getBoolean("success")){
                    //log("case with id " + result[0].id + " updated!");
                    redirectToPage();
                }else{
                    alert("failed to update case " + result[0]);
                    log("failed to update case " + result[0]);
                }                
            }else{
                redirectToPage();
            }

        }
        
        function redirectToPage(){
            var url = '/{!$CurrentPage.parameters.Id}';
            if (sforce.console.isInConsole()) { 
                sforce.console.getEnclosingTabId(function(enclosingResult){ 
                    sforce.console.getEnclosingPrimaryTabId(function(){ 
                        sforce.console.openPrimaryTab(null, url, true, 'Case Email', null); 
                    }); 
                }); 
            }else {
                window.location.href = url; 
            }     
        }
        
        window.onload = updateStatusThenRedirect;
    </script>
</apex:page>