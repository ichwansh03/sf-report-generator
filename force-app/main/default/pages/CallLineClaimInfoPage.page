    <script type="text/javascript"> 
        var Imtech = {};
        Imtech.Pager = function() {
            this.datasetname='';
            this.pagername='';
            this.paragraphsPerPage = 100;
            this.currentPage = 1;
            this.pagingControlsContainer = '';
            //this.pagingContainerPath = '#content';
            this.pagingInfoContainer = '';
            this.numberOfRecords= 0;
            
            this.firstPage = 1;
            this.previousPage = 1;
            this.nextPage = 2;
            
            this.numPages = 5;
            this.lastDataPage=0;
            this.showControl=true;
            /*
            this.numPages = function() {
                var numPages = 0;
                
                numPages = 3;
                /*
                if (this.paragraphs != null && this.paragraphsPerPage != null) {
                    numPages = Math.ceil(this.paragraphs.length / this.paragraphsPerPage);
                }
                */
              /*  
                return numPages;
            };
            */
            
            this.lastPage = this.numPages;
            this.showPage = function(page) {
                //this.currentPage = page;
                //alert('a');
                var startOfRecords = 0;
                
                // Set start time
                var start_time = new Date().getTime();
                
                //var numberOfRecords= 0;
                switch (this.datasetname) {
                    case "ClaimDetailLife": 
                        //alert('r');
                        startOfRecords = (numberOfRecords * (page-1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingClaimDetailLife(policyNo, entity, policyApp, '', '', 0, startOfRecords, numberOfRecords, this.currentPage, page, 1, 1) ; break;
                        
                    case "ClaimDetailGI": 
                        //alert('s');
                        startOfRecords = (numberOfRecords * (page-1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingClaimDetailGI(policyNo, entity, policyApp, '', '', 0, startOfRecords, numberOfRecords,  page) ; break;
                                        
                    case "AssNotesCLM": 
                        //alert('g');
                        startOfRecords = (numberOfRecords * (page-1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingAssNotesCLM(policyNo, entity, policyApp, 'Assessment Notes Summary', 'CRM', '', '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords,  page, 1, 0) ; break;
            
                }

                
                
                /*var html = '';
        
                this.paragraphs.slice((page-1) * this.paragraphsPerPage,
                    ((page-1)*this.paragraphsPerPage) + this.paragraphsPerPage).each(function() {
                    html += '<div>' + $(this).html() + '</div>';
                });
                
                
                $(this.pagingContainerPath).html(html);
                */
                var request_time = new Date().getTime() - start_time;
                var request_times = new Date().getTime() + ' - ' + start_time + ' : ' +request_time;
                
                //renderControls(this.pagingControlsContainer, this.currentPage, this.numPages, this.pagername, this.showControl);
                this.currentPage = page;
            }

            this.reRenderControls = function () {
                console.log('lastDataPage : ' + this.lastDataPage);
                renderControls(this.pagingControlsContainer, this.currentPage, this.numPages, this.pagername, '', this.lastDataPage);
                //this.currentPage = page;
            }
            
            var renderControls = function(container, currentPage, numPages, pagername, requestTime, lastDataPage ) {
                /*
                var firstPage = 1;
                var previousPage = currentPage==1 ? 1 : currentPage - 1 ;
                var nextPage = currentPage + 1;
                var lastPage = numPages;
                */
                console.log (' ** in renderControls **');
                var firstPage = 1;
                var previousPage = currentPage==1 ? 1 : currentPage - 1 ;
                //var nextPage = currentPage==numPages ? numPages : currentPage + 1;
                var nextPage = currentPage + 1;
                var lastPage = numPages;
                
                var pagingControls = '';
                
                //pagingControls += '<img id="loadingimg' + pagername +  '" style="display:none" src="/img/loading.gif" /> ' ;
                pagingControls += '<ul class="pagination">' ;

                if (currentPage ==1) {htmlBtnStatus=' class="disabled" ';} else {htmlBtnStatus=' href="#" ';}
                pagingControls += '<li> <a ' + htmlBtnStatus + ' onclick="' + pagername  +'.showPage(' + firstPage  + '); return false;"> First </a> </li> ';
                pagingControls += '<li> <a ' + htmlBtnStatus + ' onclick="' + pagername  +'.showPage(' + previousPage  + '); return false;"> Previous </a> </li>';
                                
                var j=0;
                var penambah = currentPage - 2;
                if (currentPage ==1) {penambah = 0;}
                
                for (var i = 1; i <= numPages; i++) {
                    //console.log('<li><a href="#" onclick="pager.showPage(' + j  + '); return false;">' + j + '</a></li>');
                    j = i + penambah;
                    if (j != currentPage) {
                        if (j>lastDataPage && lastDataPage != 0) {
                            //pagingControls += '<li>' + j  + '</li>';
                            pagingControls += '<li><a class="disabled" >' + j  + '</a></li>';
                            
                            
                        }
                        else {
                        pagingControls += '<li><a href="#" onclick="' + pagername  +'.showPage(' + j  + '); return false;">' + j + '</a></li>';
                        }
                    } else {
                        pagingControls += '<li><a class="active" >' + j  + '</a></li>';
                    }
                }
        
                //pagingControls += '<li>Next</li> <li>Last</li>';
                
                if ( currentPage >=lastDataPage && lastDataPage!=0){
                    pagingControls += '<li><a class="disabled" > Next </a> </li>';
                }
                else {
                    pagingControls += '<li> <a href="#" onclick="' + pagername  +'.showPage(' + nextPage  + '); return false;"> Next </a> </li>';
                }
                //pagingControls += '<li> <a href="#" onclick="pager.showPage(' + lastPage  + '); return false;"> Last </a> </li>';
                
                pagingControls += '</ul>';
        
                $(container).html(pagingControls);
            }
            
            
            this.renderInfo = function(info) {
                //alert (this.pagingInfoContainer + '-' +  info);
                info = '<small><i>' + info + '</i></small>';
                $( this.pagingInfoContainer).html(info);
            }
        }
    </script>
    
    <style type="text/css">
        
        /*
        #pagingControlClaimDetailLife ul{display:inline;padding-left:0.0em; padding-right:0.0em}
        #pagingControlClaimDetailLife li{display:inline;padding-right:0 0.5em}
        
        #pagingControlClaimDetailGI ul{display:inline;padding-left:0.0em; padding-right:0.0em}
        #pagingControlClaimDetailGI li{display:inline;padding-right:0 0.5em}
        ul.pagination { display: inline-block; padding: 0; margin: 0; }
        */
        
        ul.pagination { display: inline-block; padding: 0; margin: 0; }
        ul.pagination li {display: inline;}
        ul.pagination li a {display: inline; color: black; float: left; padding: 8px 16px; text-decoration: none; transition: background-color .3s; border: 1px solid #ddd; }
        .pagination li:first-child a { border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
        .pagination li:last-child a { border-top-right-radius: 5px; border-bottom-right-radius: 5px; }
        ul.pagination li a.active { background-color: #338ddb; color: white; border: 1px solid #338ddb; }
        ul.pagination li a:hover:not(.active) {background-color: #ddd;}

        ul.pagination li a.disabled { background-color: #ddd; color: grey; border: 1px solid #ddd;}
        
    </style>
    
