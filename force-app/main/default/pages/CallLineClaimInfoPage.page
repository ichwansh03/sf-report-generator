                                    }
                                    end_time = performance.now(); //new Date().getTime();
                                    duration = end_time - start_time;
                                    duration = duration.toFixed(3);
                                    
                                    if (show == 1) {
                                        pagerANCLM.renderInfo('Load duration : ' + duration + ' milliseconds');
                                        console.log('duration   : ' + duration);    
                                    }
                                    
                                    // lazy loading for next page ::
                                    var nextPageNumber= pageNumber +1;
                                    if (extra >0 && (assNotesCLMPaging[nextPageNumber] ==null || assNotesCLMPaging[nextPageNumber] == undefined)) {
                                        extra=extra-1;
                                        startOfRecords = (numberOfRecords * nextPageNumber) + 1;                                        
                                        loadDataPagingAssNotesCLM(policyNo, entity, policyApp, operation, classType, refNo, '', '', rowPerPage, startOfRecords, numberOfRecords,  nextPageNumber, 0, extra) ;
                                    }
                                }
                            }, {escape: true}
                        );    
                    
                   }              
               }
               
    </script>
    

    <!-- .End of Java Script -->
    
