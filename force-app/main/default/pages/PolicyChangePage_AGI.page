                    <apex:actionFunction name="refreshPageMessages" reRender="panelPageMessages"/>
                
                    <apex:actionFunction name="callMethodSyncDataOfPolicyInfo" action="{!loadDataSeq2and3}" onComplete="afterLoad();" />
                
                    <apex:actionFunction name="preparingPageDataFunc" action="{!preparingPageDataCallFromPage}" onComplete="refreshPolicyInfo();">
