                    var tmpArray = null;
                    
                    if (classType == 'POS') {
                        tmpArray = assNotesPOSPaging[pageNumber];
                        assNotesHolderObj =  document.getElementById('{!$Component.blockid.formid.assNotesPOSHolder}');
                    } else if (classType == 'PA') {
                        tmpArray = assNotesPAPaging[pageNumber];
                        assNotesHolderObj =  document.getElementById('{!$Component.blockid.formid.assNotesPAHolder}');
                    } else if (classType == 'UW') {
                        tmpArray = assNotesUWPaging[pageNumber];
                        assNotesHolderObj =  document.getElementById('{!$Component.blockid.formid.assNotesUWHolder}');
                    } else if (classType == 'OTH') {
                        tmpArray = assNotesOTHPaging[pageNumber];
                        assNotesHolderObj =  document.getElementById('{!$Component.blockid.formid.assNotesOTHHolder}');
                    }
                    
                    if (tmpArray != null || tmpArray != undefined) {
                        assNotesHolderObj.value = tmpArray;
                        console.log('jadi:' + tmpArray); 
                        
                        refreshAssNotesPOS();
                        
                        if (classType == 'POS') {
                            refreshAssNotesPOS();
                        } else if (classType == 'PA') {
                            refreshAssNotesPA();
                        } else if (classType == 'UW') {
                            refreshAssNotesUW();
                        } else if (classType == 'OTH') {
                            refreshAssNotesOTH();
                        }
                        
                        refreshPageMessages();
                    } else {
                        Visualforce.remoting.Manager.invokeAction(
                            // param : getRemoteDataAssessmentNotes (String policyNo, String entity, String policyApp, string operation, string classType, string refNo,
                            // String startDateTime, String endDateTime, Integer rowPerPage, Integer startOfRecords, Integer numberOfRecords, Integer pageNumber) 
                            '{!$RemoteAction.RemoteDataController.getRemoteDataAssessmentNotes}', 
                                policyNo, entity, policyApp, operation, classType, refNo, 
                                startDateTime, endDateTime, rowPerPage, startOfRecords, numberOfRecords, pageNumber,
                            function (result, event) {
                                if (event.status) {
                                    console.log('loadDataPagingAssNotes : ' + result);
                                    assNotesPOSPaging[pageNumber] = result;
                                    console.log('AN :' + assNotesPOSPaging[pageNumber]);
                                    
                                    assNotesHolderObj.value = result;
                                    
                                    if (classType == 'POS') {
                                        refreshAssNotesPOS();
                                    } else if (classType == 'PA') {
                                        refreshAssNotesPA();
                                    } else if (classType == 'UW') {
                                        refreshAssNotesUW();
                                    } else if (classType == 'OTH') {
                                        refreshAssNotesOTH();
                                    }
                                    
                                    refreshPageMessages();
                                }
                            }, {escape: true}
                        );
                    }
                }

        //showAgentInfo on click
        function loadDataAgentInfoClick() {
            loadDataAgentInfo();
        }

        function loadDataAgentInfo() {
            console.log('execute load agent data info');
            //console.log(policyNo + '-' + entity + '-' + policyApp + '-' + startDateTime + '-' + endDateTime + '-' + 
            //rowPerPage + '-' + startOfRecords + '-' + numberOfRecords + '-' + pageNumber);
            var agentInfoHolderObj = document.getElementById('{!$Component.blockid.formid.agentInfoHolder}');

            Visualforce.remoting.Manager.invokeAction(
                // param : String policyNo, String entity, String policyApp, 
                // String startDateTime, String endDateTime, Integer rowPerPage, Integer startOfRecords, Integer numberOfRecords, Integer pageNumber
                '{!$RemoteAction.RemoteDataController.getRemoteDataAgentInfo}', 
                    //policyNo, entity, policyApp, 'Agent Info', '', '', 0, 0, 0, 0,
                    '{!agentServicingCode}', entity, policyApp, 'Agent Info', '', '', 0, 0, 0, 0,
                function (result, event) {
                    if (event.status) {
                        console.log('loadDataAgentInfo: ' + result);
                        agentInfoHolderObj.value = result;
                        refreshAgentInfo(); refreshPageMessages();
                    }
                }, {escape: true}
            );
        }
            
        function loadDataAgentReportingStructureHierarchy() {
            var agentReportingStructureHierarchyHolderObj = document.getElementById('{!$Component.blockid.formid.agentReportingStructureHierarchyHolder}');

            Visualforce.remoting.Manager.invokeAction(
                // param : String policyNo, String entity, String policyApp, 
                // String startDateTime, String endDateTime, Integer rowPerPage, Integer startOfRecords, Integer numberOfRecords, Integer pageNumber
                '{!$RemoteAction.RemoteDataController.getRemoteDataAgentInfo}', 
                    //policyNo, entity, policyApp, 'Reporting Structure Hierachy', null, null, null, null, null, null,
                    '{!agentServicingCode}', entity, 'IDAS', 'Reporting Structure Hierarchy', null, null, null, null, null, null,
                function (result, event) {
                    if (event.status) {
                        console.log('loadDataAgentReportingStructureHierarchy: ' + result);
                        agentReportingStructureHierarchyHolderObj.value = result;
                        refreshAgentReportingStructureHierarchy(); refreshPageMessages();
                    }
                }, {escape: true}
            );
        }

    </script>
    <!-- .End of Java Script -->
    
