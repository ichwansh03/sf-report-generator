            this.numberOfRecords = 0;
            this.firstPage = 1;
            this.previousPage = 1;
            this.nextPage = 2;
            this.numPages = 5;
            this.showControl = true;
            
            /*
            this.numPages = function() {
                var numPages = 0;
                
                numPages = 3;
                /*
                if (this.paragraphs != null && this.paragraphsPerPage != null) {
                    numPages = Math.ceil(this.paragraphs.length / this.paragraphsPerPage);
                }
                */
              /*  
                return numPages;
            };
            */
            
            this.lastPage = this.numPages;
            this.showPage = function(page) {
                
                //('a : ' + this.datasetname);
                var startOfRecords = 0;
                //var numberOfRecords= 100;
                switch (this.datasetname) {
                    case "BeneficiaryDetail":
                        startOfRecords = (this.numberOfRecords * (page - 1)) + 1;
                        loadDataPagingBeneficiaryDetail(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                        
                    case "PremiumBreakdown":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingPremiumBreakdown(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                    
                    case "PolicyChangeLife":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingPolicyChangeLife(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                    
                    case "EndorsementGI":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingEndorsementGI(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                    
                    case "RiskInfo":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingRiskInfo(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                    
                    case "CashValueDetail":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingCashValueDetail(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                    
                    case "AccountDetail":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingAccountDetail(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page); 
                        break;
                    
                    case "AssNotesPOS":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingAssNotesPOS(policyNo, entity, policyApp, 'Summary', 'POS', '', '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page, 1, 0); 
                        break;
                    
                    case "AssNotesPA":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingAssNotesPA(policyNo, entity, policyApp, 'Summary', 'PA', '', '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page, 1, 0); 
                        break;
                    
                    case "AssNotesUW":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingAssNotesUW(policyNo, entity, policyApp, 'Summary', 'UW', '', '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, this.currentPage, page, 1, 0); 
                        break;
                    
                    case "AssNotesOTH":
                        startOfRecords = (numberOfRecords * (page - 1)) + 1;
                        numberOfRecords = numberOfRecords;
                        loadDataPagingAssNotesOTH(policyNo, entity, policyApp, 'Summary', 'OTH', '', '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, page, 1, 0); 
                        break;

                }
                
                /*
                var html = '';
                this.paragraphs.slice((page - 1) * this.paragraphsPerPage,
                    ((page - 1)*this.paragraphsPerPage) + this.paragraphsPerPage).each(function() {
                    html += '<div>' + $(this).html() + '</div>';
                });
                $(this.pagingContainerPath).html(html);
                */
        
                renderControls(this.pagingControlsContainer, page, this.numPages, this.pagername, this.showControl);
                this.currentPage = page;
            }
        
            var renderControls = function(container, currentPage, numPages, pagername, showControl) {
                /*
                var firstPage = 1;
                var previousPage = currentPage==1 ? 1 : currentPage - 1;
                var nextPage = currentPage + 1;
                var lastPage = numPages;
                */
                
                var firstPage = 1;
                var previousPage = currentPage==1 ? 1 : currentPage - 1;
                //var nextPage = currentPage==numPages ? numPages : currentPage + 1;
                var nextPage = currentPage + 1;
                var lastPage = numPages;
                var pagingControls = '';
                
                console.log ('showControl :', showControl);
                if (showControl == true) {
                    pagingControls += '<ul class="pagination">';
                    pagingControls += '<li> <a href="#" onclick="' + pagername + '.showPage(' + firstPage + '); return false;"> First </a> </li> ';
                    pagingControls += '<li> <a href="#" onclick="' + pagername + '.showPage(' + previousPage + '); return false;"> Previous </a> </li>';
                    
                    var j = 0;
                    var penambah = currentPage - 2;
                    if (currentPage == 1) {penambah = 0;}
                    
                    for (var i = 1; i <= numPages; i++) {
                        //console.log('<li><a href="#" onclick="pager.showPage(' + j + '); return false;">' + j + '</a></li>');
                        j = i + penambah;
                        if (j != currentPage) {
                            pagingControls += '<li><a href="#" onclick="' + pagername + '.showPage(' + j + '); return false;">' + j + '</a></li>';
                        } else {
                            pagingControls += '<li><a class="active" href="#">' + j + '</a></li>';
                        }
                    }
            
                    //pagingControls += '<li>Next</li> <li>Last</li>';
                    pagingControls += '<li> <a href="#" onclick="' + pagername + '.showPage(' + nextPage + '); return false;"> Next </a> </li>';
                    //pagingControls += '<li> <a href="#" onclick="pager.showPage(' + lastPage + '); return false;"> Last </a> </li>';
                    pagingControls += '</ul>';
                }
                console.log ('pagingControls : ', pagingControls);
                $(container).html(pagingControls);
            }
            
            this.renderInfo = function(info) {
                //alert (this.pagingInfoContainer + '-' + info);
                info = '<small><i>' + info + '</i></small>';
                $( this.pagingInfoContainer).html(info);
            }
        }
    </script>
    
