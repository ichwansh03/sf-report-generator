                    <apex:actionFunction name="refreshPolicyChangeLife" reRender="panelPolicyChangeLife"/>
        
                    <apex:inputHidden value="{!endorsementGIJSON}" id="endorsementGIHolder" />
                    <apex:actionFunction name="refreshEndorsementGI" reRender="panelEndorsementGI"/>
                         
                    <apex:inputHidden value="{!riskInfoJSON}" id="riskInfoHolder" />
                    <apex:actionFunction name="refreshRiskInfo" reRender="panelRiskInfo"/>
        
                    <apex:inputHidden value="{!cashValueDetailJSON}" id="cashValueDetailHolder" />
                    <apex:actionFunction name="refreshCashValueDetail" reRender="panelCashValueDetail"/>
                    
                    <apex:inputHidden value="{!accountDetailJSON}" id="accountDetailHolder" />
                    <apex:actionFunction name="refreshAccountDetail" reRender="panelAccountDetail"/>         
                    -->
                    
                    <apex:inputHidden value="{!premiumBreakdownJSON}" id="premiumBreakdownHolder" />
                    <apex:actionFunction name="refreshPremiumBreakdown" reRender="panelPremiumBreakdown"/>
                    
                    <apex:actionFunction name="refreshAssNotesPOS" reRender="panelAssNotesPOS"/>
        
                    <apex:actionFunction name="refreshAssNotesPA" reRender="panelAssNotesPA"/>
        
                    <apex:actionFunction name="refreshAssNotesOTH" reRender="panelAssNotesOTH"/>
                    
                    <apex:inputHidden value="{!agentInfoJSON}" id="agentInfoHolder" />
                    <apex:actionFunction name="refreshAgentInfo" reRender="panelAgentInfo"/>
                     
                    <!--<apex:inputHidden value="{!agentReportingStructureHierarchyJSON}" id="agentReportingStructureHierarchyHolder" />-->
                    <apex:actionFunction name="refreshAgentReportingStructureHierarchy" reRender="panelAgentReportingStructureHierarchy"/>
                    
