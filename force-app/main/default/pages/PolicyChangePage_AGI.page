                        <apex:column headerValue="Start Date"><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!endor.StartDate}" /></apex:outputText></apex:column>
                        <apex:column headerValue="End Date"><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!endor.EndDate}" /></apex:outputText></apex:column>
                        <apex:column headerValue="Endorsement Remark">{!endor.EndorsementRemark}</apex:column>
                        <apex:column headerValue="Status Description">{!endor.StatusDescription}</apex:column>
                        <apex:column headerValue="Type Description">{!endor.TypeDescription}</apex:column>
                    </apex:pageBlockTable>
                    </apex:outputPanel>
                </apex:pageBlockSection> 
                <!-- *** .END POLICY CHANGE -->  
              
                <apex:form id="Formid">         
                    <!--  
                    <apex:inputHidden value="{!beneficiaryDetailJSON}" id="beneficiaryDetailHolder" />
                    <apex:actionFunction name="refreshBeneficiaryDetail" reRender="panelBeneficiaryDetail"/>
                    
                    <apex:inputHidden value="{!premiumBreakdownJSON}" id="premiumBreakdownHolder" />
