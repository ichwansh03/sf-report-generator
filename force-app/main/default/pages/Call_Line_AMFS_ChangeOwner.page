<apex:page controller="Call_Line_AMFS_ChangeOwner_Ctrl" showHeader="true" sidebar="false">
<html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
<apex:sectionHeader title="" subtitle="Manage AMFS Call Line Owner"/>
    <!--<pbe:PageBlockTableEnhancerADV targetPbTableIds="idpbt" pageSizeOptions="25,50,100" defaultPageSize="100" enableExport="false"/>-->

<apex:form id="formid">
    <apex:pageMessages />
    <apex:pageBlock >
      <div align="left">
           <apex:pageBlockButtons >
          	<apex:commandButton action="{!save}" value="Save" />
          </apex:pageBlockButtons>
      </div>
        <!--apex:pageMessage summary="{!errormessage}" rendered="{!renderErrorMessage}" severity="error" strength="3" /-->
        <apex:pageBlockSection title="Please select campaign">
            <apex:selectList value="{!choosen_campaign}" label="Campaign" size="1" >
                <apex:actionSupport event="onchange" action="{!populateFreshData}" />
                <apex:selectOption itemValue="" itemLabel="-"/>
                <!--<apex:actionSupport event="onchange" action="{!populateFreshData}" reRender="formid"/>-->
                <apex:selectOptions value="{!optionCampaign_list}"/>
            </apex:selectList> 
        </apex:pageBlockSection>
        <apex:pageBlockSection >
			<apex:selectList value="{!prev_user}" label="From" size="1" >
                <apex:actionSupport event="onchange" action="{!populateFreshData}" />
                <apex:selectOption itemValue="" itemLabel="-"/>
                <!--<apex:actionSupport event="onchange" action="{!searchAgent}" reRender="formid"/>-->
                <apex:selectOptions value="{!prevUser_list}"/>
            </apex:selectList> 
            <apex:selectList value="{!choosen_user}" label="To" size="1" >
                <apex:selectOption itemValue="" itemLabel="-"/>
                <!--<apex:actionSupport event="onchange" reRender="formid"/>-->
                <apex:selectOptions value="{!optionUser_list}"/>
            </apex:selectList>
            <apex:selectList value="{!statusHasCall}" label="Status Has Call" size="1" >
                <apex:actionSupport event="onchange" action="{!populateFreshData}" />
                <apex:selectOption itemValue="" itemLabel="-"/>
                <!--<apex:actionSupport event="onchange" action="{!searchAgent}" reRender="formid"/>-->
                <apex:selectOptions value="{!statusHasCall_List}"/>
            </apex:selectList> 
            <!--<apex:commandButton value="Search" action="{!populateFreshData}"/>-->
            
            <!--coba mus-->
            <apex:selectList value="{!ReasonStatusSet}" label="Reason Status" size="1" >
                <apex:actionSupport event="onchange" action="{!populateFreshData}" />
                <apex:selectOption itemValue="All" itemLabel="All"/>
                <apex:selectOptions value="{!ReasonStatusConfig}"/>
            </apex:selectList> 
            <!--coba mus-->
        </apex:pageBlockSection>
        
        <!--coba mus-->
        <!--ini belum dipakai
        <apex:pageBlockSection >
            <apex:selectList value="{!CallStatusSet}" label="Call Status" size="1" >
                <apex:actionSupport event="onchange" action="{!populateFreshData}" />
                <apex:selectOption itemValue="All" itemLabel="All"/>
                <apex:selectOptions value="{!CallStatusConfig}"/>
            </apex:selectList> 
        </apex:pageBlockSection>
        ini belum dipakai-->
        
        <apex:pageBlockSection >
            <apex:selectList value="{!SortingBy}" label="Sort By" size="1" >
                <apex:actionSupport event="onchange" action="{!populateFreshData}" />
                <apex:selectOption itemValue="" itemLabel="Default"/>
                <apex:selectOption itemValue="ContactNameAsc" itemLabel="Contact Name ASC"/>
                <apex:selectOption itemValue="ContactNameDesc" itemLabel="Contact Name DESC"/>
                <apex:selectOption itemValue="APEAsc" itemLabel="APE ASC"/>
                <apex:selectOption itemValue="APEDesc" itemLabel="APE DESC"/>
            </apex:selectList> 
        </apex:pageBlockSection>
        <!--coba mus-->
        
        <apex:pageBlockSection >
        	<apex:commandButton value="Select All" action="{!selectAll}"/>
        </apex:pageBlockSection>
        <br/>  
        <!--<span align="center">
        </span>-->
          <br/>
          <apex:pageBlockSection title="List of Distributed Call Line`s">
              
              <!-- coba mus-->              
              <apex:pageBlockSectionItem >
                  <apex:outputLabel >Total Record : &nbsp;&nbsp;&nbsp;</apex:outputLabel>
                  <apex:outputText value="{!tempCallLineListSize} of {!allDataSize}"/>
              </apex:pageBlockSectionItem> <br/>
              <apex:pageBlockSectionItem >
                  <apex:outputLabel >Selected : &nbsp;&nbsp;&nbsp;</apex:outputLabel>
                  <apex:outputText value="{!selectSize} Record" id="selected"/>
              </apex:pageBlockSectionItem> <br/>
              <!-- coba mus-->
              
          <apex:pageBlockTable id="idpbt" value="{!tempCallLineList}" var="cl" style="overflow:auto;width:850px;" align="center" border="1">
            <!--<apex:column headerValue="Select"><apex:inputCheckbox value="{!cl.cl_isSelected}"></apex:inputCheckbox></apex:column> -->
              
              <!--coba mus-->
              <apex:column headerValue="Select">
                  <apex:inputCheckbox value="{!cl.cl_isSelected}">
                      <apex:actionSupport event="onchange" rerender="selected" action="{!selectedSizeCount}">
                      </apex:actionSupport>
                  </apex:inputCheckbox>
              </apex:column>
              <!--coba mus-->
              
            <apex:column headerValue="Current Owner"><apex:outputText value="{!cl.cl_agentName}"></apex:outputText></apex:column>
            <apex:column headerValue="Call Line Number"><apex:outputText value="{!cl.cl_Number}"></apex:outputText></apex:column>
            <apex:column headerValue="Policy No."><apex:outputText value="{!cl.cl_PolicyNo}"/></apex:column>
            <apex:column headerValue="Contact Name"><apex:outputText value="{!cl.cl_ContactName}"/></apex:column>
            <apex:column headerValue="Nilai Premi" rendered="{!LapseTmOrRedemptionTm == true}"><apex:outputText value="{!cl.cl_TotalAmount}"/></apex:column>
            <apex:column headerValue="Nilai Amount" rendered="{!WithdrawalOrRedemptionKonven == true}"><apex:outputText value="{!cl.cl_TotalAmount}"/></apex:column>
            <apex:column headerValue="Nilai APE" rendered="{!restCampaign == true}"><apex:outputText value="{!cl.cl_TotalAmount}"/></apex:column>
            <apex:column headerValue="Currency"><apex:outputText value="{!cl.cl_Currency}"/></apex:column>
            <apex:column headerValue="Count"><apex:outputText value="{!cl.childCount}"/></apex:column>
            <apex:column headerValue="Call Status"><apex:outputText value="{!cl.cl_callStatus}"/></apex:column>
              <apex:column headerValue="Reason Status"><apex:outputText value="{!cl.cl_ReasonStatus}"/></apex:column>
          </apex:pageBlockTable>
          </apex:pageBlockSection>
     </apex:pageBlock>
</apex:form>
    </html>
</apex:page>