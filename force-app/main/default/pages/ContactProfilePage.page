            //         }
            //     } else {
            //         console.log('failed open subtab :'+result);
            //     }
            // };
        }

        function openNewTab(tabName, arg2, arg3, arg4) {
            switch (tabName){
                case 'POLICYINFO' :
                    urlRequestNewTab ='/apex/PolicyInfoPage?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&sessionID=' + '{!sessionID}'  + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' + '&agentServicingCode=' + '{!customerInfoData.agentServicingCode}' + '&agentProducingCode=' + '{!customerInfoData.agentProducingCode}' ;
                    titleNewTab ='POLICY INFO';
                    break;
                
                case 'CLAIMINFO' :
                    urlRequestNewTab ='/apex/ClaimInfoPage?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&sessionID=' + '{!sessionID}' + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' + '&agentServicingCode=' + '{!customerInfoData.agentServicingCode}' + '&agentProducingCode=' + '{!customerInfoData.agentProducingCode}' ;
                    titleNewTab ='CLAIM INFO';
                    break;
                    
                case 'RHSINFO' :
                    urlRequestNewTab ='/apex/RHSInfoPage?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&sessionID=' + '{!sessionID}' + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' + '&agentServicingCode=' + '{!customerInfoData.agentServicingCode}' + '&agentProducingCode=' + '{!customerInfoData.agentProducingCode}' ;
                    titleNewTab ='RHS INFO';
                    break;                  

                case 'CHSINFO' :
                    urlRequestNewTab ='/apex/CHSInfoPage?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&sessionID=' + '{!sessionID}' + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' + '&agentServicingCode=' + '{!customerInfoData.agentServicingCode}' + '&agentProducingCode=' + '{!customerInfoData.agentProducingCode}' ;
                    titleNewTab ='CHS INFO';
                    break;                  

                case 'INQUIRYINFO' :
                    urlRequestNewTab ='/apex/InquiryInfoPage?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&sessionID=' + '{!sessionID}' + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' + '&agentServicingCode=' + '{!customerInfoData.agentServicingCode}' + '&agentProducingCode=' + '{!customerInfoData.agentProducingCode}' ;
                    titleNewTab ='INQUIRY INFO';
                    break;

                case 'FUNDINFO' :
                    urlRequestNewTab ='/apex/FundInfoPage?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&sessionID=' + '{!sessionID}' + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' ;
                    titleNewTab ='FUND INFO';
                    break;
                    // Add Customer Detail MDM by Faizir (20200603)
                case 'CUSTOMERDETAIL' :
                    urlRequestNewTab ='/apex/MDM_VFP?contactID=' + '{!contactID}' +'&mdmId='+'{!mdmId}' + '&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' ;
                    titleNewTab ='CUSTOMER DETAIL';
                    break;

                    // Add DMU
                case 'DMUINFO' :                    
                    urlRequestNewTab ='/apex/DMU_Custom_Data_View?parentId='+ parentId 
                                + '&contactID=' + '{!contactID}' + '&DataType=Detail&&policyNo=' + '{!policyNo}' + '&entity=' + '{!entity}' + '&policyApp=' + '{!policyApp}' ;

                    titleNewTab ='DELIVERY INFO';
                    break;

            }
            
            if (sforce.console.isInConsole()) {
                sforce.console.getEnclosingPrimaryTabId(openSubTab);
            }
            else {
                javascript:var x=window.open(urlRequestNewTab,'_blank');
            }
        }

        function openSubTab(result) {
            var primaryTabId = result.id;
            console.log('primary tab id for '+titleNewTab+': '+primaryTabId);
            i++;
            sforce.console.openSubtab(primaryTabId , urlRequestNewTab , false, titleNewTab, null, openSuccess, titleNewTab);
        }

        function openSuccess(result) {
            //Report whether we succeeded in opening the subtab
            if (result.success == true) {
                if (i < menuList.length) {
                    console.log('array of i :' + i + ' for menu '+menuList[i]);
                    openNewTab(menuList[i],null,null,null);
                }
            } else {
                console.log('failed open subtab :'+result);
            }
        }
    </script>     
