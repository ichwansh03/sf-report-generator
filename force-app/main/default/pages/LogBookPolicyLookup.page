<apex:page controller="LogBookPolicyLookupController"  
  title="Search" 
  showHeader="false" 
  sideBar="false" 
  tabStyle="Contact" 
  id="pg">
  
    
  <apex:includeScript value="{!$Resource.JQuery1_9_1}"/>
    <script type="text/javascript">
    	$(document).ready(function(){
            $('form').attr('autocomplete', 'off');
        });
    
        function fillIn(no, nm, pt){
            var winMain=window.opener;
            if (null==winMain){
                winMain=window.parent.opener;
            }
            var ele=winMain.document.getElementById('{!$CurrentPage.parameters.pno}');
            ele.value=no;
            ele=winMain.document.getElementById('{!$CurrentPage.parameters.pnm}');
            ele.value=nm;
            ele=winMain.document.getElementById('{!$CurrentPage.parameters.ppt}');
            ele.value=pt;
            CloseWindow();
        }
        
        function CloseWindow(){
            var winMain=window.opener;
            if (null==winMain){
                winMain=window.parent.opener;
            }
            winMain.closeLookupPopup();
        }
    
    	function enterPress(e){
        if(e.keyCode==13){
                if(e.preventDefault){ 
                    e.preventDefault();
                }
                else{
                    e.returnValue=false;
                }
                searchFunction();
            }        
        }
    
    </script>
  <apex:form id="form">
      <apex:outputPanel id="page" layout="block" style="margin:5px;padding:10px;padding-top:2px;">
        <apex:tabPanel switchType="client" selectedTab="name1" id="tabbedPanel">
            <apex:tab label="Policy" name="tab1" id="tabOne">
                <apex:actionRegion > 
                  <apex:actionFunction action="{!search}" name="searchFunction" rerender="searchResults" status="pageStatus" />
                  <apex:outputPanel id="top" layout="block" style="margin:5px;padding:10px;padding-top:2px;">
                    <apex:outputLabel value="Search" style="font-weight:Bold;padding-right:10px;" for="txtSearch"/>
                    <apex:inputText id="txtSearch" value="{!searchString}" html-placeholder="Input Policy Number OR Name" size="30" onkeypress="enterPress(event)" />
                    <span style="padding-left:5px">
                        <apex:commandButton id="btnGo" value="Search" action="{!search}" rerender="searchResults" status="pageStatus"/>
                    </span>
                  </apex:outputPanel>
        
                  <apex:outputPanel id="pnlSearchResults" style="margin:10px;height:350px;overflow-Y:auto;" layout="block">
                    <apex:actionStatus id="pageStatus">
                        <apex:facet name="start">
                            <apex:outputPanel >
                                <div style="text-align: center">
                                    <img src="/img/loading32.gif" width="25" height="25" />
                                </div>
                            </apex:outputPanel>
                        </apex:facet>
                    </apex:actionStatus>
                    <apex:pageBlock id="searchResults">
                      <apex:pageBlockTable value="{!policyResult}" var="rslt">
                            <apex:column headerValue="Policy No">
                                <apex:outputLink value="#" onclick="fillIn('{!rslt['PolicyNo']}', '{!rslt['PolicyNameHolder']}', '{!rslt['PolicyProductType']}')">{!rslt['PolicyNo']}</apex:outputLink>      
                            </apex:column>
                            <apex:column headerValue="Name" value="{!rslt['PolicyNameHolder']}"/>
                        </apex:pageBlockTable>
                    </apex:pageBlock>
                  </apex:outputPanel>
                </apex:actionRegion>
            </apex:tab>
        </apex:tabPanel>
      </apex:outputPanel>
  </apex:form>
</apex:page>