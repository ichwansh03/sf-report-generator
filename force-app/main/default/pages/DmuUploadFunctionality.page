<apex:page standardController="Case" extensions="DMUUploadController" action="{!dmuUploadFunctionalityvalue}">
    <link rel="stylesheet" type="text/css" href="{!$Resource.DMUUploadCSS}"/>
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js"/>
    <script type="text/javascript" src="{!$Resource.DMUUploadJS}"/>
    <script src="/soap/ajax/34.0/connection.js" type="text/javascript"></script>
    <!-- The error message block -->
    <apex:pageMessages escape="false" />
    
    <apex:sectionHeader title="Upload" subtitle="Upload Functionality"/>

    <apex:pageBlock mode="edit" title="Request Duplicate or re-Print Policy Book" id="pgBlock5">
        <apex:form id="myForm7">
            <apex:pageBlockSection id="pgBlockSection7" collapsible="false" columns="1">
               <apex:pageBlockSectionItem >
                    <apex:outputLabel >File Upload</apex:outputLabel>
                    <apex:inputFile id="csvFileInput2" value="{!resDuplicateFileBody}" filename="{!resDuplicateFileName}" fileSize="{!resDuplicatefileSize}" required="true" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Type</apex:outputLabel>
                    <apex:inputField value="{!cs.type}" required="true" html-disabled="true" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Case Type</apex:outputLabel>
                    <apex:actionRegion >
                    <apex:inputField value="{!cs.Case_Type_Config__c}" required="true">
                        <apex:actionSupport reRender="myForm7,pgBlockSection7" event="onchange" status="stSearch"/>
                    </apex:inputField>
                        </apex:actionRegion>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem id="picPick" rendered="{!IF(cs.Case_Type_Config__c != 'Request_CCC_Call Back DMU', true,false)}" >
                    <apex:outputLabel >PIC</apex:outputLabel>
                    <apex:inputField value="{!cs.PIC__c}" required="{!IF(cs.Case_Type_Config__c != 'Request_CCC_Call Back DMU', true,false)}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >NonPP</apex:outputLabel>
                    <apex:inputField value="{!cs.NonPP__c}" required="true" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Customer Mood</apex:outputLabel>
                    <apex:inputField value="{!cs.General_Attitude__c}" required="true" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Don't Send ICF</apex:outputLabel>
                    <apex:inputCheckbox value="{!isIcf }" selected="true"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel ></apex:outputLabel>
                    <apex:commandButton id="reqDuplicateUploadButton" value="Upload" onClick="isFile7(event)" action="{!dmuUploadFunctionality}"></apex:commandButton>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:form>
        <!--<apex:form id="myForm1">
            <apex:pageBlockSection id="pgBlockSection1" collapsible="false" columns="1">
               <apex:pageBlockSectionItem >
                    <apex:outputLabel >File Upload</apex:outputLabel>
                    <apex:inputFile id="csvFileInput2" value="{!resDuplicateFileBody}" filename="{!resDuplicateFileName}" fileSize="{!resDuplicatefileSize}" required="true" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel ></apex:outputLabel>
                    <apex:commandButton id="reqDuplicateUploadButton" value="Upload" onClick="isFile7(event)" action="{!dmuUploadFunctionality}"></apex:commandButton>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:form> -->
    </apex:pageBlock>

    <script type="text/javascript">
        var j$ = jQuery.noConflict();
        function isFile7(e) {
            Files7 = document.getElementById('{!$Component.j_id0:pgBlock5:myForm7:pgBlockSection7:j_id87:csvFileInput2}').files;
            if(Files7.length == 0) {
                alert('Please select a file!');
                e.preventDefault();
            }
        }        
    </script>
</apex:page>