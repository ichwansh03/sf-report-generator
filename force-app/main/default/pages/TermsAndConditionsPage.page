<apex:page controller="ChangePaymentController" action="{!TermsAndConditionsInit}" showHeader="false" sidebar="false">
  
    <apex:outputPanel id="payment-midtrans">
        Order Id : {!trxRefNo} <br/>
        SNAP token : {!vsnapToken}

    <script type="text/javascript" src="{!snapJs}" data-client-key="{!dataClientKey}">
    </script>
    
    <script type="text/javascript">
    function paymidtrans(){
        var orderId = '{!trxRefNo}';
        var token = '{!vsnapToken}';
        console.log('start transaction : ' + orderId + ', ' + token + '.');
        if('{!vsnapToken}' != ''){
            console.log('trying paymidtrans');
            snap.pay('{!vsnapToken}', {
                selectedPaymentType: 'credit_card', language: 'en', skipCustomerDetails: true,
                onSuccess: function(result) {
                    console.log(result);
                    var pageUrl = '{!URLFOR($Page.OrderStatusPage)}';
                    var parameters = '?orderId=' + result.order_id + '&statusCode=' + result.status_code + '&transactionId=' + result.transaction_id;
                    var link = pageUrl + parameters;
                    console.log(link);
                    //window.location.href = link;
                    window.open(link,'_top');
                },
                onPending: function(result){
                    console.log('pending');
                    console.log(result);
                    var pageUrl = '{!URLFOR($Page.OrderStatusPage)}';
                    var parameters = '?orderId=' + result.order_id + '&statusCode=' + result.status_code + '&transactionId=' + result.transaction_id;
                    var link = pageUrl + parameters;
                    //window.location.href = link;
                    window.open(link,'_top');
                },
                onError: function(result){
                    console.log('error');
                    console.log(result);
                    var pageUrl = '{!URLFOR($Page.OrderStatusPage)}';
                    var parameters = '?orderId={!trxRefNo}' + '&statusCode=' + result.status_code;
                    var link = pageUrl + parameters;
                    //window.location.href = link;
                    window.open(link,'_top');
                },
                onClose: function(){console.log('customer closed the popup without finishing the payment');}
            })
        }
    }
    </script>
    </apex:outputPanel>
    
    <apex:form >
        <apex:actionFunction action="{!getVSnapTokenMidtrans}" name="PaymentAction" reRender="payment-midtrans" onComplete="paymidtrans();" status="stSearch"/>
    </apex:form>
    
    <apex:messages />
    
    <apex:form >
        <apex:pageBlock title="Secure Payment">
            <apex:pageBlockSection title="Term of Conditions" columns="1" rendered="{!IF(MIDParameter.RTC_01__c=='',TRUE,FALSE)}">
