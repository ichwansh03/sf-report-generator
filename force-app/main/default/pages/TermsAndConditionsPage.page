            </apex:pageBlockSection>    
            <apex:pageBlockSection title="Term of Conditions" columns="1" rendered="{!IF(MIDParameter.RTC_01__c=='',FALSE,TRUE)}">
                <apex:pageBlockSectionItem rendered="{!IF(MIDParameter.RTC_01__c=='',FALSE,TRUE)}">
