<apex:page standardController="Case" extensions="popupPICDeptOnCaseClass" showHeader="false" showChat="false" sidebar="false" tabStyle="Case">
    <apex:includeScript value="/support/console/44.0/integration.js" />
    
    <script type="text/javascript">
    function cancelEdit() {
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingPrimaryTabId(vftab);
        } else {
            window.close();
        }
    }
    var vftab = function vftab(result) {
        var tabId = result.id;
        console.log(tabId);
        console.log('{!Case.Id}');
        var url = "/{!Case.Id}";
        sforce.console.openPrimaryTab(tabId, url, true, "{!Case.CaseNumber}"); 
    }
    
    function closeTab() {
        if (sforce.console.isInConsole()) {
            sforce.console.getEnclosingTabId(currentTab);
        }
    }
    var currentTab = function currentTab(result) {
        var tabId = result.id;
        sforce.console.closeTab(tabId);
    }
    
    </script>

    
    <apex:form >
        <apex:sectionHeader title="Assign Case" subtitle="{!Case.CaseNumber}" />	
        <apex:pageBlock mode="edit">
            <apex:pageBlockButtons >
                <apex:commandButton action="{!updateCase}" value="Save" />
                <apex:commandButton onclick="cancelEdit()" value="Cancel" />
            </apex:pageBlockButtons>
            
            <apex:pageBlockSection columns="1">
                <apex:outputLabel for="picklistDept" value="Select either Case Type or PIC Department: " />
                <apex:selectList id="picklistDept" size="1" multiselect="false" value="{!selectedPicklist}">
                    <apex:selectOption itemValue="None" itemLabel="-- None --" />
                    <apex:selectOption itemValue="Case_Type" itemLabel="Case Type" />
                    <apex:selectOption itemValue="PIC_Department" itemLabel="PIC Department" />
                    <apex:actionSupport event="onchange" reRender="debug,CT,PD"/>  
                </apex:selectList>
                <apex:inputField value="{!Case.Type}" style="display:none;"  label="" /> <!-- style="display:none;" -->
            </apex:pageBlockSection>
            <apex:pageBlockSection id="debug" rendered="false">
                <apex:outputText value="{!selectedPicklist}" />
            </apex:pageBlockSection>
            <apex:pageBlockSection id="CT">
                <apex:inputField value="{!Case.Case_Type_Config__c}" rendered="{!IF(selectedPicklist=='Case_Type', true, false)}" />
            </apex:pageBlockSection>
            <apex:pageBlockSection id="PD" >
                <apex:inputField value="{!Case.PIC_Department_LU__c}" rendered="{!IF(selectedPicklist=='PIC_Department', true, false)}" />
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>