                            <apex:column style="text-align: right;"> <apex:facet name="header">Future Premium<br/>Deposit Interest</apex:facet> <apex:outputText value="{!polisRider.MataUang}{0, number, ###,###,###,###.00}"> <apex:param value="{!cash.FuturePremiumDepositInterest}"/> </apex:outputText></apex:column>
                            <apex:column headerValue="Cash Value" style="text-align: right;"><apex:outputText value="{!polisRider.MataUang}{0, number, ###,###,###,###.00}"> <apex:param value="{!cash.CashValue}"/> </apex:outputText></apex:column>
                        </apex:pageBlockTable>
                    </apex:outputPanel>
                </apex:pageBlockSection>
                <!-- *** .END OF CASH VALUE -->
                
                <!-- ***  ACOCUNT DETAIL-->
                <apex:pageBlockSection title="Account Detail" collapsible="true" columns="1" rendered="{!isDisplayAFI_AMFS}">
                    <div id="pagingControlAccountDetail"></div>
                    <apex:outputPanel id="panelAccountDetail" rendered="true">
                    <apex:pageBlockTable id="idaccDetail" value="{!accountDetailList}" var="accDet" style="overflow:auto;width:1000px;" align="left" border="1">
                        <apex:column headerValue="Account No">{!accDet.AccountNo}</apex:column>
                        <apex:column headerValue="Account Name">{!accDet.AccountName}</apex:column>
                        <apex:column headerValue="Account Effective Date"><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!accDet.AccountEffectiveDate}" /></apex:outputText></apex:column>
                        <apex:column headerValue="Account Expired Date"><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!accDet.AccountExpiredDate}" /></apex:outputText></apex:column>
                        <apex:column headerValue="Account Type">{!accDet.AccountType}</apex:column>
                        <apex:column headerValue="Account Status">{!accDet.AccountStatus}</apex:column>
                        <apex:column headerValue="Collection Bank">{!accDet.CollectionBank}</apex:column>
                        <apex:column headerValue="Branch">{!accDet.Branch}</apex:column>
                        <apex:column headerValue="Reject Code">{!accDet.RejectCode}</apex:column>
                        <apex:column headerValue="Reject Date"><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!accDet.RejectDate}" /></apex:outputText></apex:column>
                    </apex:pageBlockTable>
                    </apex:outputPanel>
                </apex:pageBlockSection>            
