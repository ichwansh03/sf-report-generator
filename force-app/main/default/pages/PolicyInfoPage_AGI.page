        function openNewTab(tabName, arg2, arg3, arg4) {
            switch (tabName) {
                case 'ASSNOTESDETAILINFO' :
                    // alert('under performance tuning');
                    // return false;
                    urlRequestNewTab = '/apex/AssessmentNotesDetailPage?parentId=' + parentId 
                               + '&contactID=' + contactID + '&sessionID=' + '{!sessionID}' + '&policyNo=' + policyNo + '&entity=' + entity + '&policyApp=' + policyApp 
                               + '&operation=' + arg2 + '&classType=' + arg3 + '&refNo=' + arg4;
                    titleSubTab = 'ASS.NOTES DETAIL ' + arg3;
                    console.log(urlRequestNewTab +'-' + arg2 + '-' + arg3 + '-' + arg4);
                    break;

                case 'PAYMENTINFO' :
                 // urlRequestNewTab ="/apex/PaymentInfoPage?";
                    urlRequestNewTab = '/apex/PaymentInfoPage?parentId=' + parentId 
                               + '&contactID=' + contactID + '&sessionID=' + '{!sessionID}' + '&policyNo=' + policyNo + '&entity=' + entity + '&policyApp=' + policyApp;
                    titleSubTab = 'PAYMENT';
                    break;
                
                case 'FUNDINFO' :
                    //urlRequestNewTab ="/apex/FundInfoPage?";
                    urlRequestNewTab = '/apex/FundInfoPage?parentId=' + parentId 
                               + '&contactID=' + contactID + '&sessionID=' + '{!sessionID}' + '&policyNo=' + policyNo + '&entity=' + entity + '&policyApp=' + policyApp;
                    titleSubTab = 'FUND';
                    break;
            }

            if (sforce.console.isInConsole()) {
                sforce.console.getEnclosingPrimaryTabId(openSubTab);
            } else {
                //window.location.href = urlRequestNewTab;
                //window.parent.location.href=(urlRequestNewTab);
                javascript:var x=window.open(urlRequestNewTab,'_blank');
            }
        }
    </script>

