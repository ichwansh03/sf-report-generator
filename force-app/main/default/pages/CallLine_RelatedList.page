        function openNewTabRelatedContactAgent(el) {
            console.log(el);	
            let AgentId = el.getAttribute('data-id');
         	let uniqueId = el.getAttribute('data-lastId');
            
            console.log(AgentId);
            titleNewTabRelatedContactAgent = el.getAttribute('data-title');
            urlRequestNewTabRelatedContactAgent ='/'+ AgentId; 
            if (sforce.console.isInConsole()) {
                sforce.console.getEnclosingPrimaryTabId(openSubTabRelatedContactAgent);
            }
            else {
                javascript:var x=window.open(urlRequestNewTabRelatedContactAgent,'_blank');
