<apex:page standardController="Contact" extensions="CallLine_CustomPage_ctrl" sidebar="false" showHeader="false">
     
    <apex:includeScript value="/soap/ajax/32.0/connection.js"/>   
    <apex:includeScript value="/support/console/37.0/integration.js"/>    
    <!--  JAVASCRIPT ABOVE --> 
    <script type="text/javascript">  

        var urlRequestNewTabRelatedContactCallLine ='';
        var titleNewTabRelatedContactCallLine ='';
  
        function openNewTabRelatedContactCallLine(el) {
            console.log(el);	
            let callLineId = el.getAttribute('data-id');
         	let uniqueId = el.getAttribute('data-lastId');
            
            console.log(callLineId);
            titleNewTabRelatedContactCallLine = el.getAttribute('data-title');
            urlRequestNewTabRelatedContactCallLine ='/apex/CallLine_RecordDetailPage?id='+ callLineId+'&lastId='+uniqueId; 
            if (sforce.console.isInConsole()) {
                sforce.console.getEnclosingPrimaryTabId(openSubTabRelatedContactCallLine);
            }
            else {
                javascript:var x=window.open(urlRequestNewTabRelatedContactCallLine,'_blank');
            }
        }

        function openSubTabRelatedContactCallLine(result) {
            // var primaryTabId = {!id};
            let primaryTabId = result.id; 
            console.log('primary tab id for '+titleNewTabRelatedContactCallLine+': '+primaryTabId);
            // i++;
            sforce.console.openSubtab(primaryTabId , urlRequestNewTabRelatedContactCallLine , false, titleNewTabRelatedContactCallLine, null, null, titleNewTabRelatedContactCallLine);
        }

        function openSuccessRelatedContactCallLine(result) {
            //Report whether we succeeded in opening the subtab
            if (result.success == true) {
                 
            } else {
                console.log('failed open subtab :'+result);
            }
        }

        

