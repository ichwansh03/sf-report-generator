<apex:page controller="Case_Line_CMU" id="pageid">
    <!--<pbe:PageBlockTableEnhancerADV targetPbTableIds="tableid" pageSizeOptions="10,25,50,100" defaultPageSize="10" enableExport="false"/>-->
    <apex:includeScript value="/soap/ajax/33.0/connection.js"/>
    <apex:includeScript value="/soap/ajax/33.0/apex.js"/>
    <apex:includeScript value="/support/console/40.0/integration.js"/>
    <apex:include pageName="PageJS"/>
    <script type="text/javascript">
    //jQuery.noConflict();
    function telepon(nomor_telp, id_call, contactid) {
        //alert(nomor_telp+", "+id_call+", "+contactid);
        //var j$ = jQuery.noConflict();
         var validasi = false;
        sforce.connection.sessionId = "{!$Api.Session_ID}";
        var userid = sforce.connection.getUserInfo(); 
        var user = sforce.connection.query("SELECT sip__c from user where id ='"+userid.userId+"' limit 1"); 
        //var iduser = {!$User.SIP__c};
        var records = user.getArray("records"); 
        //alert("records : "+records);
        //alert("userid : "+userid.userId); 
        var log = new sforce.SObject("Log_CTI_Valdo__c");
        log.sip__c = records[0].SIP__c;
        log.to__c = nomor_telp;
        log.Mode__c = 'API Call Out';
        log.Status__c = 'Outbound';
        log.Case = id_call;
        log.Contact__c = contactid;
        var cl = sforce.connection.query("SELECT  Recommendation__c, contactId from Case where id ='"+id_call+"' limit 1");
        var recorder = cl.getArray("records"); 
        var reason_status = recorder[0].Reason_Status_Config__c;
        var val_split = "{!$Label.Validation_Reason_Status}";
        if(reason_status!=null && reason_status!=''){
            var temp = val_split.split(",");
            var i;
            for(i = 0; i<temp.length; i++){
                if(temp[i] == reason_status){
                    validasi = true;
                    break;
                }
            }
        }
        jQuery('[id$=myHiddenField]').val(id_call);
        //j$('[id$=myHiddenField]').val(id_call);
        //passStringToController();
        
        try{
            if(validasi == true){
                alert("Cannot call");
            }
            else{
                var result1 = sforce.connection.create([log]);
                //alert(result1);
                if(result1[0].getBoolean("success"))
                {
                    //alert('Success');
                    //setTimeout(function(){ alert("Success"); },10000);
                    consolelink('/'+id_call,'_blank');
                    var ul = document.getElementById('el_loading');
                    ul.style.display = 'inline';
                    setTimeout(function(){ resultAPI(result1[0].id, id_call); ul.style.display = "none";  } , 15000);
                    
                }
                else{
                    alert('Error : '+result1);
                }
            }
        }catch(err){
            alert(err);
        }
    }
        
    function resultAPI(id_sf, id_call){
        sforce.connection.sessionId = "{!$Api.Session_ID}";
        //var userid = sforce.connection.getUserInfo(); 
        var log = sforce.connection.query("SELECT ID_Valdo__c, Response_API__c from Log_CTI_Valdo__c where id ='"+id_sf+"' limit 1"); 
        //var iduser = {!$User.SIP__c};
        var records = log.getArray("records"); 
        //alert(""+records[0].Response_API__c);
        //var str = records[0].Response_API__c;
        var str = records[0].ID_Valdo__c;
        //alert(""+str);
        if(str!="" && str!=null){
            alert("Success");
            //consolelink('/'+id_call,'_blank');
        }
        else{
            alert("Please Retry");
        }
    }
    
    function onUpload()
    {
        var ul = document.getElementById('el_loading');
        ul.style.display = 'inline';
        setTimeout(function(){ ul.style.display = none;  } , 15000);
    }
    </script>
    <style>
        .requiredLoaderBG {
            background-color: rgb(71,71,71);
            opacity:0.7;
            filter:alpha(opacity=70);
            background-image:url('{!$Resource.ajaxLoadGif}');
            background-position: center center;
            background-repeat: no-repeat;
            height: 100%;
            left: 0;
            position: fixed;
            text-align: center;
            top: 0;
            width: 100%;
            z-index: 1;
        }
        
        #el_loading
        {
           display: none;
        }
    </style>
    <apex:form id="formid">
        <apex:actionstatus startStyleClass="requiredLoaderBG" id="ajaxStatus" />
        <apex:actionFunction name="passStringToController" action="{!UpdateCallLine}" rerender="formid" />
        <apex:inputHidden value="{!idparam}" id="myHiddenField"/>
        <apex:pageBlock id="pbid">
            
            <apex:pageBlockButtons location="top">
                <apex:commandButton reRender="formid" value="Refresh" status="ajaxStatus"/>
                <apex:commandButton value="<<" rerender="formid" action="{!beginning}" disabled="{!prev}" status="ajaxStatus" />
                <apex:commandButton value="<" rerender="formid" action="{!previous}" disabled="{!prev}" status="ajaxStatus"/>
                <apex:commandButton value=">" rerender="formid" action="{!next}" disabled="{!nxt}" status="ajaxStatus"/>
                <apex:commandButton value=">>" rerender="formid" action="{!end}" disabled="{!nxt}" status="ajaxStatus"/> 
            </apex:pageBlockButtons>
            <apex:pageBlockSection columns="2">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Named User : &nbsp;&nbsp;&nbsp;</apex:outputLabel>
                    <apex:selectList id="NamedUser" value="{!nameduser}"  size="1" >
                        <apex:selectOptions value="{!NamedUserlist}"/>
                        <apex:actionSupport event="onchange"  rerender="formid" status="ajaxStatus" action="{!beginning}"/>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Request Status : &nbsp;&nbsp;&nbsp;</apex:outputLabel>
                    <apex:selectList id="brand" value="{!filrequeststatus}"  size="1" >
                        <apex:selectOptions value="{!RequestStatus}"/>
                        <apex:actionSupport event="onchange"  rerender="formid" status="ajaxStatus" action="{!beginning}"/>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Blocksize : &nbsp;&nbsp;&nbsp;</apex:outputLabel>
                    <apex:selectList id="brand" value="{!BlockSize}"  size="1" >
                        <apex:selectOptions value="{!Block_Size}"/>
                        <apex:actionSupport event="onchange"  rerender="formid" action="{!beginning}" status="ajaxStatus" />
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Total Record : &nbsp;&nbsp;&nbsp;</apex:outputLabel>
                    <apex:outputText value="{!totalRecs} of {!totalAllRecs}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockTable value="{!ListCall}" var="val" id="tableid" >
                <apex:column headerValue="{!$ObjectType.Case.fields.Named_User__c.Label}"  value="{!val.Named_User__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Named_User__c.Label}" action="{!toggleSort}" rerender="formid" status="ajaxStatus">
                            <apex:param name="sortField" value="Named_User__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.CaseNumber.Label}"  >
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.CaseNumber.Label}" action="{!toggleSort}" rerender="formid" status="ajaxStatus">
                            <apex:param name="sortField" value="CaseNumber" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                    <apex:outputLink value="/{!val.Id}">{!val.CaseNumber}</apex:outputLink>
                </apex:column>
                <apex:column headerValue="Contact" value="{!val.ContactId}" >
                    <apex:facet name="header">
                        <apex:commandLink value="Contact" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="ContactId" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Contact.fields.Policy_No__c.Label}" value="{!val.Contact.Policy_No__c}" >
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Contact.fields.Policy_No__c.Label}" action="{!toggleSort}" rerender="formid" status="ajaxStatus">
                            <apex:param name="sortField" value="Contact.Policy_No__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.Received_date__c.Label}" value="{!val.Received_date__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Received_date__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="Received_date__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="Aging" value="{!val.Age__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="Aging" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="Age__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.Category__c.Label}" value="{!val.Category__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Category__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="Category__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.Complaint_type__c.Label}" value="{!val.Complaint_type__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Complaint_type__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="Complaint_type__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.Other_Information__c.Label}" value="{!val.Other_Information__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Other_Information__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="Other_Information__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.CHS_Status__c.Label}" value="{!val.CHS_Status__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.CHS_Status__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="CHS_Status__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.Pending_Status__c.Label}" value="{!val.Pending_Status__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Pending_Status__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="CHS_Status__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
                <apex:column headerValue="{!$ObjectType.Case.fields.Complaint__c.Label}" value="{!val.Complaint__c}">
                    <apex:facet name="header">
                        <apex:commandLink value="{!$ObjectType.Case.fields.Complaint__c.Label}" rerender="formid" action="{!toggleSort}" status="ajaxStatus">
                            <apex:param name="sortField" value="Complaint__c" assignTo="{!sortField}"/>
                        </apex:commandLink>
                    </apex:facet>
                </apex:column>
            </apex:pageBlockTable>
            
            <!--
                //untuk auto render
                <apex:actionPoller reRender="formid" interval="60"/>
            -->
            
        </apex:pageBlock>
         </apex:form>
    <div class="waitingSearchDiv" id="el_loading" style="background-color: #fbfbfb; height:100%;opacity:0.75;width:100%;">
        <div class="waitingHolder" style="top: 100px; width: 91px;">
            <img class="waitingImage" src="{!$Resource.ajaxLoadGif}" title="Please Wait..."  style="width: 40;height:40;"/>
            <span class="waitingDescription">Please Wait .  .  .  .  .</span>
        </div>
    </div>

</apex:page>