        .nav-tabs > li.active > a, .nav-tabs > li.active > a:hover, .nav-tabs > li.active > a:focus {
        	border: none;
        }
        ul.nav-tabs {
          background-color: #f1f1f1;
          border: 1px solid #d4d4d4;
          -webkit-border-radius: 6px;
          -moz-border-radius: 6px;
          border-radius: 3px;
          position: relative;
          overflow: hidden;
        }
        ul.nav-tabs:before {
          position: absolute;
        }
        ul.nav-tabs:after {
          display: block;
          position: absolute;
          left: 0px;
          right: 0px;
          top: 138px;
          height: 47px;
          border-top: 1px solid #d4d4d4;
          border-bottom: 1px solid #d4d4d4;
          z-index: 11;
          content: " ";
        }
        ul.nav-tabs li {
          position: relative;
          float: left;
          height: 36px;
          display: inline-block;
          text-align: center;
          padding: 6px 20px 0 30px;
          margin: 0;
          font-size: 14px;
          line-height: 46px;
        }
        ul.nav-tabs li a {
          color: #428bca;
          padding: 0;
        }
        ul.nav-tabs li a:hover {
          background-color: transparent;
        }
        ul.nav-tabs li:before {
          position: absolute;
          display: block;
          border: 24px solid transparent;
          border-left: 16px solid #d4d4d4;
          border-right: 0;
          top: -5px;
          z-index: 10;
          content: '';
          right: -16px;
        }
        ul.nav-tabs li:after {
          position: absolute;
          display: block;
          border: 24px solid transparent;
          border-left: 16px solid #f1f1f1;
          border-right: 0;
          top: -5px;
          z-index: 10;
          content: '';
          right: -15px;
        }
        ul.nav-tabs li.active {
          color: #fff;
          background: #6666CC;
        }
        ul.nav-tabs li.active:after {
          border-left: 16px solid #6666CC;
        }
        ul.nav-tabs li.active a,
        ul.nav-tabs li.active a:active,
        ul.nav-tabs li.active a:visited,
        ul.nav-tabs li.active a:focus {
          color: #fff;
          background: #6666CC;
        }
        ul.nav-tabs .active ~ li {
          color: #999999;
          background: #f9f9f9;
        }
        ul.nav-tabs .active ~ li:after {
          border-left: 16px solid #f9f9f9;
        }
        ul.nav-tabs .active ~ li a,
        ul.nav-tabs .active ~ li a:active,
        ul.nav-tabs .active ~ li a:visited,
        ul.nav-tabs .active ~ li a:focus {
          color: #999999;
          background: #f9f9f9;
        }
        ul.nav-tabs.nav-wizard-backnav li:hover {
          color: #468847;
          background: #f6fbfd;
        }
        ul.nav-tabs.nav-wizard-backnav li:hover:after {
          border-left: 16px solid #f6fbfd;
        }
        ul.nav-tabs.nav-wizard-backnav li:hover a,
        ul.nav-tabs.nav-wizard-backnav li:hover a:active,
        ul.nav-tabs.nav-wizard-backnav li:hover a:visited,
        ul.nav-tabs.nav-wizard-backnav li:hover a:focus {
          color: #468847;
          background: #f6fbfd;
        }
        ul.nav-tabs.nav-wizard-backnav .active ~ li {
          color: #999999;
          background: #ededed;
        }
        ul.nav-tabs.nav-wizard-backnav .active ~ li:after {
          border-left: 16px solid #ededed;
        }
        ul.nav-tabs.nav-wizard-backnav .active ~ li a,
        ul.nav-tabs.nav-wizard-backnav .active ~ li a:active,
        ul.nav-tabs.nav-wizard-backnav .active ~ li a:visited,
        ul.nav-tabs.nav-wizard-backnav .active ~ li a:focus {
          color: #999999;
          background: #ededed;
        }
        
    </style>
    
    <script type="text/javascript">
        function iframeCase(tabName){
        console.log(tabName);
            switch (tabName) {
            case "Salam":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabPembuka?isdtp=vw&tab=salam&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Verifikasi Data":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabVerify?isdtp=vw&tab=verifikasi data&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Product":
                   	return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabProduct?isdtp=vw&tab=product&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Detail Product":
                   	return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabInfoProduct?isdtp=vw&tab=detail product&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';        
            // start Replace Sesi Pernyataan to Sesi Informasi Polis by Faizir 25-11-2019
                    // start Replace Sesi Informasi Polis to Sesi Informasi Produk dan Pertanyaan Pelayanan FA by Faizir 17-11-2020
            case "Survey":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabSurvey?isdtp=vw&tab=Survey&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Konfirmasi ke FA":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabKonfirmasi?isdtp=vw&tab=Konfirmasi Ke FA&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Sesi Informasi Produk dan Pertanyaan Pelayanan FA":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabInformasiPolis?isdtp=vw&tab=sesi informasi produk dan pertanyaan pelayanan fa&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
                    // end Replace Sesi Informasi Polis to Sesi Informasi Produk dan Pertanyaan Pelayanan FA by Faizir 17-11-2020
            // end Replace Sesi Pernyataan to Sesi Informasi Polis by Faizir 25-11-2019   
            case "Sesi Pertanyaan":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabQuestion?isdtp=vw&tab=sesi pertanyaan&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
                    //case "Survey":
                    //return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabK?isdtp=vw&tab=konfirmasi nasabah ingin kembali ke fa&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
                    //case "Konfirmasi Nasabah Ingin Kembali ke FA":
                    //return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" src="/apex/TabKonfirmasi?isdtp=vw&tab=konfirmasi nasabah ingin kembali ke fa&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Legal Statement":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" data-src="/apex/TabLegal?isdtp=vw&tab=legal statement&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Penutup":
                    return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" data-src="/apex/TabPenutup?isdtp=vw&tab=penutup&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            case "Reschedule":
                  	return '<iframe id="frame-'+tabName.replace(/\s/g,'').toLowerCase()+'" data-src="/apex/callLineReschedule?isdtp=vw&tab=reschedule&id={!clId}" frameBorder="0" scrolling="true" width="100%" height="500px"/> </iframe>';
            default :
                return tabName;
            }
        }
    	(function (){
            function createTabs(record, i){
                var tabName = record.WelcomeCall_Tab_Name__c;
                	tabName = tabName != null ? tabName.replace(/\s/g,'').toLowerCase() :"";
                return ['<li class="',(i==0 ? 'active':''),'" id="tab-default-',tabName,'__item" title="',record.WelcomeCall_Tab_Name__c,'" role="presentation" >',
                       '<a data-toggle="tab" role="tab" aria-selected="',(i==0 ? true:false),'" ','href="#tab-default-',(i+1),'"',
                        ' aria-controls="tab-default-',(i+1),'" >', record.WelcomeCall_Tab_Name__c, '</a>', '</li>'
                       ].join('');
            }
            function createTabContent(record, i){
                var btnReload = '';
                var tab_name = record.WelcomeCall_Tab_Name__c;
                var frame_id = 'frame-'+tab_name.replace(/\s/g,'').toLowerCase();
                
                if(tab_name == 'Legal Statement' || tab_name == 'Penutup' || tab_name == 'Reschedule')
                    btnReload = '<button class="btn btn-info" style="margin: 10px 0;" onclick="load_iframe(\''+frame_id+'\');">Load Data</button>';
                return ['<div id="tab-default-',(i+1),'" class="tab-pane ',(i==0 ? 'active':''),'" role="tabpanel" >',
                        btnReload, iframeCase(record.WelcomeCall_Tab_Name__c),'</div>'].join('');
            }
            
            //get list tab name
            TabTaskListCtrl.getTabsTaskList('{!productCode}',
            	function(result, event){
                    if(event.statusCode == 200){
                          var records =JSON.parse(JSON.stringify(result));
                          var i;
                          var outerDiv= '<section> <div class="wizard" id="divTab">';
                          var htmlTab = '<ul id="tabTask" class="nav nav-tabs" role="tablist">';
                          var htmlTabContent='<div class="tab-content">';
                          for(i = 0; i < records.length; i++){
                              if(i == 0){
                                htmlTab = htmlTab +''+createTabs(records[i], i);
                                htmlTabContent = htmlTabContent+''+createTabContent(records[i], i);
                              } else {
                                htmlTab = htmlTab +''+createTabs(records[i], i);
                                htmlTabContent = htmlTabContent +''+createTabContent(records[i], i);
                              }
                          }
            			var myapp = document.getElementById('myappid');
                        htmlTab = htmlTab+''+'</ul>';
                        htmlTabContent = htmlTabContent+''+'<div class="clearfix"></div></div>';
                        outerDiv = outerDiv +htmlTab+htmlTabContent+''+'</div></section>';
                        myapp.innerHTML = outerDiv;
                    } else {
                		console.log("Something Wrong! "+event.message);
                    }
            });
            $('a[data-toggle="tab"]').on('show.bs.tab', function (e) {
        		console.log(e.target);
                console.log(e.relatedTarget);
                var $target = $(e.target);
            
                if ($target.parent().hasClass('disabled')) {
                    return false;
                }
            });
            
        })();
    
    	function load_iframe(element_name){
            $('#'+element_name).attr('src', $('#'+element_name).data('src'));
        }
    </script>
</html>
</apex:page>