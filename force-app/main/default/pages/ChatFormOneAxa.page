<apex:page showHeader="false">
    <!-- add for fix mobile view by Beni R, 14 Dec 2022-->
	<head>
        <!-- <meta content="IE=edge" http-equiv="X-UA-Compatible"/> -->
        <meta content="width=device-width, height=device-height, initial-scale=1, maximum-scale=1" id="viewport" name="viewport"/>
        <!--<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>-->
    </head>
    <!-- end add for fix mobile view by Beni R, 14 Dec 2022 -->
    <style>
        #liveAgentClientChat.liveAgentStateWaiting {
            // The CSS class that is applied when the chat request is waiting to be accepted
            // See "Waiting State" screenshot below
            
        }
        #liveAgentClientChat {
            // The CSS class that is applied when the chat is currently engaged
            // See "Engaged State" screenshot below
        }
        #liveAgentClientChat.liveAgentStateEnded {
            // The CSS class that is applied when the chat has ended
            // See "Ended State" screenshot below
        }
        body { 
            overflow: hidden; 
            width: 100%; 
            height: 100%; 
            padding: 0; 
            margin: 0 
        }

        .waiting-chat { 
            /* Center the content */
            align-items: center;
            display: none;
            flex-direction: column;
            justify-content: center;
            
            /* Take full size */
            height: 100vh;
            width: 100%;
            
            /* Background */
            background: url({! URLFOR($Resource.OneAxaWaitingChat) }) center center / cover no-repeat;
        }
        
        #liveAgentClientChat.liveAgentStateWaiting .waiting-chat {display: flex;}
        #liveAgentClientChat.liveAgentStateWaiting .active-chat{display:none;}
        
        
        #liveAgentSaveButton, #liveAgentEndButton { 
            z-index: 2; 
        }
        .liveAgentChatInput {
            height: 25px;
            border-width: 1px;
            border-style: solid;
            border-color: #000;
            background: #fff;
            display: block;
            margin-right: 10px;
            width: 100%;
            float: left;
            width: 100%;
            border-width: 0;
            border-radius: 6px;
            padding: 8px;
            font-size: 14px;
        }
        .liveAgentSendButton {
            border-width: 0;
            background: #F6F6F6;
            color: #0770cd;
            padding: 8px 16px;
            font-size: 12px;
            line-height: 16px;
            font-weight: bold;
            text-align: center;
            border-radius: 6px;
            cursor: pointer;
            transition: all .1s ease-out;
        }
        .liveAgentEndButton{
            border-width: 0;
            background: #f07662;
            color: #ffffff;
            padding: 8px 16px;
            font-size: 12px;
            line-height: 16px;
            font-weight: bold;
            text-align: center;
            border-radius: 6px;
            cursor: pointer;
            transition: all .1s ease-out;
        }
        
        #liveAgentChatLog {
            border: 0;
            width: auto;
        //height: 320px;
        	height: 65vh;
            position: relative;
            overflow-y: auto;
        }

        .container {
            /* Center the content */
            align-items: center;
            display: inline-block;
            flex-direction: column;
            justify-content: center;
            
            /* Take full size */
        	min-height: 93vh;
            width: 100%;
        //min-height: -webkit-fill-available;
            
            /* Background */
            background: url({! URLFOR($Resource.OneAxaChatBg) }) center center / cover no-repeat;
            position: relative;
        }
        
        .container__header{
            padding: 20px 15px;
            background: #e5e5e5;
            border-bottom: 1px solid #DADADA;
            align-content: stretch;
            align-items: center;
            flex-shrink: 0;
        }
        
        .container__footer {
            background: #f6f6f6;
            display: flex;
            justify-content: space-between;
        	//padding: 12px 16px 16px;
        	padding: 1% 2% 2%;
            width: 96%;
            position: absolute;
            bottom: 0;
        }
        
        .container__footer .chat-message-input {
            width: 100%;
            padding-right: 10px;
        }
        .container__footer .chat-footer-actions {
            margin-left: 16px;
        	//margin-right: 32px;
        }
        
        .container__main {
            flex-grow: 1;
        	//padding: 20px 15px;
        	padding: 4px 3px;
        }
        
        .chat-user-image {
            width: 40px;
            height: 40px;
            float: left;
            margin-right: 10px;
        }
        .chat-user-image > img {
            width: 100%;
        }
        
        .container__header .chat-header-info {
            margin: 0 16px;
            flex: 1;
            float: left;
        }
        .container__header .chat-header-info .chat-title {
            font-size: 18px;
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }
        .container__header .chat-header-info .chat-desc {
            font-size: 12px;
            color: #8F8F8F;
        }
        
        .chat-header-actions {
            width: 100%;
            flex: 1;
            text-align: right;
        }
        
        .spinner {
            text-align: center;
        }
        .spinner > div {
            width: 18px;
            height: 18px;
            background-color: #f07662;
            border-radius: 100%;
            display: inline-block;
            -webkit-animation: bouncedelay 1.4s infinite ease-in-out;
            animation: bouncedelay 1.4s infinite ease-in-out;
            -webkit-animation-fill-mode: both;
            animation-fill-mode: both;
        }
        .spinner .bounce1 {
            -webkit-animation-delay: -0.32s;
            animation-delay: -0.32s;
        }
        .spinner .bounce2 {
            -webkit-animation-delay: -0.16s;
            animation-delay: -0.16s;
        }
        @-webkit-keyframes bouncedelay {
            0%, 80%, 100% { -webkit-transform: scale(0.0) }
            40% { -webkit-transform: scale(1.0) }
        }
        @keyframes bouncedelay {
            0%, 80%, 100% { 
                transform: scale(0.0);
                -webkit-transform: scale(0.0); 
            } 40% { 
                transform: scale(1.0);
                -webkit-transform: scale(1.0);
            }
        }
        
        #liveAgentChatLogText {
            display: inline-block;
            width: 100%;
        }
        #liveAgentChatLogText span {
          display: block;
          position: relative;
          flex-wrap: wrap;
          font-size: 12px;
          clear: both;
        }
        #liveAgentChatLogText span:after {
            content: "";
            display: block;
            clear: both;
            width: 100%;
            height: 1px;
        }
        #liveAgentChatLogText .messageText {
            color : #999999;
            line-height: 18px;
        }
        #liveAgentChatLogText .timestamp {
            display: inline-block;
            color: #8F8F8F;
            font-size: 12px;
            white-space: nowrap;
        }
        #liveAgentChatLogText .operator, #liveAgentChatLogText .client {
            padding: 8px 12px;
            border-radius: 6px;
            max-width: 60%;
            word-wrap: break-word;
        }
        #liveAgentChatLogText .client .name{
            color: #666666;
        }
        #liveAgentChatLogText .client .messageText {
            color : #999999;
        }
        #liveAgentChatLogText .operator {
            background: #F6F6F6;
            float: left;
            margin-left: 15px;
            border-radius: 15px;
            // padding: 20px;
        	padding: 10px;
        }
        .operator + .timestamp {
            float: left;
            margin-left: 28px;
        }
        #liveAgentChatLogText .client {
            flex-direction: row-reverse;
            float: right;
            background: #c3d9f1;
            margin-right: 15px;
            border-radius: 15px;
        	// padding: 20px;
        	padding: 10px;
        }
        .client + .timestamp {
            float: right;
            margin-right: 28px;
        }
        #liveAgentChatLogText .client:after {
            margin-right: 16px;
        }
        #liveAgentChatLogText .name {
            display: block;
            color: #666666;
            margin-bottom: 4px;
        }
        #liveAgentChatLogTyping {
            display: block;
            color: #8f8f8f;
            font-size: 14px;
            text-align: center;
        }
        
        .liveAgentSendButton:active {
            outline: 0;
            background: #F6F6F6;
            color: rgba(7, 112, 205, .5);
        }
        .liveAgentSendButton:not(:active):not(.btn-link):focus {
            outline: 0;
        }
        .liveAgentSendButton{
            border-width: 0;
            background: #020090;
            color: white;
            padding: 12px 30px;
            font-size: 12px;
            line-height: 16px;
            font-weight: bold;
            text-align: center;
            border-radius: 6px;
            cursor: pointer;
            transition: all .1s ease-out;
        }
        .liveAgentSendButton:hover{
            background: #2289e4;
        }
        #liveAgentChatTextArea {
            font-size: 14px !important;
        }
    </style>
    <liveAgent:clientChat >
        <div class="waiting-chat">
            <img id="AFIBrandLogo" src="{! URLFOR($Resource.AFIBrandLogo) }" class="illustration" width="75"/><br/>
            <span>Mohon Menunggu, Anda Akan Segera Terhubung</span><br/>
            <span>Dengan Customer Service Live Chat AXA</span><br/><br/>
            <div class="spinner">
                <div class="bounce1"></div>
                <div class="bounce2"></div>
                <div class="bounce3"></div>
            </div>
        </div>
        <div class="container">
            <header class="container__header">
                <div class="chat-user-image">
                    <img src="{! URLFOR($Resource.AFIBrandLogo) }" width="50"/>
                </div>
                <div class="chat-header-info">
                    <span id="chat-agent-name" class="chat-title">Emma By AXA</span>
                    <span class="chat-desc">Customer Care Centre</span>
                </div>
                <div class="chat-header-actions">
                    <liveAgent:clientChatEndButton label="Akhiri Obrolan" />
                </div>
            </header>
            <main class="container__main">
                <div class="chat-status-msg" id="chat-status-msg">
                    <liveAgent:clientChatAlertMessage />
                    <liveAgent:clientChatStatusMessage reconnectingLabel="Please check your internet connection and try again." />
                </div>
                <div class="chat-window" id="chat-window">
                    <liveAgent:clientChatLog agentTypingLabel="Agen sedang menulis..." showTimeStamp="True" visitorNameLabel="Anda" />
                </div>
            </main>
            <footer class="container__footer">
                <div class="chat-message-input">
                    <liveagent:clientChatInput useMultiline="True" autoResizeElementId="liveAgentChatLog"/>
                </div>
                <div class="chat-footer-actions">
                    <liveAgent:clientChatSendButton label="Kirim" />
                </div>
            </footer>
        </div>
        <script>
            document.getElementById('liveAgentChatTextArea').placeholder='Ketik pesan Anda di sini';
            var liveAgentIdleTimeout = function(a) {
                currentSecond = a-60;
                resultMsg = "This chat will be concluded in ";
                if(a>60) resultMsg += "1m ";
                resultMsg += currentSecond + "s";
                resultMsg += ". Type to continue.";
                document.getElementById('liveAgentChatLogAlertMessage').innerHTML = resultMsg;
            }
            liveagent.addEventListener(liveagent.chasitor.Events.UPDATE_CHASITOR_IDLE_TIMEOUT_WARNING, liveAgentIdleTimeout);
        </script>
    </liveAgent:clientChat>
</apex:page>