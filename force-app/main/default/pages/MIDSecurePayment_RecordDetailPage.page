        <apex:pageblock id="MidSecureHistory" title="MID_Secure_Payment History" tabStyle="ActivityHistory">
                <apex:actionStatus id="status" >
                    <apex:facet name="start">
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel >
                            <apex:commandButton value="Reload" action="{!loadMidSecurePaymentHistory}" rerender="MidSecureHistory" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus><br/>
                 <apex:pageBlockTable value="{!mid_secure_history}" var="msh" rendered="{!mid_secure_history.size != 0}">  
                   <apex:column headerValue="Date"><apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!msh.createdDate}" /> </apex:outputText></apex:column>
                   <apex:column headerValue="User"><apex:outputLink value="/{!msh.createdById}">{!msh.createdById_Name}</apex:outputLink></apex:column>
                   <apex:column headerValue="Action" value="{!msh.action}"/>
               </apex:pageBlockTable>
                <apex:outputLabel value="No records to display" rendered="{!mid_secure_history.size == 0}" styleClass="noRowsHeader"></apex:outputLabel>
            </apex:pageblock>
        
        <apex:pageblock id="MidCustomHistory" title="MID_Custom_History" tabStyle="MID_Custom_History__c">
                <apex:actionStatus id="status" >
                    <apex:facet name="start">
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel >
                            <apex:commandButton value="Reload" action="{!loadMidCustomHistory}" rerender="MidCustomHistory" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus><br/>
                 <apex:pageBlockTable value="{!mid_custom_history}" var="mch" rendered="{!mid_custom_history.size != 0}">  
                   	 <apex:column headerValue="Mid_Custom_History_Name"><apex:outputLink value="/apex/MidCustomHistory_RecordDetailPage?id={!mch.Id}">{!mch.name}</apex:outputLink></apex:column>
                     <apex:column headerValue="SFDC_Order_Id" value="{!mch.sfdC_Order_Id_c}"/>
                   	 <apex:column headerValue="Origin" value="{!mch.origin_c}"/>
                     <apex:column headerValue="Payment Type" value="{!mch.payment_Type_c}"/>
                     <apex:column headerValue="Policy_App" value="{!mch.policy_App_c}"/>
                     <apex:column headerValue="mid_status_code" value="{!mch.mid_status_code_c}"/>
                     <apex:column headerValue="mid_status_message" value="{!mch.mid_status_message_c}"/>
               </apex:pageBlockTable>
                <apex:outputLabel value="No records to display" rendered="{!mid_custom_history.size == 0}" styleClass="noRowsHeader"></apex:outputLabel>
            </apex:pageblock>
