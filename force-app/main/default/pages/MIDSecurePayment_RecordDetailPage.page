                    <img src="/img/checkbox_{!IF(!mid_pay.data.parent_c, 'un', '')}checked.gif"/-->
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="PureCloud Information" columns="2" collapsible="true" showHeader="true">
