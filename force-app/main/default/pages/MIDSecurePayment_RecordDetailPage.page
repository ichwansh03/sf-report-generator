<apex:page controller="MIDSecurePayment_CustomPage_ctrl" showHeader="{!isConsole}" sidebar="{!isConsole}">
    <style>
        .efhpTitle {
        font-size: 1.8em;
        font-weight: bold; 
        color: rgb(73, 75, 78);
        padding-bottom: 7px;
        }
        .efhpRow {
        padding-bottom: 3px;
        }
        .efhpDescription {
        word-wrap: break-word;
        color: #494b4e;
        min-height: 25px;
        }
        .efhpValue a {
        color: #015ba7;
        text-decoration: none;
        overflow: hidden;
        }
        .vl {
        border-left: 1px solid #dbdfe0;
        height: 70px;
        }
    </style>
    <br/>
    <table cellspacing="0" cellpadding="0">
        <tr>
            <td width="50%">
                <table>
                    <tr>
                        <td style="vertical-align: middle;" rowspan="2"><img src="/img/icon/cd32.png"/></td>
                        <td><div><STRONG>MID_Secure_Payment</STRONG></div></td>
                    </tr>
                    <tr>
                        <td style="vertical-align: bottom;"><div class="efhpTitle">{!mid_pay.data.Name}</div></td>
                    </tr>
                </table>
                <!--div class="efhpRow ">
                    <div class="efhpValue efhpDescription">{!mid_pay.data.Description}</div>
                </div>-->
            </td>
        </tr>
    </table>
    <apex:form id="formId">
        <apex:pageMessages />        
        <apex:pageBlock id="PaymentDetail" mode="maindetail" tabStyle="MID_Secure_Payment__c" title="">
            <br/>
            <apex:pageBlockButtons >
                <!--apex:commandButton action="{!save}" value="Save" status="actStatusId"/>-->
            </apex:pageBlockButtons>
            <apex:pageBlockSection title="Reference" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Case"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/apex/MIDSecurePayment_RecordDetailPage?id={!mid_pay.data.case_c}" >{!mid_pay.data.case_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Information" columns="2" collapsible="true" showHeader="true">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="MID_Secure_Payment_No"></apex:outputLabel>
                    <apex:outputText value="{!mid_pay.data.Name}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Owner"></apex:outputLabel>
                    <apex:outputPanel ><img style="vertical-align: bottom;" width="15" height="15" src="/profilephoto/005/T"/>&nbsp;<apex:outputLink value="/{!mid_pay.data.OwnerId}" >{!mid_pay.data.Ownerid_name}</apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="External Id SFDC"></apex:outputLabel>
                    <apex:outputText value="{!mid_pay.data.external_Id_SFDC_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="SFDC_Order_Id"></apex:outputLabel>
                    <apex:outputText value="{!mid_pay.data.sfdC_Order_Id_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
