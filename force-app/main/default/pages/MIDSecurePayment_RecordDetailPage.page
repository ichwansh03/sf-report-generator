                    <apex:outputText value="{!mid_pay.data.jsonRequestBody_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="JsonErrorMessage"></apex:outputLabel>
                    <apex:outputText value="{!mid_pay.data.JsonErrorMessage_c}"/>
