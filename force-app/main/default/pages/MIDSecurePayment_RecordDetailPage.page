                    <apex:outputText value="{!mid_pay.data.JsonBackEndError_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Internal Log" columns="2" collapsible="false" showHeader="false">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Created By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputLink value="/{!mid_pay.data.CreatedById}" >{!mid_pay.data.CreatedBy_name}</apex:outputLink>,&nbsp;
                        <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!mid_pay.data.CreatedDate}" /> </apex:outputText>
