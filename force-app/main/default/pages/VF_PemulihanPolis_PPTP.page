<apex:page renderAs="PDF" showHeader="false" applyHtmlTag="false" applyBodyTag="false" standardController="E_Form_Master_Data__c" extensions="AMFS_PemulihanPolis_Controller">
    <html>
        <head>
            <style type="text/css">
                @page {
                  margin-top: 2%;
                  margin-bottom: 50pt;
                  margin-left: 0;
                  margin-right: 0;
                  size: A4 portrait;
                  page-break:always; 
                  page-break-inside:avoid;
                  letter-spacing: 5px;
                  font-family: Arial, sans-serif;
                  @top-left { content: element(header); }
                  @bottom-left { content: element(footer); }
                }

                /* ========== Base Utility ========== */
                .center
                    { 
                      text-align:center; 
                      font-family: sans-serif !important;
                    } 
                .right{ text-align:right; } .left{ text-align:left; }
                .top{ vertical-align:top; } .justify{ text-align:justify; } .uppercase{ text-transform:uppercase; }
                .font{ font-family:sans-serif !important; }
                .nopad{ padding:0; border:0; }
                .pagefooter:before{ content: "Page : " counter(page) "/" counter(pages); }
                .pagenumber:before{ content: counter(page); } .pagecount:before{ content: counter(pages); }

                /* Header/Footer blocks */
                div.header{ text-align:center; font-family:sans-serif !important; font-weight:bold; }
                div.footer{ display:block; padding:5px; position:running(footer); font-family:Arial, sans-serif; }
                div.content{ width:100%; font-family:sans-serif !important; }

                /* Simple tables */
                table.custom-table{ width:100%; border-collapse:collapse; font-family:sans-serif !important; font-size:16px; margin-top:10px; text-align:center; }
                table.custom-table th{ background:#396cb2; color:#fff; padding:8px; border:1px solid #ccc; }
                table.custom-table td{ padding:8px; border:1px solid #ccc; vertical-align:top; }
                table.custom-table tr{ page-break-inside: avoid }                
                table.custom-table-header{ width:100%; border-collapse:collapse; font-family:sans-serif !important; font-size:12px; margin-top:10px; }
                table.custom-table-header td{ padding:8px; vertical-align:middle; }
                table.custom-table-header-value-pajak{ width:100%; border-collapse:collapse; font-family:sans-serif !important; font-size:12px; margin-top:10px; }
                table.custom-table-header-value-pajak td{ vertical-align:top; text-align:left; }
                table.custom-table-header-value-pajak td:first-child{ width:90%; }
                table.custom-table-header-value-pajak td:nth-child(2){ width:10%; }
                table.custom-table-header-pernyataan-kuasa {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 10px;
                }

                table.custom-table-header-pernyataan-kuasa th {
                    font-weight:bold;
                    color: black;
                    padding: 8px;
                    text-align: center;
                    font-size: 12px;
                }

                table.custom-table-header-pernyataan-kuasa td {
                    vertical-align: top;
                    text-align: justify;
                    font-size: 10px;
                }

                table.standard-table{ width:95%; border-collapse:collapse; font-family:sans-serif; font-size:12px; }

                /* Detail lists */
                td.label{ width:40%; font-size:12px; font-family:sans-serif !important; }
                td.value{ color:#000; font-size:12px; font-weight:bold; font-family:sans-serif !important; }

                /* Section banners */
                .info-header{ background:#396cb2; color:#fff; padding:8px; text-align:center; font-weight:bold; }

                /* ========== NEW: Grid seragam 5 kolom (kunci alignment) ========== */
                .table-5col{ width:100%; border-collapse:collapse; page-break-inside: auto; font-family:sans-serif !important; font-size:9px; border:2px solid ; }
                .table-5col th, .table-5col td{ border:1px solid; padding:6px; vertical-align:top; }
                .table-5col tr{ page-break-inside: avoid; padding-bottom: 10px;}                
                .table-5col thead th{ font-weight:bold; text-align:center; }
                .table-5col { margin: 0;}
                .table-5col + .table-5col{
                    border-top: 0;                             /* buang border atas tabel berikutnya */
                    margin-top: -2px;                          /* tumpuk 2px agar garis sambungan jadi 1 garis */
                    }
                    /* buang border atas pada baris pertama tabel berikutnya (thead atau tbody) */
                    .table-5col + .table-5col thead tr:first-child > * ,
                    .table-5col + .table-5col tbody tr:first-child > * { 
                    border-top: 0;
                    }
                /* Nested detail (rokok) */
                .smoking-detail-inline{ width:100%; border-collapse:collapse; table-layout:fixed; font-family:sans-serif !important; font-size:9px; }
                .smoking-detail-inline th, .smoking-detail-inline td{ border:1px solid #000; padding:6px; vertical-align:middle; text-align:center; }

                /* Misc legacy styles preserved (dipakai bagian lain) */
                .grid, .grid th, .grid td{ border:1px solid; border-collapse:collapse; padding:3px; }
                .grid th{ background:#E8E8E8; }
                .tdHeader{ width:70%; height:15px; font-size:12px; text-align:justify; }
                .tables{ width:100%; border-collapse:collapse; padding:10px; margin-top:25px; font-size:12px; }
                .dpp{ width:60%; font-size:9px; }
                .rincian-pertanyaan{ 
                    padding: 5px 10px; 
                    vertical-align: top;
                    font-size: 9px;
                    font-family: sans-serif !important;
                }
                    
            </style>
        </head>

        <!-- ======= FOOTER (running) ======= -->
        <footer>
           <div class="footer" style="bottom: 10px; width: 100%; text-align: center; font-size: 12px;">
              <div class="left" style="margin-left:50px;" >
                  <apex:image value="{!$Resource.ojk_logo_bot}" width="300px"></apex:image>
              </div>
          </div>
        </footer>
       

        <!-- ======= HEADER ======= -->
        <div class="header">
            <table class="custom-table-header">
                <tr>
                    <td style="text-align:left;"><apex:image value="{!$Resource.emma_axa}" width="300px"/></td>
                    <td style="text-align:right; color:#396cb2">CCC-{!touchPoint}</td>
                </tr>
            </table>
        </div>

        <!-- ======= TITLE ======= -->
        <div class="info-container">
            <p class="center" style="font-size:16px; font-weight:bold;">
                PEMULIHAN POLIS<br/>
                AXA Mandiri Financial Services<br/>
                Nomor Polis : {!polisNo}<br/>
                Nomor Transaksi: Pemulihan Polis - {!transNo}<br/>
                Tanggal Pengajuan Pemulihan Polis: {!inputdtmmss}
            </p>
        </div>

        <!-- ======= INFORMASI PEMEGANG POLIS ======= -->
        <table class="custom-table"><tr><th>INFORMASI PEMEGANG POLIS</th></tr></table>
        <table>
            <tr>
              <td class="label top">Nama Pemegang Polis</td>
              <td class="top">:</td>
              <td class="value top">{!phName}</td>
            </tr>
            <tr>
              <td class="label top">No. Telepon</td>
              <td class="top">:</td>
              <td class="value top">{!noTelp}</td>
            </tr>
            <tr><td class="label top">Alamat</td><td class="top">:</td><td class="value top">{!addr}</td></tr>
            <tr><td class="label top">Email</td><td class="top">:</td><td class="value top">{!email}</td></tr>
            <tr><td class="label top">NIK</td><td class="top">:</td><td class="value top">{!noIdentitas}</td></tr>
            <tr><td class="label top">Tanggal Lahir</td><td class="top">:</td><td class="value top">{!tglLahir}</td></tr>
            <tr><td class="label top">Nama Produk</td><td class="top">:</td><td class="value top">{!prodName}</td></tr>
            <tr><td class="label top">Segmentasi</td><td class="top">:</td><td class="value top">{!segmentasi}</td></tr>
        </table>

        <!-- ======= PAJAK LUAR NEGERI ======= -->
        <table class="custom-table"><tr><th>INFORMASI PELAPORAN PAJAK LUAR NEGERI</th></tr></table>
        <table class="custom-table-header-value-pajak">
            <tr>
                <td>Apakah Anda Melakukan Pelaporan Pajak di Luar Negara Indonesia ?</td>
                <td style="text-align:start">: {!pajak}</td>
            </tr>
        </table>

        <!-- ======= RINCIAN DATA PEKERJAAN & KESEHATAN (IDENTITAS) ======= -->
        <table class="custom-table"><tr><th>RINCIAN DATA PEKERJAAN DAN KESEHATAN</th></tr></table>
        <table style="width:100%; font-size:9px; border-collapse:collapse; font-family:sans-serif; table-layout:fixed;" border="2px solid">
            <colgroup><col style="width:40%"/><col style="width:30%"/><col style="width:30%"/></colgroup>
            <tr>
                <th class="center">Rincian Data</th>
                <th class="center">Pemegang Polis</th>
                <th class="center">Tertanggung/Peserta</th>
            </tr>
            <tr><td class="rincian-pertanyaan">Nama Pemegang Polis</td><td class="rincian-pertanyaan">{!phName}</td><td class="rincian-pertanyaan">{!namaTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Pekerjaan Saat Ini</td><td class="rincian-pertanyaan">{!pekerjaanPP}</td><td class="rincian-pertanyaan">{!pekerjaanTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Jabatan</td><td class="rincian-pertanyaan">{!jabatanPP}</td><td class="rincian-pertanyaan">{!jabatanTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Nama Perusahaan</td><td class="rincian-pertanyaan">{!namaPerusahaanPP}</td><td class="rincian-pertanyaan">{!namaPerusahaanPP}</td></tr>
            <tr><td class="rincian-pertanyaan">Bidang Usaha</td><td class="rincian-pertanyaan">{!bidangUsahaPP}</td><td class="rincian-pertanyaan">{!bidangUsahaTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Rincian Tugas</td><td class="rincian-pertanyaan">{!rincianTugasPP}</td><td class="rincian-pertanyaan">{!rincianTugasTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Alat bantu yang digunakan</td><td class="rincian-pertanyaan">{!alatBantuPP}</td><td class="rincian-pertanyaan">{!alatBantuTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Tinggi Badan saat ini (cm)</td><td class="rincian-pertanyaan">{!tinggiBadanSaatIniPP}</td><td class="rincian-pertanyaan">{!tinggiBadanSaatIniTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Berat Badan saat ini (kg)</td><td class="rincian-pertanyaan">{!beratBadanSaatIniPP}</td><td class="rincian-pertanyaan">{!beratBadanSaatIniTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Tinggi Badan tahun lalu (cm)</td><td class="rincian-pertanyaan">{!tinggiBadanTahunLaluPP}</td><td class="rincian-pertanyaan">{!tinggiBadanTahunLaluTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Berat Badan tahun lalu (kg)</td><td class="rincian-pertanyaan">{!beratBadanTahunLaluPP}</td><td class="rincian-pertanyaan">{!beratBadanTahunLaluTP}</td></tr>
            <tr><td class="rincian-pertanyaan">Alasan perubahan tinggi/berat badan Anda</td><td class="rincian-pertanyaan">{!E_Form_Master_Data__c.Alasan_perubahan_tinggi_berat_badan__c}</td><td class="rincian-pertanyaan">{!E_Form_Master_Data__c.Alasan_perubahan_tinggi_berat_badan_TP__c}</td></tr>
        </table>

        <!-- ======= INFORMASI KESEHATAN (GRID 5 KOLOM KONSISTEN) ======= -->

        <table class="custom-table" style="margin-top:10px; page-break-before: always;"><tr><th>INFORMASI KESEHATAN PEMEGANG POLIS DAN TERTANGGUNG</th></tr></table>
        <table class="table-5col">
          <colgroup>
            <col style="width:43%"/>
            <col style="width:10%"/>
            <col style="width:19%"/>
            <col style="width:10%"/>
            <col style="width:19%"/>
          </colgroup>
          <thead>
            <tr>
              <th>Pertanyaan</th>
              <th>Tertanggung </th>
              <th>Penjelasan</th>
              <th>Pemegang Polis</th>
              <th>Penjelasan</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="5" style="font-weight:bold;">C. Data Pribadi dan Kebiasaan</td></tr>

            <tr>
              <td>a. Apakah permohonan/polis Anda pernah ditolak/ditunda/dikenakan ekstra premi/dikecualikan atau diubah/dihentikan?</td>
              <td class="center">{!DTPKRBTP1}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan_TP__c}</td>
              <td class="center">{!DTPKPPRBPP1}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan__c}</td>
            </tr>

            <tr>
              <td>b. Apakah sedang mendapat manfaat ketidakmampuan atau pernah klaim ketidakmampuan/kecelakaan/perawatan/penyakit kritis?</td>
              <td class="center">{!DTPKRBTP2}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan1_TP__c}</td>
              <td class="center">{!DTPKPPRBPP2}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan1__c}</td>
            </tr>
            <tr><td colspan="5" style="border:0; padding:0; height:0;"></td></tr>
            <tr>
              <td>c. Apakah Anda merokok / menggunakan tembakau (termasuk tanpa asap) dalam 12 bulan terakhir?</td>
              <td class="center">{!DTPKRBTP3}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan2_TP__c}</td>
              <td class="center">{!DTPKPPRBPP3}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan2__c}</td>
            </tr>

            <!-- Baris detail rokok: render sebagai <tr> penuh, nested table di dalam 1 sel colspan=5 -->
            <apex:outputPanel rendered="{!OR(DTPKRBTP3='YA', DTPKPPRBPP3='YA')}" layout="none">
              <tr>
                <td colspan="5" class="nopad">
                  <table class="smoking-detail-inline">
                    <thead>
                      <tr><th colspan="5" class="center">Pemegang Polis</th><th colspan="5" class="center">Tertanggung/Peserta</th></tr>
                      <tr>
                        <th>Rokok</th><th>Sejak</th><th>Rokok Elektrik</th><th>Sejak</th><th>Tanpa Asap</th>
                        <th>Rokok</th><th>Sejak</th><th>Rokok Elektrik</th><th>Sejak</th><th>Tanpa Asap</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>{!rokokPP}</td><td>{!sejakPP}</td><td>{!rokokElektrikPP}</td><td>{!sejekElektrikPP}</td><td>{!tanpaAsapPP}</td>
                        <td>{!rokokTP}</td><td>{!sejakTP}</td><td>{!rokokElektrikTP}</td><td>{!sejekElektrikTP}</td><td>{!tanpaAsapTP}</td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
            </apex:outputPanel>

            <tr>
              <td>d. Apakah Anda memiliki hobi/kegiatan berisiko tinggi (terjun payung, menyelam, balap, penerbangan, dll)?</td>
              <td class="center">{!DTPKRBTP4}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan3_TP__c}</td>
              <td class="center">{!DTPKPPRBPP4}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan3__c}</td>
            </tr>

            <tr>
              <td>e. Apakah Anda mengkonsumsi minuman alkohol?</td>
              <td class="center">{!DTPKRBTP5}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan4_TP__c}</td>
              <td class="center">{!DTPKPPRBPP5}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan4__c}</td>
            </tr>

            <tr>
              <td>f. Apakah pernah mengkonsumsi obat-obatan terlarang/penenang atau rehabilitasi/konsultasi narkoba?</td>
              <td class="center">{!DTPKRBTP6}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan5_TP__c}</td>
              <td class="center">{!DTPKPPRBPP6}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_pribadi_kebiasaan5__c}</td>
            </tr>

            <tr><td colspan="5" style="font-weight:bold;">D1. Data Kesehatan</td></tr>
            <tr>
              <td>a. Apakah pernah menerima/menjalani perawatan medis atau diresepkan obat untuk kondisi selain pilek/flu?</td>
              <td class="center">{!DTKESRBTP2}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan1_TP__c}</td>
              <td class="center">{!DTKESRBPP1}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan__c}</td>
            </tr>
            <tr>
              <td>b. Apakah pernah dianjurkan pemeriksaan medis terkait kendala kesehatan?</td>
              <td class="center">{!E_Form_Master_Data__c.Pertanyaan_dt_kesehatan1_TP__c}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_TP__c}</td>
              <td class="center">{!DTKESRBPP2}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan1__c}</td>
            </tr>
            <tr>
              <td>c. Apakah sedang menunggu hasil/test investigasi kesehatan?</td>
              <td class="center">{!DTKESRBTP3}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan2_TP__c}</td>
              <td class="center">{!DTKESRBPP3}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan2__c}</td>
            </tr>
            <tr>
              <td>d. Apakah pernah dirawat/dioperasi?</td>
              <td class="center">{!DTKESRBTP4}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan3_TP__c}</td>
              <td class="center">{!DTKESRBPP4}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan3__c}</td>
            </tr>
            <tr>
              <td>e. (Khusus TP &lt; 5 tahun) Apakah ada komplikasi saat dilahirkan?</td>
              <td class="center">{!DTKESRBTP5}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan4_TP__c}</td>
              <td class="center">{!DTKESRBPP5}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan4__c}</td>
            </tr>
          </tbody>
        </table>

        

        <!-- ======= D2: Data Kesehatan Khusus Wanita (tetap sejajar) ======= -->
        <apex:outputPanel rendered="{!OR(FTP='FTP', FPP='FPP')}" layout="none">
          <table class="table-5col">
            <colgroup>
              <col style="width:43%"/><col style="width:10%"/><col style="width:19%"/><col style="width:10%"/><col style="width:19%"/>
            </colgroup>
            <thead><tr><td colspan="5" style="font-weight:bold;">D2. Data kesehatan khusus Wanita</td></tr></thead>
            <tbody>
              <tr>
                <td>Apakah Anda saat ini sedang hamil? Sebutkan kehamilan keberapa dan HPHT.</td>
                <td class="center">{!E_Form_Master_Data__c.Pertanyaan_dt_khusus_wanita_TP__c}</td>
                <td>{!E_Form_Master_Data__c.Penjelasan_dt_khusus_wanita_TP__c}</td>
                <td class="center">{!DTWARBPP}</td>
                <td>{!E_Form_Master_Data__c.Penjelasan_dt_khusus_wanita__c}</td>
              </tr>
            </tbody>
          </table>
        </apex:outputPanel>

        <!-- ======= D3: Data Kesehatan Tambahan ======= -->
        <table class="table-5col">
          <colgroup>
            <col style="width:43%"/><col style="width:10%"/><col style="width:19%"/><col style="width:10%"/><col style="width:19%"/>
          </colgroup>
          <thead><tr><td colspan="5" style="font-weight:bold;">D3. Data Kesehatan Tambahan</td></tr></thead>
          <tbody>
            <tr>
              <td>a) Sistem saraf: vertigo, stroke, epilepsi, dll</td>
              <td class="center">{!DTKESTAMRBTP2}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan1_TP__c}</td>
              <td class="center">{!DTKESTAMRBPP2}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan1__c}</td>
            </tr>
            <tr>
              <td>b) Sistem hormonal: diabetes (termasuk gestasional), tiroid, dll</td>
              <td class="center">{!DTKESTAMRBTP3}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan2_TP__c}</td>
              <td class="center">{!DTKESTAMRBPP3}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan2__c}</td>
            </tr>
            <tr>
              <td>c) Kelainan darah: anemia, thalasemia, hemofilia, dll</td>
              <td class="center">{!DTKESTAMRBTP4}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan3_TP__c}</td>
              <td class="center">{!DTKESTAMRBPP4}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan3__c}</td>
            </tr>
            <tr></tr>
            <tr>
              <td>d) THT: tuli, infeksi telinga, tonsilitis, sinusitis, dll</td>
              <td class="center">{!DTKESTAMRBTP5}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan4_TP__c}</td>
              <td class="center">{!DTKESTAMRBPP5}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan4__c}</td>
            </tr>
            <tr>
              <td>e) Mata: glaukoma, katarak, dll</td>
              <td class="center">{!DTKESTAMRBTP6}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan5_TP__c}</td>
              <td class="center">{!DTKESTAMRBPP6}</td>
              <td>{!E_Form_Master_Data__c.Penjelasan_dt_kesehatan_tambahan5__c}</td>
            </tr>
            <tr>
              <td>f) Paru-paru/napas: ISPA, asma, TBC, bronkitis, pneumonia, dll</td>
