<apex:page controller="Case_CMU_Change_Owner_Ctrl" showHeader="true" sidebar="false">
<html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
<apex:sectionHeader title="" subtitle="CMU AMFS Named User Assign"/>
<apex:form id="formid">
    <apex:pageMessages />
    <apex:pageBlock >
      <div align="left">
           <apex:pageBlockButtons >
          	<apex:commandButton action="{!save}" value="Save" />
          </apex:pageBlockButtons>
      </div>
      <p>&nbsp;</p>
        <!--apex:pageMessage summary="{!errormessage}" rendered="{!renderErrorMessage}" severity="error" strength="3" /-->
        <apex:pageBlockSection >
			<apex:selectList value="{!prev_user}" label="From" size="1" >
                <apex:selectOption itemValue="" itemLabel="-"/>
                <!--<apex:actionSupport event="onchange" action="{!searchAgent}" reRender="formid"/>-->
                <apex:selectOptions value="{!NamedUserAlllist}"/>
            </apex:selectList> 
            <apex:selectList value="{!choosen_user}" label="To" size="1" >
                <apex:selectOption itemValue="" itemLabel="-"/>
                <!--<apex:actionSupport event="onchange" reRender="formid"/>-->
                <apex:selectOptions value="{!NamedUserlist}"/>
            </apex:selectList>
            <apex:commandButton value="Search" action="{!populateFreshData}"/>
        </apex:pageBlockSection>
        <br/>  
        <span align="center">
        </span>
          <br/>  
          <br/> 
          <apex:pageBlockSection title="List of Distributed Call Line`s">
          <apex:pageBlockTable id="idpbt"  value="{!tempCallLineList}" var="cl" style="overflow:auto;width:850px;" align="center" border="1">
            <apex:column headerValue="Select"><apex:inputCheckbox value="{!cl.cl_isSelected}"></apex:inputCheckbox></apex:column>  
            <apex:column headerValue="Current Named User"><apex:outputText value="{!cl.cl_Named_User}"></apex:outputText></apex:column>
            <apex:column headerValue="Case Number"><apex:outputText value="{!cl.cl_CaseNumber}"/></apex:column>
            <apex:column headerValue="Contact Name"><apex:outputText value="{!cl.cl_Contact_Name}"/></apex:column>
            <apex:column headerValue="Policy No"><apex:outputText value="{!cl.cl_Contact_Policy_No}"/></apex:column>
            <apex:column headerValue="Received Date"><apex:outputText value="{!cl.cl_Received_date}"/></apex:column>
            <apex:column headerValue="Aging"><apex:outputText value="{!cl.cl_Age}"/></apex:column>
            <apex:column headerValue="Category"><apex:outputText value="{!cl.cl_Category}"/></apex:column>
            <apex:column headerValue="Complaint Type"><apex:outputText value="{!cl.cl_Complaint_type}"/></apex:column>
            <apex:column headerValue="Other Information"><apex:outputText value="{!cl.cl_Other_Information}"/></apex:column>
            <apex:column headerValue="Request Status"><apex:outputText value="{!cl.cl_CHS_Status}"/></apex:column>
            <apex:column headerValue="Complaint"><apex:outputText value="{!cl.cl_Complaint}"/></apex:column>
          </apex:pageBlockTable>
          </apex:pageBlockSection>
     </apex:pageBlock>
</apex:form>
    </html>
</apex:page>