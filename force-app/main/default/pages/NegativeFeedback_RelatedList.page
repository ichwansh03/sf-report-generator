<apex:page standardController="Contact" extensions="NegativeFeedback_CustomPage_ctrl" sidebar="false" showHeader="false">
    <apex:includeScript value="/soap/ajax/32.0/connection.js"/>   
    <apex:includeScript value="/support/console/37.0/integration.js"/>    
    <!--  JAVASCRIPT ABOVE --> 
    <script type="text/javascript">  

        var urlRequestNewTabRelatedContactNegativeFeedback ='';
        var titleNewTabRelatedContactNegativeFeedback ='';
  
        function openNewTabRelatedContactNegative(el) {
            console.log(el);    
            let negativeFeedbackId = el.getAttribute('data-id');
            let uniqueId = el.getAttribute('data-lastId');
            console.log(negativeFeedbackId);
            titleNewTabRelatedContactNegativeFeedback = el.getAttribute('data-title');
            urlRequestNewTabRelatedContactNegativeFeedback ='/apex/NegativeFeedback_RecordDetailPage?id='+ negativeFeedbackId+'&lastId='+uniqueId; 
            if (sforce.console.isInConsole()) {
                sforce.console.getEnclosingPrimaryTabId(openSubTabRelatedContactNegativeFeedback);
            }
            else {
                javascript:var x=window.open(urlRequestNewTabRelatedContactNegativeFeedback,'_blank');
            }
        }

        function openSubTabRelatedContactNegativeFeedback(result) {
            // var primaryTabId = {!id};
            let primaryTabId = result.id; 
            console.log('primary tab id for '+titleNewTabRelatedContactNegativeFeedback+': '+primaryTabId);
            // i++;
            sforce.console.openSubtab(primaryTabId , urlRequestNewTabRelatedContactNegativeFeedback , false, titleNewTabRelatedContactNegativeFeedback, null, null, titleNewTabRelatedContactNegativeFeedback);
        }
    
        var urlRequestNewTabRelatedContactCase ='';
