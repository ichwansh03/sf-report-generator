            }
        }

        function openSubTabRelatedContactSurveyForm(result) {
            // var primaryTabId = {!id};
            let primaryTabId = result.id; 
            console.log('primary tab id for '+titleNewTabRelatedContactSurveyForm+': '+primaryTabId);
            // i++;
            sforce.console.openSubtab(primaryTabId , urlRequestNewTabRelatedContactSurveyForm , false, titleNewTabRelatedContactSurveyForm, null, null, titleNewTabRelatedContactSurveyForm);
        }

        
        var urlRequestNewTabRelatedContactSurveyResponse ='';
        var titleNewTabRelatedContactSurveyResponse ='';
  
        function openNewTabRelatedContactSurveyResponse(el) {
            console.log(el);    
            let SurveyResponseId = el.getAttribute('data-id');
            console.log(SurveyResponseId);
            titleNewTabRelatedContactSurveyResponse = el.getAttribute('data-title');
            urlRequestNewTabRelatedContactSurveyResponse ='/'+ SurveyResponseId; 
            if (sforce.console.isInConsole()) {
