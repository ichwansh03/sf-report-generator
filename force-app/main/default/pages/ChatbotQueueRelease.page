<apex:page controller="ChatbotQueueReleaseController" showHeader="true">
    <apex:includeScript value="{!$Resource.JQuery1_9_1}"/>
    <c:StatusLoading />
    <apex:sectionHeader title="Chatbot Queue Release"/>
    <apex:form id="pageForm">
        <apex:pagemessages id="msg"/>
        <apex:pageBlock >
            <apex:pageBlockSection columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputPanel >
                        <div style="text-align: center">
                            <apex:commandButton value="Queue Release" action="{!queueRelease}"  reRender="pageForm" status="stSearch"/>
                        </div>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockSection id="queueReleaseInfo"  columns="1">
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Status" />
                    <apex:outputPanel >{!queueReleaseInfoData.status}</apex:outputPanel>
                </apex:pageblockSectionItem>
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Message" />
                    <apex:outputPanel >{!queueReleaseInfoData.message}</apex:outputPanel>
                </apex:pageblockSectionItem>
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Total Queue / Pending" />
                    <apex:outputPanel >{!queueReleaseInfoData.totalQueue}</apex:outputPanel>
                </apex:pageblockSectionItem>
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Released" />
                    <apex:outputPanel >{!queueReleaseInfoData.released}</apex:outputPanel>
                </apex:pageblockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
    
</apex:page>