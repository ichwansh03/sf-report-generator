                                </tr>
                                <tr>
                                    <td>Email </td>
                                    <td>: customer@axa-mandiri.co.id</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td rowspan="8" colspan="2" align = 'Center'> <a href="https://www.axa-mandri.co.id/customer-case-centre"> <apex:image url="{!URLFOR($Resource.EMMA_Barcode)}"/> </a></td>
                                </tr>
                                <tr>
                                    
                                <tr>
                                    <td></td>
                                    <td>&nbsp;&nbsp;priority@axa-mandiri.co.id (Untuk Nasabah Prioritas)</td>
                                </tr>
                                <tr>
                                    <td>Phone </td>
                                    <td>: 021 - 1500 803</td>
                                    </tr>
                                <tr>
                                    <td colspan="2" style="right:0px;font-size:9px;"><b><i>Jam operasional semua layanan Senin – Jumat (kecuali hari libur) Pkl. 08.00 – 17.00 WIB</i></b></td>
                                    <td></td>
                                    </tr>
