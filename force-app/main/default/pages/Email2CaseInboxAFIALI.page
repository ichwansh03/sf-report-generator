<apex:page controller="Email2CaseController_AFI_ALI" docType="html-5.0">
<head> 
    <meta http-equiv="Pragma" content="no-cache"/>
    <meta http-equiv="Expires" content="-1"/>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />

    <!--  !!! Important !!! Don't forget to call the JQuery library.first -->
    <apex:includeScript value="{!URLFOR($Resource.Jquery, '/jquery-ui-1.10.3.custom/js/jquery-1.9.1.js')}"  />
    <apex:includeScript value="{!URLFOR($Resource.Jquery, '/jquery-ui-1.10.3.custom/js/jquery-ui-1.10.3.custom.min.js')}"  />
    <apex:stylesheet value="{!URLFOR($Resource.Jquery, '/jquery-ui-1.10.3.custom/css/ui-lightness/jquery-ui-1.10.3.custom.css')}"  />
    <apex:includeScript value="{!$Resource.jqueryDataTables}" />
    <apex:includeScript value="{!$Resource.jqueryDataTablesFixedHeader}" /> 
    <apex:stylesheet value="{!$Resource.jqueryDataTablesCSS}" /> 
    <apex:stylesheet value="{!$Resource.jqueryDataTablesFixedHeaderCSS}" /> 
    <apex:includeScript value="{!$Resource.StickyHeader}" />
    
    <script>
        $ = jQuery.noConflict(); 
                      
        $(document).ready(function() {
            stickHeader('contacttable', 'headerClass');
            var contactTable = $('[id$="contacttable"]').DataTable({
                "paging": false,    /*  "pagingType": "full_numbers",   */
                /*  "pageLength": 20,   */
                "bLengthChange": false, 
                "searching": false,
                 fixedHeader: { 
                    header: false,
                    footer: false
                },
                "info": false,
            });
        });
        
        function reInitializeTableSorter() {
            $('[id$="checkboxId"]').attr("checked",false);
            
            var contactTable = $('[id$="contacttable"]').DataTable({
                "paging": false,
                "bLengthChange": false, 
                "searching": false,
                 fixedHeader: { 
                    header: false,
                    footer: false
                },
                "info": false,
            });
        }

        function selectAllCheckboxes(obj,receivedInputID){
            var inputCheckBox = document.getElementsByTagName("input");
            for(var i=0; i<inputCheckBox.length; i++){
                if(inputCheckBox[i].id.indexOf(receivedInputID)!=-1){
                    inputCheckBox[i].checked = obj.checked;
                }
            }
        }
    </script>
      
    <style type="text/css">
        .sorting {
            background: #f2f3f3 url('{! URLFOR($Resource.jQueryDataTablesZip, 'images/sort_both.png') }') no-repeat center right !important;
            padding-right: 20px !important;
        }
        .sorting_asc {
            background: #f2f3f3 url('{! URLFOR($Resource.jQueryDataTablesZip, 'images/sort_asc.png') }') no-repeat center right !important;
            padding-right: 20px !important;
        }
        .sorting_desc {
            background: #f2f3f3 url('{! URLFOR($Resource.jQueryDataTablesZip, 'images/sort_desc.png') }') no-repeat center right !important;
            padding-right: 20px !important;
        }
        table.dataTable tr.odd { 
            background-color: #f2f2d6;
        }
        table.dataTable tr.even {
            background-color: #d6e7f2; 
        }
        
        .unreadClass {
        background-color: #5DADE2;
        }
        .readClass {
        background-color: white;
        }
    </style>
</head>

<body>
<apex:sectionHeader title="Case" subtitle="Email to Case Inbox AFI" />

<apex:form id="formid">
<apex:pageMessages />
<apex:Messages style="color:red; font-weight: bold; font-size: 13pxl"/>
    <apex:pageBlock >   
        <apex:actionFunction action="{!refreshGrid}" name="queryByPage" reRender="myPanel,myButtons" oncomplete="reInitializeTableSorter();">
            <apex:param name="firstParam" assignTo="{!selectedPage}" value="" />
        </apex:actionFunction>
    
        <!------- Upper section (legend & refresh button) --------->
        <apex:pageBlockSection columns="7">
            <apex:outputPanel id="opId" layout="block" style="border-width: 1px; border-style: solid; color:black; line-height:130%; padding-top:5px; padding-bottom:5px; width:450px;">
                <apex:outputLabel value="Legend" style="font-weight: bold; padding-left:10px;" /><br/>
                <div style="width:94%;height:2px; background-color: red !important; margin-left:10px; margin-right:10px; margin-bottom:5px;" ><br /></div>
                <apex:outputLabel style="padding-left:10px;"> 
                    <apex:image url="https://{!host}/servlet/servlet.FileDownload?file=0156F00000CZ6XD" width="20" height="20"/>
                </apex:outputLabel> <apex:outputText style="vertical-align: center;">: Unread ({!IF(countUnread > 2000, '2000++', countUnread)})</apex:outputText>&nbsp;
                <apex:outputLabel style="padding-left:20px;">
                    <apex:image url="https://{!host}/servlet/servlet.FileDownload?file=0156F00000CZ6XB" width="20" height="20"/>
                </apex:outputLabel> <apex:outputText style="vertical-align: center;">: Read ({!IF(countRead > 2000, '2000++', countRead)})</apex:outputText>&nbsp;
                <apex:outputLabel style="padding-left:20px;">
                    <apex:image url="https://{!host}/servlet/servlet.FileDownload?file=0156F00000CZ6XC" width="20" height="20"/>
                </apex:outputLabel> <apex:outputText style="vertical-align: center;">: Replied ({!IF(countReplied > 2000, '2000++', countReplied)})</apex:outputText>
                <apex:outputLabel style="padding-left:20px;">
                    <apex:image url="https://{!host}/servlet/servlet.FileDownload?file=0156F00000CZ6X7" width="20" height="20"/>
                </apex:outputLabel> <apex:outputText style="vertical-align: center;">: Followed Up ({!IF(countFollowedUp > 2000, '2000++', countFollowedUp)})</apex:outputText>
            </apex:outputPanel>
            <apex:outputPanel >
                <apex:commandButton action="{!selectedInbox}" value="Select" style="display: none;"/>
                <apex:commandButton action="{!refreshList}" value="Refresh" style="margin-left:200px; font: normal 11px helvetica, sans-serif;" />&nbsp;
            	<apex:commandButton action="{!unreadEmail}" value="Unread" style="font: normal 11px helvetica, sans-serif;" rendered="{!isSupervisor}"/>
            </apex:outputPanel>
            <apex:outputPanel > </apex:outputPanel> 
            <!-- 
            <apex:selectList value="{!assignedAgent}" id="picklist" label="Agent" size="1" rendered="{!isSupervisor}">
                    <apex:selectOption itemValue="" itemLabel="-" /> 
                   <apex:actionSupport event="onchange" action="{!agentPicklist}" reRender="opId"/> 
                   <apex:selectOptions value="{!agentOptList}"/>
            </apex:selectList>
            <apex:actionFunction name="CallApexMethod" action="{!assignUser}" />
            <apex:commandButton action="{!assignUser}" value="Assign" rendered="{!isSupervisor}" />
             -->
        </apex:pageBlockSection>
        <br/>
        
        <!------- Middle section (inbox dropdown and Agent dropdown) --------->      
        <apex:pageBlockSection columns="3" >
            
            <apex:outputPanel >
                <apex:outputLabel value="Filter By" style="padding-right:10px;"/>
                <apex:selectList value="{!assignedInbox}" id="picklistInbox" size="1" >
                    <apex:selectOption itemValue="" itemLabel="-" /> 
                    <apex:selectOptions value="{!inboxOptList}"/>
                </apex:selectList>              
                <!--input type="button" value="Select" onclick="doSelect();" /-->
                <br/><br/>
                <apex:outputLabel value="Filter By Subject and Body Email" style="padding-right:10px;"/>
                <apex:inputText value="{!searchSubjectandBody}" label="Filter By Subject and Body Email" />
                <br/><br/>
                <apex:outputLabel value="Filter By Policy No" style="padding-right:10px;"/>
                <apex:inputText value="{!searchPolicyNo}" label="Filter By Policy No"/>
                <br/><br/>
                <apex:outputLabel value="Filter By Customer Name" style="padding-right:10px;"/>
                <apex:inputText value="{!searchCustomerName}" label="Filter By Customer Name"/>
                <br/><br/>
                <apex:outputLabel value="Start Date" style="padding-right:10px;"/>
                <apex:input type="datetime-local" value="{!searchStartDate}" label="Start Date"/>
                <br/><br/>
                <apex:outputLabel value="End Date" style="padding-right:10px;"/>
                <apex:input type="datetime-local" value="{!searchEndDate}" label="End Date"/>
                <br/><br/>
                <apex:commandButton action="{!selectedInbox}" value="Select" />
            </apex:outputPanel>
            
            <apex:outputPanel />
            <apex:outputPanel style="margin-left:100px;" rendered="{!isSupervisor}"> 
                <apex:outputLabel value="Agent" style="padding-right:10px;" />      
                <apex:selectList value="{!assignedAgent}" id="picklistAgent" size="1" >
                    <apex:selectOption itemValue="" itemLabel="-" /> 
                    <apex:actionSupport event="onchange" action="{!agentPicklist}" reRender="contacttable"/> 
                    <apex:selectOptions value="{!agentOptList}"/>
                </apex:selectList>
                <apex:commandButton action="{!assignUser}" value="Assign" />
            </apex:outputPanel>
            
            <!--<apex:outputPanel >
                <apex:outputLabel value="Filter By Subject and Body Email" style="padding-right:10px;"/>
                <apex:inputText value="{!searchSubjectandBody}" label="Filter By Subject and Body Email" />
            </apex:outputPanel>
            
            <apex:outputPanel />
            <apex:outputPanel />
            
            <apex:outputPanel >
                <apex:outputLabel value="Filter By Policy No" style="padding-right:10px;"/>
                <apex:inputText value="{!searchPolicyNo}" label="Filter By Policy No"/>
            </apex:outputPanel>
            
            <apex:outputPanel />
            <apex:outputPanel />
            
            <apex:outputPanel >
                <apex:outputLabel value="Filter By Customer Name" style="padding-right:10px;"/>
                <apex:inputText value="{!searchCustomerName}" label="Filter By Customer Name"/>
            </apex:outputPanel>
            
            <apex:outputPanel />
            <apex:outputPanel />
            
            <apex:outputPanel >
                <apex:outputLabel value="Start Date" style="padding-right:10px;"/>
                <apex:input type="datetime-local" value="{!searchStartDate}" label="Start Date"/>
            </apex:outputPanel>
            
            <apex:outputPanel />
            <apex:outputPanel />
            
            <apex:outputPanel >
                <apex:outputLabel value="End Date" style="padding-right:10px;"/>
                <apex:input type="datetime-local" value="{!searchEndDate}" label="End Date"/>
            </apex:outputPanel>
            
            <apex:outputPanel />
            <apex:outputPanel />
            
            <apex:outputPanel >
                <apex:commandButton action="{!selectedInbox}" value="Select" />  
            </apex:outputPanel>-->
        </apex:pageBlockSection>
        <br/>
     
        <!--  Table section -->
        <apex:outputPanel id="myPanel">
            <apex:pageBlockTable id="contacttable" value="{!caseRecords}" var="c" style="table-layout:fixed; width:100%;" columnsWidth="{!colWidth}" align="center" border="1">   
            <!--<apex:pageBlockTable id="contacttable" value="{!caseListWrapper_new}" var="c" style="table-layout:fixed; width:100%;" columnsWidth="{!colWidth}" align="center" border="1">	-->
                <apex:column headerValue="" headerClass="headerClass" rendered="{!isSupervisor}" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                     <apex:facet name="header"><apex:inputCheckbox id="checkboxId" onclick="selectAllCheckboxes(this,'inputId')"/></apex:facet>
                     <apex:inputCheckbox value="{!c.isSelected}" id="inputId"/>
                </apex:column>
                <apex:column headerValue="" headerClass="headerClass" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}"><apex:outputText value="{!c.followUp}" escape="false" /></apex:column>
                <apex:column headerValue="" headerClass="headerClass" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                     <apex:facet name="header">Email<br/>Status</apex:facet>
                     <apex:outputText value="{!c.Indikator}" escape="false" /> 
                </apex:column>
                <apex:column headerValue="" headerClass="headerClass" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                     <apex:facet name="header">Case<br/>Number</apex:facet>
                     <apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.caseNumber}</b>" escape="false" />
                     <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.caseNumber}" escape="false" /> <!--  <a href="/{!c.id}">{!c.caseNumber}</a>    -->
                </apex:column>
                <apex:column headerValue="Sender Email" headerClass="headerClass" style="word-wrap: break-word;" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                	 <apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.senderEmail}</b>" escape="false" />
                     <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.senderEmail}" escape="false" />
                </apex:column>
                <!--<apex:column headerValue="To Address" headerClass="headerClass" style="word-wrap: break-word;">{!c.toAddress}</apex:column>-->
                <apex:column headerValue="Email" headerClass="headerClass" style="word-wrap: break-word;" colspan="2" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                    <table>
                        <tr style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};"><td style="border: 0px" bgcolor="#5DADE2"><b>To Address</b></td><td style="border: 0px" bgcolor="#5DADE2"><b>:</b></td><td style="border: 0px" bgcolor="#5DADE2"><b>{!c.toAddress}</b></td></tr>
                        <tr style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};"><td style="border: 0px">To Address</td><td style="border: 0px">:</td><td style="border: 0px">{!c.toAddress}</td></tr>
                        <tr style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};"><td style="border: 0px" bgcolor="#5DADE2"><b>CC Address</b></td><td style="border: 0px" bgcolor="#5DADE2"><b>:</b></td><td style="border: 0px" bgcolor="#5DADE2"><b></b></td></tr>
                        <tr style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};"><td style="border: 0px">CC Address</td><td style="border: 0px">:</td><td style="border: 0px"></td></tr>
                        <tr style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};"><td style="border: 0px" bgcolor="#5DADE2"><b>BCC Address</b></td><td style="border: 0px" bgcolor="#5DADE2"><b>:</b></td><td style="border: 0px" bgcolor="#5DADE2"><b></b></td></tr>
                        <tr style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};"><td style="border: 0px">BCC Address</td><td style="border: 0px">:</td><td style="border: 0px"></td></tr>
                    </table>
                </apex:column>
                <!--<apex:column headerValue="CC Address" headerClass="headerClass" style="word-wrap: break-word;">{!c.ccAddress} </apex:column>
                <apex:column headerValue="BCC Address" headerClass="headerClass" style="word-wrap: break-word;">{!c.bccAddress} </apex:column>-->
                <apex:column headerValue="Email Date" headerClass="headerClass" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                	 <apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.messageDate}</b>" escape="false" />
                     <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.messageDate}" escape="false" />
                </apex:column>
                <!--  <apex:column headerValue="Email SLA" headerClass="headerClass">{!c.messageSlaDate}</apex:column>  -->
                <!-- 9 Januari 2020 -->
                <!--<apex:column headerValue="Customer Name" headerClass="headerClass" style="word-wrap: break-word;">{!c.customerName}</apex:column>-->
                
                <apex:column headerValue="" headerClass="headerClass" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                	<apex:facet name="header">Customer<br/>Name</apex:facet>
                    <apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.customerName}</b>" escape="false" />
                    <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.customerName}" escape="false" />
                </apex:column>
            	<!-- END -9 Januari 2020 -->
                <!--  <apex:column headerValue="Status" headerClass="headerClass">{!c.status}</apex:column>	-->
                <apex:column headerValue="Subject" headerClass="headerClass" style="word-wrap: break-word;" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                	<apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.subject}</b>" escape="false" />
                    <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.subject}" escape="false" />
                </apex:column>
                <apex:column headerValue="Message" headerClass="headerClass" style="word-wrap: break-word;" colspan="2" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}"> <!--<span title="{!c.Description}"> {!c.subDescription} </span> -->
                    <apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.Description}</b>" escape="false" />
                    <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.Description}" escape="false" />
                </apex:column> 
                <apex:column headerValue="Assignee" headerClass="headerClass" style="word-wrap: break-word;" rendered="{!isSupervisor}" styleClass="{!IF(c.emailStatus == 'Unread','unreadClass','readClass')}">
                	<apex:outputText style="display: {!IF(c.emailStatus == 'Unread', '', 'none')};" value="<b>{!c.assignedTo}</b>" escape="false" />
                    <apex:outputText style="display: {!IF(c.emailStatus != 'Unread', '', 'none')};" value="{!c.assignedTo}" escape="false" />
                </apex:column>
            </apex:pageBlockTable>
            <apex:outputText style="margin-right:360px; letter-spacing:1.3px;" value="Showing {!(pageNumber * size)+1-size} to {!IF((pageNumber * size)>noOfRecords, noOfRecords, (pageNumber * size))} of {!noOfRecords}" />    
        </apex:outputPanel>
        
        <!--  pagination -->
        <apex:dynamicComponent componentValue="{!pagingButtons}" id="pagingBtn" />
        <!--apex:actionFunction name="doSelect" action="{!selectedInbox}" rerender="contacttable"/-->
    </apex:pageBlock>
</apex:form>
</body>

</apex:page>