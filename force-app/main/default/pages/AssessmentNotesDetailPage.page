    <script type="text/javascript">
        var assessmentNotesDetailPaging = {};
        var paymentHistoryGIPaging = {};
        
        var pagerAssNotesDetail = new Imtech.Pager();
        var pagerPHGI = new Imtech.Pager();
        
        var numberOfRecords = 100;
        
        
        $(document).ready(function() {
            initPage();
            
            pagerAssNotesDetail.datasetname = 'AssessmentNotesDetail';
            pagerAssNotesDetail.pagername='pagerAssNotesDetail';
            pagerAssNotesDetail.pagingControlsContainer = $('#pagingControlAssessmentNotesDetail');
            pagerAssNotesDetail.pagingInfoContainer = $('#loadInfoAssessmentNotesDetail');
            pagerAssNotesDetail.numberOfRecords=100;
            //pager.paragraphsPerPage = 5; // set amount elements per page
            pagerAssNotesDetail.pagingContainer = $('#content'); // set of main container
            pagerAssNotesDetail.paragraphs = $('div.z', pagerAssNotesDetail.pagingContainer); // set of required containers
            if ({!isDisplayAFI_AMFS}) { pagerAssNotesDetail.showPage(1); }
            
            
        });
        
        $(document).ready(function() {
            //initPage();
        });
    </script>
    
    <script type="text/javascript">
        function getUrlVars(){
           var vars = [], hash;
           var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
           for(var i = 0; i < hashes.length; i++)
           {
               hash = hashes[i].split('=');
               vars.push(hash[0]);
               vars[hash[0]] = hash[1];
           }
           return vars;
        }
    </script>

    <script type="text/javascript">
        var policyNo ='';
        var entity =''; 
        var policyApp ='';
        var contactID ='';
        var classType ='';
        var refNo = '';
        
        function initPage () {
            var sessionId = getUrlVars()["sessionId"];
                
            var queryStr = window.location.search; 
            console.log('queryStr : ' + queryStr);
            var paramPairs = queryStr.substr(1).split('&');
            
            var params = {};
            for (var i = 0; i < paramPairs.length; i++) {
                var parts = paramPairs[i].split('=');
                params[parts[0]] = parts[1];
                //alert(parts[0] +' - '+ parts[1]);
            }
            
            policyNo = params['policyNo'];
            entity = params['entity'];
            policyApp = params['policyApp'];
            contactID = params['contactID'];
            classType = params['classType'];
            refNo = params['refNo'];
            
            console.log ('policyNo :' + policyNo);
            console.log ('entity :' + entity);
            console.log ('policyApp :' + policyApp);
            console.log ('contactID :' + contactID);
            
        }
    
        var dataUsed=null;
        
        function loadDataPagingAssessmentNotesDetail(policyNo, entity, policyApp, startDateTime, endDateTime, 
                rowPerPage, startOfRecords, numberOfRecords,  pageNumber, show, extra ){                    
                    console.log(policyNo + '-' + entity + '-' + policyApp + '-' + startDateTime + '-' + endDateTime + '-' + rowPerPage + '-' + startOfRecords + '-' + numberOfRecords + '-' +  pageNumber);
                    var assessmentNotesDetailHolderObj = document.getElementById('{!$Component.formid.blockid.assessmentNotesDetailHolder}');
                    
                    var start_time =null;
                    var end_time =null;
                    var duration =null;
                    
                    if (assessmentNotesDetailPaging[pageNumber] !=null || assessmentNotesDetailPaging[pageNumber] != undefined) {
                        if (show == 1) {
                            start_time = performance.now();//new Date().getTime(); 
                            displayLoading('loadingimgAssessmentNotesDetail');
                    
                            assessmentNotesDetailHolderObj.value = assessmentNotesDetailPaging[pageNumber];
                            //console.log('jadi:' + assessmentNotesDetailPaging[pageNumber]); 
                            refreshAssessmentNotesDetail(); refreshPageMessages();
                            hideLoading('loadingimgAssessmentNotesDetail');
                            end_time = performance.now();//new Date().getTime();
                            duration = end_time - start_time;
                            duration = duration.toFixed(3);
                            pagerAssNotesDetail.renderInfo('Load duration : ' + duration + ' milliseconds');
                            console.log('duration   : ' + duration);
                            
                        }
                        // lazy loading for next page ::
                        var nextPageNumber= pageNumber +1;
                        if (extra >0 && (assessmentNotesDetailPaging[nextPageNumber] ==null || assessmentNotesDetailPaging[nextPageNumber] == undefined)) {
                            extra=extra-1;
                            startOfRecords = (numberOfRecords * nextPageNumber) + 1;                                        
                            loadDataPagingAssessmentNotesDetail(policyNo, entity, policyApp, '', '', 0, startOfRecords, numberOfRecords,  nextPageNumber, 0, extra) ;
                        }
                               
                    } else {
                        //alert ('getRemoteDataAssessmentNotesDetail, extra: ' + extra + ', show : ' + show);
                        if (show == 1) {displayLoading('loadingimgAssessmentNotesDetail');}
                        start_time = performance.now(); //new Date().getTime(); 
                        Visualforce.remoting.Manager.invokeAction(
                            // param : 
                            //  public static string getRemoteDataAssessmentNotes 
                            // (String policyNo, String entity,  String policyApp, string operation, string classType, string refNo,
                            // String startDateTime, String endDateTime, Integer rowPerPage, Integer startOfRecords, Integer numberOfRecords,  Integer pageNumber) {

                            
                            '{!$RemoteAction.RemoteDataController.getRemoteDataAssessmentNotes}',
                                policyNo, entity,  policyApp, 'Detail', classType, refNo,
                                startDateTime, endDateTime, rowPerPage, startOfRecords, numberOfRecords,  pageNumber,
                            function (result, event){
                                if (event.status) {                     
                                    assessmentNotesDetailPaging[pageNumber] = result;
                                    // console.log ('SET Value of assessmentNotesDetailPaging['+pageNumber+'] : '+assessmentNotesDetailPaging[pageNumber]); 
                                    assessmentNotesDetailHolderObj.value = result;
                                    
                                    if (show == 1) { 
                                        refreshAssessmentNotesDetail(); refreshPageMessages();
                                        hideLoading('loadingimgAssessmentNotesDetail'); 
                                    }
                                    end_time = performance.now(); //new Date().getTime();
                                    duration = end_time - start_time;
                                    duration = duration.toFixed(3);
                                    
                                    if (show == 1) {
                                        pagerAssNotesDetail.renderInfo('Load duration : ' + duration + ' milliseconds');
                                        console.log('duration   : ' + duration);    
                                    }
                                    
                                    // lazy loading for next page ::
                                    var nextPageNumber= pageNumber +1;
                                    if (extra >0 && (assessmentNotesDetailPaging[nextPageNumber] ==null || assessmentNotesDetailPaging[nextPageNumber] == undefined)) {
                                        extra=extra-1;
                                        startOfRecords = (numberOfRecords * nextPageNumber) + 1;                                        
                                        loadDataPagingAssessmentNotesDetail(policyNo, entity, policyApp, '', '', 0, startOfRecords, numberOfRecords,  nextPageNumber, 0, extra) ;
                                    } 
                                }
                            }, {escape: true}
                        );    
                    
                   }              
               }
                 
    </script>
    

    <!-- .End of Java Script -->
    
    <body> 
