                    <apex:pageBlockSection columns="1" >
                        <!-- 
                        <apex:pageBlockSectionItem ><div id="pagingControlAssessmentNotesDetail">paging </div></apex:pageBlockSectionItem>
                        <apex:pageBlockSectionItem ><img id="loadingimgAssessmentNotesDetail" style="display:none" src="/img/loading.gif" /></apex:pageBlockSectionItem>   
                         -->
