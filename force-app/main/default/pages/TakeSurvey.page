    <style>
        .my-button {
         /* Default styles for the button */
         background-color: red;
         color: white;
         padding: 10px 20px;
         text-align: center;
         text-decoration: none;
         display: inline-block;
         font-size: 70px;
         border-radius: 4px;
         border: none;
      }
      
      @media screen and (max-width: 768px) {
         /* Styles for screens smaller than 768px (mobile devices) */
         .my-button {
            padding: 8px 16px;
