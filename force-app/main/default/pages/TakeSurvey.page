                    <apex:commandButton action="{!submitResults}" value="{!$Label.LABS_SF_SubmitSurvey}" rerender="theForm,seeSurvey,errorMsg" styleClass="slds-button slds-button_brand slds-size_1-of-2" status="spinnerStatus" />
                </div>
                <BR />
            </apex:outputPanel>
            
            <!-- THANK YOU PAGE -->
            <apex:outputPanel rendered="{!thankYouRendered == true}">
                <apex:outputText value="{!surveyThankYouText}"  escape="false"  />
            </apex:outputPanel>
        </apex:form>
    </div>
</apex:page>