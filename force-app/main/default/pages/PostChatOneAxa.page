        <div class="flex justify">
           <!-- <div class="center c50">
           <a href="javascript:saveTextAsFile();" class="button lg">Unduh Transkrip Obrolan</a>
          </div>
          <div id="postchat-intentional-right" class="center c50">
            <a href="javascript:gotoHelpCenter();" class="button lg">Survei</a>
          </div> --> 
          <div id="postchat-unintentional-right" class="center c50" style="display: none">
            <a href="javascript:gotoChatAgain();" class="button lg">Start Chat</a>
          </div>
        </div>
      </div>

    </div>

    <div style="display: none;">
        <textarea id="chat-transcript">{!$CurrentPage.parameters.transcript}</textarea>
    </div>


    <script type='text/javascript'>
        var requestTime = '{!$CurrentPage.parameters.requestTime}';
        var startTime = '{!$CurrentPage.parameters.startTime}';
        var disconnectedBy = '{!$CurrentPage.parameters.disconnectedBy}';

        if (disconnectedBy == "client" || disconnectedBy == "agent") {
            document.getElementById('postchat-intentional-img').style.display = 'block';
            document.getElementById('postchat-unintentional-img').style.display = 'none';
            document.getElementById('postchat-intentional-text').style.display = 'block';
            document.getElementById('postchat-unintentional-text').style.display = 'none';
            document.getElementById('postchat-intentional-right').style.display = 'block';
            document.getElementById('postchat-unintentional-right').style.display = 'none';
        } else {
            document.getElementById('postchat-intentional-img').style.display = 'none';
            document.getElementById('postchat-unintentional-img').style.display = 'block';
            document.getElementById('postchat-intentional-text').style.display = 'none';
            document.getElementById('postchat-unintentional-text').style.display = 'block';
            document.getElementById('postchat-intentional-right').style.display = 'none';
            document.getElementById('postchat-unintentional-right').style.display = 'block';
        }
    </script>

