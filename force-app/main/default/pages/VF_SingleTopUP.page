                    <td style="width: 20%;">{!code1}</td>
                    <td style="width: 60%;">{!subdana1}</td>
                    <td style="width: 20%;">{!percentage1}</td>
                </tr>
                <tr style="background-color: #a1bce2;  color:black">
                    <td style="width: 20%;">{!code2}</td>
                    <td style="width: 60%;">{!subdana2}</td>
                    <td style="width: 20%;">{!percentage2}</td>
                </tr>
                <tr style="background-color: #a1bce2;  color:black">
                    <td style="width: 20%;">{!code3}</td>
                    <td style="width: 60%;">{!subdana3}</td>
                    <td style="width: 20%;">{!percentage3}</td>
                </tr>
                <tr style="background-color: #a1bce2;  color:black">
