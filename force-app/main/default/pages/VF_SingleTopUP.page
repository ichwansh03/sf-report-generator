                    <td style="width: 60%;">{!subdana4}</td>
                    <td style="width: 20%;">{!percentage4}</td>
                </tr> -->
            </table>
        </div>
        <br/>
        <div>
            <table class="standard-table" border="1px solid">
                <tr class="header">
                    <td style="background-color: #739bd2; text-align: center; color:white">
                        Informasi Pelaporan Pajak Luar Negeri
                    </td>
                </tr>
            </table>
            <table style="border: 1px solid black; width: 100%; font-family: Arial, sans-serif; font-size: 12px">
                <tr>
                    <td style="width: 55%;">Apakah Anda Melakukan Pelaporan Pajak di Luar Negara Indonesia?</td>
                    <td style="width: 45%; text-align: right;">{!pajak}</td>
                </tr>
            </table>
            
        </div>

        
         
        <br/>
        <div style="page-break:always;">
            <table class="standard-table" border="1px solid">
                <tr class="header">
                    <td style="background-color: #739bd2; text-align: center; color:white">
                        Kelengkapan Dokumen
                    </td>
                </tr>
            </table>
           <table style="border: 1px solid black; width: 100%; font-family: Arial, sans-serif; font-size: 12px">
