<apex:page renderAs="PDF" showHeader="false" applyHtmlTag="false" applyBodyTag="false" standardController="E_Form_Master_Data__c" extensions="AMFS_SingleTopUp_Controller">
    <html>
        <head>
            <style type="text/css">
                @page {
                margin-top: 0.1%;
                margin-bottom: 0;
                margin-left: 0;
                margin-right: 0;
                size: A4 portrait;
                page-break:always; 
                page-break-inside:avoid;
                letter-spacing: 5px;
                
                @top-left {
                content: element(header);                
                }
                
                @bottom-left {
                content: element(footer);
                }
                }
                
                div.header {
                padding: 0px;
                position: running(header);
                font-family:sans-serif !important;
                }
                
                div.footer {
                display: block;
                padding: 5px;
                position: running(footer);
                font-family: Arial, sans-serif;
                font-size: 12px;
                }
                
                .pagefooter:before{
                content: "Page : " counter(page) "/" counter(pages);
                font-family: Arial, sans-serif;
                font-size: 12px;
                }
                
                .pagenumber:before {
                content: counter(page);
                }
                .pagecount:before {
                content: counter(pages);
                }
                div.content{
                width:100%;
                font-family:sans-serif !important;
                }
                .grid, .grid th, .grid td{
                border: 1px solid;
                border-collapse: collapse;
                padding:3px;
                }
                .grid th{
                background-color:#E8E8E8;
                }
                .center{
                text-align: center;
                }
                .right{
                text-align: right;
                }
                .left{
                text-align: left;
                }
                .top{
                vertical-align:top;
                }
                .uppercase{
                text-transform: uppercase;
                }
                .justify{
                text-align: justify;
                }
                .tdHeader{
                width: 70%; 
                height: 15px;
                font-size:8px;
                text-align: justify;
                
                }
                .table-wrapper {
                    border: 2px solid black;
                    display: inline-block; /* Ensures the border wraps the table */
                    padding: 0px; /* Prevents extra spacing */
                }

                /* Standard table styling */
                table.custom-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: Arial, sans-serif;
                    font-size: 11px;
                }
                .standard-table{
                    width: 100%;
                    border-collapse: collapse;
                    font-family: Arial, sans-serif;
                    font-size: 12px;
                    padding: 1px;
                    vertical-align: middle;
                }
                
                .label-col {
                    width: 30%;
                    text-align: left;
                }


                .separator-col {
                    text-align: center;
                    padding-left: 0; /* jarak 3px ke kolom berikutnya */
                }

                .value-col {
                    text-align: left;
                }

                .subject{
                    width: 30%;
                    height: 30px;
                }
                .value{
                    width: 70%;
                    height: 30px;
                }

                .header{
                    height: 25px;
                    font-family: Arial, sans-serif;
                    font-size: 14px;
                }


                p {
                    margin-top: 0;
                    margin-bottom: 10px;
                }

                


            </style>
        </head>

        <!-- FOOTER-->
