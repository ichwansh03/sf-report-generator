                    <td class="value">: {!paymentMethod}</td>
                </tr>
            </table>
        </div>

        <br/>
        
        <div>
            <table class="standard-table" border="1px solid">
                <tr class="header">
                    <td style="background-color: #739bd2; text-align: center; color:white">
                        Alokasi Top Up Tunggal
                    </td>
                </tr>
            </table>
            <br/>
            <table class="standard-table" border="4px solid #07326e">
