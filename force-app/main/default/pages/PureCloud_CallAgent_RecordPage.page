                <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!detail.data.API_CHeck_API3_Date_c}" /> </apex:outputText>
            </apex:pageBlockSectionItem>
            <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>
            <apex:pageBlockSectionItem >
                <apex:outputLabel value="API CHeck API3 Status"></apex:outputLabel>
                <apex:outputText value="{!detail.data.API_CHeck_API3_Status_c}"/>
            </apex:pageBlockSectionItem>
            <apex:pageBlockSectionItem >
                <apex:outputLabel value="Created By"></apex:outputLabel>
                <apex:outputLabel >
                    <apex:outputLink value="/{!detail.data.CreatedById}" target="_blank">{!detail.data.CreatedByName}</apex:outputLink>,&nbsp;
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!detail.data.CreatedDate}" /> </apex:outputText>
                </apex:outputLabel> 
            </apex:pageBlockSectionItem>
            <apex:pageBlockSectionItem >
                <apex:outputLabel value="Last Modified By"></apex:outputLabel>
                <apex:outputLabel >
                    <apex:outputLink value="/{!detail.data.LastModifiedById}" target="_blank">{!detail.data.LastModifiedByName}</apex:outputLink>,&nbsp;
                    <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!detail.data.LastModifiedDate}" /> </apex:outputText>
                </apex:outputLabel> 
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
    </apex:pageBlock>   
    <apex:pageblock id="openActivity" title="Open Activity" tabStyle="purecloud__c">  
        <apex:pageBlockTable value="{!listOpenTask}"  var="lot">
            <apex:column headerValue="Subject"><apex:outputLink value="/apex/Task_recorddetailpage?id={!lot.id}" target="_blank">{!lot.subject}</apex:outputLink> </apex:column>
            <apex:column headerValue="Name" value="{!lot.what_name}"/>
            <apex:column headerValue="Task" style="text-align:center"><img src="/img/checkbox_{!IF(!lot.isClosed, 'un', '')}checked.gif"/></apex:column>
                <apex:column headerValue="Due Date"><apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!lot.ActivityDate}" /> </apex:outputText></apex:column>   
            <apex:column headerValue="Status" value="{!lot.status}"/>
            <apex:column headerValue="Priority" value="{!lot.Priority}"/>
                <apex:column headerValue="Assigned To"><apex:outputLink value="/{!lot.ownerId}" target="_blank">{!lot.owner_name}</apex:outputLink> </apex:column>  
        </apex:pageBlockTable>  
    </apex:pageblock> 
    <apex:pageblock id="History" title="Activity History" tabStyle="purecloud__c">  
        <apex:pageBlockTable value="{!listHistoryTask}"  var="lht"> 
               <apex:column headerValue="Subject"><apex:outputLink value="/apex/Task_recorddetailpage?id={!lht.id}" target="_blank">{!lht.subject}</apex:outputLink> </apex:column>
               <apex:column headerValue="Name" value="{!lht.what_name}"/>
               <apex:column headerValue="Task" style="text-align:center"><img src="/img/checkbox_{!IF(!lht.isClosed, 'un', '')}checked.gif"/></apex:column>
                <apex:column headerValue="Due Date"><apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!lht.ActivityDate}" /> </apex:outputText></apex:column>   
                <apex:column headerValue="Assigned To"><apex:outputLink value="/{!lht.ownerId}" target="_blank">{!lht.owner_name}</apex:outputLink> </apex:column> 
                <apex:column headerValue="Last Modified Date/Time"><apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!lht.lastModifiedDate}" /> </apex:outputText></apex:column>  
        </apex:pageBlockTable>  
    </apex:pageblock>  
</apex:page>