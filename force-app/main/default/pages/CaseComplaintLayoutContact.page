        <script>
        console.log('{!entity}');
        console.log('{!retURL}');
        
        function doCancel(){
            if (sforce.console.isInConsole()) { 
                closeTab(); 
            }else { 
                window.location.href = "https://cs6.salesforce.com{!retURL}"; 
            }     
        }
        function addSelectedValue(selval){
            var selectedKeeperObj = document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.selectedCaseTypeKeeper}');
            var selectedKeeperVal = selectedKeeperObj.value+selval+"<br />";
            selectedKeeperObj.value = selectedKeeperVal;
        }
        function deleteSelectedValue(remval){
            var selectedKeeperObj = document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.selectedCaseTypeKeeper}');
            var selectedKeeperVal = selectedKeeperObj.value;
            selectedKeeperObj.value = selectedKeeperVal.replace(remval+"<br />", "");
        }
        function closeTab() {
            //First find the ID of the current tab to close it
            sforce.console.getEnclosingTabId(closeSubtab);
        }
        var closeSubtab = function closeSubtab(result) {
            var tabId = result.id;
            sforce.console.closeTab(tabId);
        };
        function decodeHTMLEntities(text) {
            var entities = [
                ['apos', '\''],
                ['amp', '&'],
                ['lt', '<'],
                ['gt', '>']
            ];
            
            for (var i = 0, max = entities.length; i < max; ++i) 
                text = text.replace(new RegExp('&'+entities[i][0]+';', 'g'), entities[i][1]);
            
            return text;
        }
        
        function setNatureConfigHidden(){

            var key = "window.pl.vals_{!NatureConfigFieldId}_{!cs.recordTypeId}";
            key = key.length > 46 ? key.substr(0,46):key;
            var natureCatConf = eval(key);
          }
        
        function setCaseTypeHidden(){
            var natureCat = document.getElementById('{!$Component.myForm.pgBlock.pgBlockcomplaintDetail.nature}');
            var casetypeObj = document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.casetype}');
            var key = "window.pl.vals_{!caseTypeFieldId}_{!cs.recordTypeId}";
            key = key.length > 46 ? key.substr(0,46):key;
            var casetype = eval(key);
            var caseTypesObj = document.getElementById('caseTypes');
            var selectedCTObj = document.getElementById('selectedCT');
            caseTypesObj.options.length=0;
            var val = "";
            for(var j=0; j<casetype.length; j++){
                if(j%2==0){
                    val = decodeHTMLEntities(casetype[j]);
                    caseTypesObj.options[caseTypesObj.options.length]=new Option(val, val, false, false);
                }
            }
            if('{!firstLoad}'=='new'){
                document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.firstLoad}').value = 'edit';
                document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.selectedCaseTypeKeeper}').value = "";
                caseTypesObj.style.display = "block"; 
                selectedCTObj.style.display = "none";
            }else if('{!firstLoad}'=='save'){
                caseTypesObj.style.display = "none"; 
                selectedCTObj.style.display = "block"; 
                var csk = "{!selectedCaseTypeKeeper}".split('<br />');
                
                var vl = "";
                for(var ii=0; ii<csk.length; ii++){
                    vl = vl+csk[ii]+'\n';
                }
                selectedCTObj.innerHTML = vl ;
                selectedCTObj.disabled = 'disabled';
            }
        }
        window.onload=setCaseTypeHidden;  
        
        var formCaseType = document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.pbItemType.caseType}');
        if (formCaseType != null && formCaseType != '') {
            formCaseType.disabled = 'disabled';
        }
        
        var formRequestStatus = document.getElementById('{!$Component.myForm.pgBlock.pgBlockSection.pbItemRequest.requestStatus}');
        if (formRequestStatus != null && formRequestStatus  != '') {
        	formRequestStatus.disabled = 'disabled';           
        }
        
        var formDueDate = document.getElementById('{!$Component.myForm.pgBlock.pgBlockcomplaintDetail.pbItemDueDate.dueDate}');
        if (formDueDate != null && formDueDate != '') {
        	formDueDate.disabled = 'disabled';  
        }
        
        // added by Ranti at 11/11/2021
        // by call line, form channel, customer, compalint, and piority disabled
        if ('{!callLineId}' != null && '{!callLineId}' != '' && '{!entity}' == 'AMFS') { 
            document.getElementById('j_id0:myForm:pgBlock:pgBlockcomplaintDetail:j_id86:Channel').disabled = 'disabled';  
            document.getElementById('j_id0:myForm:pgBlock:pgBlockcomplaintDetail:j_id69:customer').disabled = 'disabled';  
            document.getElementById('j_id0:myForm:pgBlock:pgBlockcomplaintDetail:j_id83:Complainant').disabled = 'disabled';  
            document.getElementById('j_id0:myForm:pgBlock:pgBlockcomplaintDetail:j_id96:priority').disabled = 'disabled';   
        }  
        </script>
