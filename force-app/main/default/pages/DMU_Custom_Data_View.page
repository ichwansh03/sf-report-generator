                        <apex:selectOptions value="{!listOfRangeDateType}" />
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Start Date" for="StartDate" />
                    <apex:inputField value="{!filterdata.Filter_StartDate__c}"/>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="End Date" for="EndDate" />
                    <apex:inputField value="{!filterdata.Filter_EndDate__c}"/>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Type" />
                    <apex:inputField id="Type" value="{!filterdata.Type_Doc__c}">
                        <apex:actionSupport event="onchange" action="{!hideData}" reRender="theTableSummary" status="ajaxStatus"/>
                    </apex:inputField>
                </apex:pageBlockSectionItem>
                
            </apex:pageBlockSection>
            
            <!-- polis hardcopy -->
            <apex:pageBlockSection id="dat01" title="polis hardcopy" collapsible="true" columns="10" rendered="{!ShowData01}">
                <apex:pageBlockTable id="iddata" value="{!phDMUList}" var="dat" style="overflow:auto;width:1000px;" align="center" border="1">
                    <apex:column headerValue="ID">{!dat.DateText}</apex:column>
                    <apex:column headerValue="Type Doc">{!dat.Type_Doc}</apex:column>
                    <!--<apex:column headerValue="OK">{!dat.OK}</apex:column>
                    <apex:column headerValue="Return Docs">{!dat.Return_Docs}</apex:column>-->
                    <apex:column headerValue="Total Documents">{!dat.Total_Documents}</apex:column>
                    <apex:column headerValue="Success">{!dat.Success}</apex:column>
                    <apex:column headerValue="Not Success">{!dat.Not_Success}</apex:column>
                    <apex:column headerValue="In Progess">{!dat.InProgress}</apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>
            
