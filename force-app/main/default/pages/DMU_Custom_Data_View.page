<apex:page controller="DMU_Custom_Data_View_Controller" >
    <style>
        .requiredLoaderBG {
        background-color: rgb(71,71,71);
        opacity:0.7;
        filter:alpha(opacity=70);
        background-image:url('{!$Resource.ajaxLoadGif}');
        background-position: center center;
        background-repeat: no-repeat;
        height: 100%;
        left: 0;
        position: fixed;
        text-align: center;
        top: 0;
        width: 100%;
        z-index: 1;
        }
        
        #el_loading
        {
        display: none;
        }
    </style>
    
	<apex:form >
        <apex:actionstatus startStyleClass="requiredLoaderBG" id="ajaxStatus" />
        <apex:pageMessages id="pagemessage"/>
        
		<apex:pageBlock title="Button">
 
			<apex:pageBlockButtons id="pagebutton">                
				<apex:commandbutton value="Clear Filter" action="{!reset}" rendered="{!IF(lockPage==false,true,false)}" reRender="theTable, theTableDetail, theTableSummary" status="ajaxStatus"/>
				<apex:commandButton value="Get Data" styleClass="btnGeneral" action="{!typeControl}" reRender="theTable, data01,data02,data03,data04,data05,data06,data07,data08,data09,data10,data11,dat01,dat02,dat03,dat04,dat05,dat06,dat07,dat08,dat09,dat10,dat11,pagemessage,data11D,pagebutton" status="ajaxStatus"/>
				<apex:commandbutton value="Export" action="{!exportAll}"/>
			</apex:pageBlockButtons>
            <apex:pageBlockSection title="Parameter Filter 1" columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Data Type" for="DataType" />
                    <apex:selectList id="DataType" value="{!DataType}" size="1" disabled="{!lockPage}" >
                        <apex:selectOptions value="{!listOfDataType}" />
                        <apex:actionSupport event="onchange" action="{!typeControl}" reRender="theTableSummary, theTableDetail" status="ajaxStatus"/>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>

		<apex:outputPanel id="theTableSummary">
		<apex:pageBlock title="Data" rendered="{!IF(DataType == 'Summary',TRUE,FALSE)}">
