                    <apex:column headerValue="no polis">{!ph.policy_no}</apex:column>
                    <apex:column headerValue="Policy Holder Name">{!ph.Consignee}</apex:column>
                    <!-- apex:column headerValue="Tgl pick up" -->
                        <!-- apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!ph.TglPickUp}" /></apex:outputText>
                    <!-- /apex:column -->
                    <apex:column headerValue="Tgl pick up">{!ph.TglPickUp}</apex:column>

                    <apex:column headerValue="Status">{!ph.Status}</apex:column>
                    <apex:column headerValue="Nama Penerima/hubungan">{!ph.NamaPenerima}</apex:column>
                    <!-- apex:column headerValue="Tgl Terima">
                        <apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!ph.TglTerima}" /></apex:outputText>
                    </apex:column -->
                    <apex:column headerValue="Tgl Terima">{!ph.TglTerima}</apex:column>

                    <!-- apex:column headerValue="Tgl retur">
                        <apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!ph.TglRetur}" /></apex:outputText>
                    </apex:column -->
                    <apex:column headerValue="Tgl retur">{!ph.TglRetur}</apex:column>

                    <apex:column headerValue="Keterangan retur">{!ph.KeteranganRetur}</apex:column>
                    <apex:column headerValue="Kurir">{!ph.Kurir}</apex:column>
                    <apex:column headerValue="No. Resi">{!ph.Resi}</apex:column>
                    <apex:column headerValue="Alamat">{!ph.Alamat}</apex:column>
                    <apex:column headerValue="Note">{!ph.Note}</apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection> 

