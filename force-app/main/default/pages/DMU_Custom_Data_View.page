		<apex:outputPanel id="theTableDetail">
		<apex:pageBlock title="Data" rendered="{!IF(DataType == 'Detail',TRUE,FALSE)}">
            <apex:pageBlockSection title="Parameter Filter 2" columns="2">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Start Date" for="StartDate" />
                    <apex:inputField value="{!filterdata.Filter_StartDate__c}"/>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="End Date" for="EndDate" />
                    <apex:inputField value="{!filterdata.Filter_EndDate__c}"/>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem rendered="{!IF(lockPage==false,true,false)}">
                    <apex:outputLabel value="Policy Owner" for="contactName" />
                    <apex:inputField id="contactName" value="{!cLookup.Contact__c}">
                    <apex:actionSupport event="onchange" action="{!storeContactId}" reRender="debug,terms,suggest,sfdcOrderId,policyNo,policyApp,btnPayment,email,PolicyEntity,PolicyMobilePhone"/>
                    </apex:inputField>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem rendered="{!lockPage}">
                    <apex:outputLabel value="Policy Owner" for="contactName-readonly" />
                    <apex:outputField id="contactName-readonly" value="{!cLookup.Contact__c}" />
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Policy No" />
                    <apex:outputText id="policyNo" value="{!contactPolicyNo}"/>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Policy App" />
                    <apex:outputText id="policyApp" value="{!contactPolicyApp}"/>
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Entity" />
                    <apex:outputText id="PolicyEntity" value="{!contactEntity}"/>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Type" />
                    <apex:inputField id="Type" value="{!filterdata.Type_Doc__c}">
						<apex:actionSupport event="onchange" action="{!getdataDetail}" reRender="theTableDetail" status="ajaxStatus"/>
                    </apex:inputField>
                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem rendered="FALSE">
                    <apex:outputLabel value="Status" />
                    <apex:inputField id="Status" value="{!filterdata.Filter_Status__c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>

            <!-- polis hardcopy -->
            <apex:pageBlockSection id="data01" title="polis hardcopy" collapsible="true" columns="12" rendered="{!ShowData01}">
