<apex:page standardController="Case" extensions="EmailMessageHistoryController" docType="html-5.0" standardStylesheets="false" renderAs="PDF" showHeader="false" applyHtmlTag="false" applyBodyTag="false" sidebar="false" tabStyle="Case">
    <html xmlns="http://www.w3.org/1999/xhtml">
        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
            <style type="text/css">
                @page {
                margin-top: 5cm;
                margin-bottom: 2cm;
                margin-left: 1cm;
                margin-right: 1cm;
                size: A4 portrait;
                page-break:always; page-break-inside:avoid;
                
                
                @top-center {
                content: element(header);
                }
                
                @bottom-left {
                font-size: 11px;
                content: element(footer);
                content: "Page " counter(page) " of " counter(pages);
                }
                }
                br {
                margin: 0px;
                }
                
                div.header {
                padding: 0px;
                position: running(header);
                }
                div.footer {
                display: block;
                padding: 0px;
                position: running(footer);
                font-size: 11px;
                }
                .pagenumber:before {
                content: counter(page);
                }
                .pagecount:before {
                content: counter(pages);
                }
                div.content {
                border-style:none;
                float: right;
                width: 100%;
                }
                
                
                .datagrid table { border-collapse: collapse; width: 100%; }
                .datagrid table td, .datagrid table th { padding: 3px 4px; }
                .datagrid table thead th {
                font-size: 10px; 
                font-weight: normal;
                border-bottom: 2px solid #000000;
                border-top: 2px solid #000000;
                } 
                .datagrid table tbody td { color: #000000; font-size: 11px;font-weight: normal; }
                .datagrid table tbody tr:last-child td { border-bottom: 2px solid #000000; }
                
                hr { 
                position: relative;
                border: none; 
                height: 2px; 
                background: black;
                }
            </style>
        </head>
        
        <div class="header">
            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; font-size: 11px">
                <tbody>
                    <tr>
                        <td>&nbsp;&nbsp;&nbsp;<apex:image value="{!$Resource.LogoAXA}" width="55%"></apex:image></td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td width="15%" style="font-size: 12px">&nbsp;&nbsp;&nbsp;From Address</td>
                        <td width="1%" style="font-size: 12px">&nbsp;&nbsp;:</td>
                        <td width="84%" style="font-size: 12px">&nbsp;<apex:outputField value="{!eMessage.FromAddress}"/></td>
                    </tr>
                    <tr>
                        <td width="15%" style="font-size: 12px">&nbsp;&nbsp;&nbsp;To Address</td>
                        <td width="1%" style="font-size: 12px">&nbsp;&nbsp;:</td>
                        <td width="84%" style="font-size: 12px">&nbsp;<apex:outputField value="{!eMessage.ToAddress}"/></td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td width="15%" style="font-size: 12px">&nbsp;&nbsp;&nbsp;Subject</td>
                        <td width="1%" style="font-size: 12px">&nbsp;&nbsp;:</td>
                        <td width="84%" style="font-size: 12px">&nbsp;<b><apex:outputField value="{!eMessage.Subject}"/></b></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="content">
            <body>
                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; font-size: 11px">
                    <tbody>
                        <tr>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td width="15%" style="font-size: 12px" align="left" valign="top">Email Conversion</td>
                            <td width="1%" style="font-size: 12px" align="left" valign="top">:</td>
                            <td width="84%" style="font-size: 12px"><apex:outputField value="{!eMessage.TextBody}"/></td>
                        </tr>
                    </tbody>
                </table>
            </body>
        </div>
        
    </html>
</apex:page>