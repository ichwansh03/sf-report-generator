    <script>
     
    var endDateFromLogStr = '{!IF(endDateFromLog != null, TEXT(endDateFromLog), '')}';
    
    function addBusinessDays(startDate, daysToAdd) {
        var result = new Date(startDate);
        var addedDays = 0;
        while (addedDays < daysToAdd) {
            result.setDate(result.getDate() + 1);
            var day = result.getDay();
            // 0 = Minggu, 6 = Sabtu
            if (day !== 0 && day !== 6) {
                addedDays++;
            }
        }
        return result;
    }

window.setTimeout(function() {
    const input = document.querySelector("[id$='scheduleDateInput']");
    if (!input) return;

    const today = new Date();
    const endDateFromLogStr = '{!IF(endDateFromLog != null, TEXT(endDateFromLog), '')}';
    let baseDate = endDateFromLogStr ? new Date(endDateFromLogStr) : today;

    function addBusinessDays(startDate, daysToAdd) {
        let result = new Date(startDate);
        let addedDays = 0;
        while (addedDays < daysToAdd) {
            result.setDate(result.getDate() + 1);
            let day = result.getDay();
            if (day !== 0 && day !== 6) {
                addedDays++;
            }
        }
        return result;
    }

    const maxDate = addBusinessDays(baseDate, 5);

    function formatDate(date) {
        return date.toISOString().split('T')[0];
    }

    input.setAttribute("min", formatDate(today));
    input.setAttribute("max", formatDate(maxDate));

    input.addEventListener("change", function() {
        const selectedDate = new Date(this.value);
        updateTimeSlots(selectedDate);
    });
}, 500);
    
    
    function updateTimeSlots(selectedDate) {
    const scheduleTime = document.querySelector("select[id$='scheduleTime']");
    const selectedTime = scheduleTime.value.trim();
        
    const now = new Date();

        console.log('SEKARANG: ', now);
    console.log('Tanggal dipiih: ', selectedDate);
        
    const batchList = [
        { label: "10:00 - 12:00", hour: 10 },
        { label: "12:00 - 13:00", hour: 12 },
        { label: "13:00 - 16:00", hour: 13 },
    ];

    scheduleTime.innerHTML = '<option value>-- Select Time Range --</option>';

    let allPassed = true;

    batchList.forEach(batch => {
        const option = document.createElement("option");
        option.text = batch.label;
        option.value = batch.hour.toString().padStart(2, '0') + ':00';

        const batchTime = new Date(selectedDate);
        batchTime.setHours(batch.hour, 0, 0, 0);

        if (isSameDay(now, selectedDate) && now.getTime() >= batchTime.getTime()) {
            option.disabled = true;
        } else {
            allPassed = false;
        }

        scheduleTime.appendChild(option);
    });

    if (allPassed && isSameDay(now, selectedDate)) {
        alert("Semua batch untuk tanggal ini sudah berjalan. Silakan pilih tanggal lain.");
        $("#scheduleDateInput").val("");
    }
}

function isSameDay(date1, date2) {
    return date1.getFullYear() === date2.getFullYear() &&
           date1.getMonth() === date2.getMonth() &&
           date1.getDate() === date2.getDate();
}


</script>

    <script type="text/javascript">
    function openLookup(baseURL, width, modified, searchParam){
      var originalbaseURL = baseURL;
      var originalwidth = width;
      var originalmodified = modified;
      var originalsearchParam = searchParam;

      var lookupType = baseURL.substr(baseURL.length-3, 3);
      if (modified == '1') baseURL = baseURL + searchParam;

      var isCustomLookup = false;

      // Following "500" is the lookup type for Case object so change this as per your standard or custom object
      
      var urlArr = baseURL.split("&");
      var txtId = '';
      if(urlArr.length > 2) {
        urlArr = urlArr[1].split('=');
        txtId = urlArr[1];
      }
      
        
      //var ccc = 'j_id0:frm:pbc:block1:j_id22:parentcase';
      //var getparent = document.getElementById(ccc).value;
      var contactelement = 'j_id0:frm:pbc:block1:j_id12:contact_lkid';
      var contactId = document.getElementById(contactelement).value;
      
      // Following is the url of Custom Lookup page. You need to change that accordingly
      baseURL = "/apex/CustomCaseLookupLayout?txt=" + txtId + "&contactId=" + contactId;
      
      // Following is the id of apex:form control "frm". You need to change that accordingly
      baseURL = baseURL + "&frm=" + escapeUTF("{!$Component.frm}");
      if (modified == '1') {
        baseURL = baseURL + "&lksearch=" + searchParam;
      }
      
      // Following is the ID of inputField that is the lookup to be customized as custom lookup
      if(txtId.indexOf('parentcase') > -1 ){
        isCustomLookup = true;
      }
      


      if(isCustomLookup == true){
        openPopup(baseURL, "lookup", 350, 480, "width="+width+",height=480,toolbar=no,status=no,directories=no,menubar=no,resizable=yes,scrollable=no", true);
      }
      else {
        if (modified == '1') originalbaseURL = originalbaseURL + originalsearchParam;
        openPopup(originalbaseURL, "lookup", 350, 480, "width="+originalwidth+",height=480,toolbar=no,status=no,directories=no,menubar=no,resizable=yes,scrollable=no", true);
      } 
    }
    
