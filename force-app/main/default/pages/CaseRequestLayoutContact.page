                  this.qs1.cache();
                  this.qs2.cache();
                  deleteSelectedValue(values);
                }
            });
            */
        }else if('{!firstLoad}'=='save'){
            caseTypesObj.style.display = "none"; 
            selectedCTObj.style.display = "block"; 
            var csk = "{!selectedCaseTypeKeeper}".split('<br />');
            //csk.join('\n');
            var vl = "";
            for(var ii=0; ii<csk.length; ii++){
                vl = vl+csk[ii]+'\n';
            }
            selectedCTObj.innerHTML = vl ;
            selectedCTObj.disabled = 'disabled';
        }
      }
      function setDescriptionBySend(value){
        var descInput = document.getElementById('{!$Component.frm.pbc.block3Amfs.amfsDescription.inputDescAmfs}');
        var descOutput = document.getElementById('{!$Component.frm.pbc.block3Amfs.amfsDescription.outputDescAmfs}');
        if(value == 'Correspondence Address'){  
          descInput.disabled = true;
          descInput.required = false;
          descOutput.className = "";
        }else{
          descInput.disabled = false;
          descInput.required = true;
          descOutput.className = "requiredBlock";
