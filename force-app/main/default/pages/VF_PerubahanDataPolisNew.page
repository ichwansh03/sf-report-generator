<apex:page renderAs="PDF" showHeader="false" applyHtmlTag="false" applyBodyTag="false" standardController="E_Form_Master_Data__c" extensions="AMFS_PerubahanDataPolis_Controller">
    <html>
        <head>
            <style type="text/css">
                @page {
                    size: A4 portrait;
                    margin-top: 5mm;
                    margin-left: 5mm;
                    margin-right: 5mm;
                    margin-bottom: 20mm;
                    letter-spacing: 5px;

                    @top-center {
                        content: element(header);
                    }
                    
                    @bottom-center {
                        content: element(footer);
                    }
                }

                /* Header */
                div.header {
                    text-align: center;
                    font-family: sans-serif !important;
                    font-weight: bold;
                }

                /* Footer */
                div.footer {
                    position: running(footer);
                    text-align: center;
                    font-family: sans-serif !important;
                    font-size: 12px;
                }

                /* Table Styling */
                table.custom-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 16px;
                    margin-top: 10px;
                    text-align: center;
                }

                table.custom-table th {
                    background-color: #396cb2;
                    color: white;
                    padding: 8px;
                    border: 1px solid #ccc;
                    text-align: center;
                }

                table.custom-table td {
                    padding: 8px;
                    border: 1px solid #ccc;
                    vertical-align: top;
                }

                /* Table Styling */
                table.custom-table-header {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header td {
                    padding: 8px;
                    vertical-align: center;
                }

                /* Table Styling */
                table.custom-table-header-subject {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 16px;
                    margin-top: 10px;
                }

                table.custom-table-header-subject td {
                    vertical-align: top;
                    text-align: center;
                    font-weight:bold;
                }

                /* Table Styling */
                table.custom-table-header-value {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-value td {
                    vertical-align: top;
                    text-align: left;
                }

                table.custom-table-header-value td:first-child {
                    width: 25%;
                }

                table.custom-table-header-value td:nth-child(2) {
                    width: 2em;
                    text-align: center;
                }
                table.custom-table-header-value td:nth-child(3) {
                    width: auto;
                }

                /* Table Styling */
                table.custom-table-header-value-pajak {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-value-pajak td {
                    vertical-align: top;
                    text-align: left;
                    /* border: 1px solid black; */
                }

                table.custom-table-header-value-pajak td:first-child {
                    width: 90%;
                }

                table.custom-table-header-value-pajak td:nth-child(2) {
                    width: 2em;
                }
                /* table.custom-table-header-value-pajak td:nth-child(3) {
                    width: 10%;
                } */

                /* Table Styling */
                table.custom-table-header-pernyatan {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-pernyatan td {
                    vertical-align: top;
                    text-align: justify;
                }

                /* Table Styling */
                table.custom-table-header-alasan-perubahan {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }
                table.custom-table-header-alasan-perubahan td {
                    vertical-align: top;
                    text-align: left;
                }
                table.custom-table-header-alasan-perubahan td:first-child {
                    width: 25%;
                    font-weight: bold;

                }
                table.custom-table-header-alasan-perubahan td:nth-child(2) {
                    width: 2em;
                    text-align: center;
                }
                table.custom-table-header-alasan-perubahan td:nth-child(3) {
                    width: auto;
                }

                /* Table Styling */
                table.custom-table-header-cuti-premi {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }
                table.custom-table-header-cuti-premi td {
                    vertical-align: top;
                    text-align: left;
                    font-weight: bold;
                }

                /* Table Styling */
                table.custom-table-header-pernyatan-tambahan {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-pernyatan-tambahan td {
                    vertical-align: top;
                    text-align: justify;
                }

                table.custom-table-header-pernyatan-tambahan td:first-child {
                    width: 5%;
                    text-align: right;
                }

                table.custom-table-header-pernyatan-tambahan td:nth-child(2) {
                    width: 95%;
                    text-align: left;
                }

                /* Table Styling */
                table.custom-table-header-pernyatan-cuti {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-pernyatan-cuti td {
                    vertical-align: top;
                    text-align: justify;
                }

                /* Table Styling */
                table.custom-table-header-perubahan {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-perubahan td {
                    vertical-align: top;
                    text-align: left;
                }

                table.custom-table-header-perubahan td:first-child {
                    width: 30%;
                }
                table.custom-table-header-perubahan td:nth-child(2) {
                    width: 70%;
                }

                /* Table Styling */
                table.custom-table-header-perubahan-alamat {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-perubahan-alamat th {
                    vertical-align: top;
                    border: 1px solid black;
                    text-align: center;
                    font-weight: bold;
                }

                table.custom-table-header-perubahan-alamat td {
                    vertical-align: top;
                    border: 1px solid black;
                    padding-left: 5px;
                }

                table.custom-table-header-perubahan-alamat td:first-child {
                    text-align: left;
                    font-weight: bold;
                    width: 30%;
                }

                /* Table Styling */
                table.custom-table-header-perubahan-ahli {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                    table-layout: fixed;
                }

                table.custom-table-header-perubahan-ahli th {
                    font-weight: bold;
                    color: black;
                    padding: 8px;
                    border: 1px solid black;
                    text-align: center;
                    /* Tambahkan untuk header */
                    white-space: normal;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }

                table.custom-table-header-perubahan-ahli td {
                    vertical-align: center;
                    text-align: center;
                    border: 1px solid black;
                    padding: 8px;
                    /* Properti penting untuk text wrapping */
                    white-space: normal !important;
                    word-break: break-word !important;
                    overflow-wrap: break-word !important;
                    max-width: 0;
                }

                table.custom-table-header-perubahan-ahli td:first-child,
                table.custom-table-header-perubahan-ahli th:first-child {
                    width: 16.66%;
                }

                table.custom-table-header-perubahan-ahli td:nth-child(2),
                table.custom-table-header-perubahan-ahli th:nth-child(2) {
                    width: 16.66%;
                }

                table.custom-table-header-perubahan-ahli td:nth-child(3),
                table.custom-table-header-perubahan-ahli th:nth-child(3) {
                    width: 16.66%;
                }

                table.custom-table-header-perubahan-ahli td:nth-child(4),
                table.custom-table-header-perubahan-ahli th:nth-child(4) {
                    width: 16.66%;
                }

                table.custom-table-header-perubahan-ahli td:nth-child(5),
                table.custom-table-header-perubahan-ahli th:nth-child(5) {
                    width: 16.66%;
                }

                table.custom-table-header-perubahan-ahli td:nth-child(6),
                table.custom-table-header-perubahan-ahli th:nth-child(6) {
                    width: 16.66%;
                }

                /* Table Styling */
                table.custom-table-header-tambahan {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-header-tambahan th {
                    font-weight:bold;
                    color: black;
                    padding: 8px;
                    border: 1px solid black;
                    text-align: center;
                }

                table.custom-table-header-tambahan td {
                    vertical-align: center;
                    text-align: left;
                    border: 1px solid black;
                    padding-left: 5px;
                }

                table.custom-table-header-tambahan td:first-child {
                    width: 33.33%;
                }

                table.custom-table-header-tambahan td:nth-child(2) {
                    width: 33.33%;
                }
                table.custom-table-header-tambahan td:nth-child(3) {
                    width: 33.33%;
                }

                /* Table Styling */
                table.custom-table-header-pernyataan-kuasa {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 10px;
                }

                table.custom-table-header-pernyataan-kuasa th {
                    font-weight:bold;
                    color: black;
                    padding: 8px;
                    text-align: center;
                    font-size: 12px;
                }

                table.custom-table-header-pernyataan-kuasa td {
                    vertical-align: top;
                    text-align: justify;
                    font-size: 10px;
                }

                /* Table Styling */
                table.custom-table-ttd {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 12px;
                    margin-top: 10px;
                    font-family: sans-serif !important;
                }

                table.custom-table-ttd th {
                    font-weight:bold;
                    color: black;
                    padding: 8px;
                    font-family: sans-serif !important;
                    border: 1px solid black;
                    text-align: center;
                }

                table.custom-table-ttd td {
                    vertical-align: center;
                    border: 1px solid black;
                }

                table.custom-table-ttd td:first-child {
                    width: 50%;
                    font-weight:bold;
                    text-align: center;
                }

                /* Table Styling */
                table.custom-table-ttd-time {
                    width: 100%;
                    border-collapse: collapse;
                    font-family: sans-serif !important;
                    font-size: 12px;
                    margin-top: 10px;
                }

                table.custom-table-ttd-time td {
                    vertical-align: top;
                    font-weight:bold;
                    text-align: right;
                }

                .check {
                    display:inline-block;
                    width:14px;
                    height:14px;
                    border:1px solid #000;
                    text-align:center;
                    font-size:12px;
                    line-height:14px;
                    color:green;
                }
                body, .check {
                    font-family: DejaVu Sans, Arial Unicode MS, Helvetica, sans-serif;
                }


            </style>
        </head>
        

        <!-- FOOTER -->
        <div class="footer">
            <div >
                <apex:image value="{!$Resource.ojk_logo_bot}" width="600"></apex:image>
            </div>
        </div>

        <!--Head-->

        <div class="header"> 
            <div>
                <table class="custom-table-header">
                    <tr>
                        <td style="text-align: left;"><apex:image value="{!$Resource.emma_axa }" width="300px"></apex:image></td>
                        <td style="text-align: right; color:#396cb2">
                            CCC-{!touchPoint}
                        </td>
                    </tr>
                    
                </table>        
            </div>
        </div>

        <div>
            <div>
                <table class="custom-table-header-subject"> 
                    <tr>
                        <td>
                            {!subjectTransaction}
