            <apex:outputPanel rendered="{!NOT(ISNULL(doublePerubahan))}">
                <table class="custom-table-header-perubahan-alamat" >  
                    <thead>
                        <tr>
                            <th>{!headerPerubahan}</th>
                            <th>Pemegang Polis</th>                    
                            <th>Tertanggung/Peserta</th>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat value="{!doublePerubahan}" var="per">
                            <tr>
                                <td>{!per.nama}</td>
                                <td>{!per.val1}</td>
                                <td>{!per.val2}</td>
                            </tr>
                        </apex:repeat>
                    </tbody>
                </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(ISNULL(singlePerubahan))}">
                <table class="custom-table-header-perubahan-alamat" >  
                    <thead>
                        <tr>
                            <th>{!headerPerubahan}</th>
                            <th>{!headerSingle}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat value="{!singlePerubahan}" var="per">
                            <tr>
                                <td>{!per.nama}</td>
                                <td>{!per.val1}</td>
                            </tr>
                        </apex:repeat>
                    </tbody>
                </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(ISNULL(valueAlasan))}">
