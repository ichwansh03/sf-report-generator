                            Nomor Polis : {!polisNo}
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Nomor Transaksi : {!subjectTransactionNumber} - {!transNo}
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Tanggal Pengajuan {!subjectTransactionLower} : {!inputdtmmss}
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div>
            <table class="custom-table">
                <tr>
                    <th>
                        INFORMASI PEMEGANG POLIS
                    </th>
                </tr>
            </table>
            <div>
                <table class="custom-table-header-value">  
                    <tr>
                        <td>Nama Pemegang Polis </td>
                        <td style="width: 1em;">:</td>
                        <td>{!phName}</td>
                    </tr>
                    <tr>
                        <td>No.Telepon</td>
                        <td style="width: 1em;">:</td>
                        <td>{!phone}</td>
                        <td>
                            <apex:outputPanel rendered="{!centangTelepon = 'yes'}">
                                <span class="check">&#10003;</span>
                            </apex:outputPanel>
                        </td>
                    </tr>
                    <tr>
                        <td>NIK</td>
                        <td style="width: 1em;">:</td>
                        <td>{!NIK}</td>
                        <td>
                            <apex:outputPanel rendered="{!centangNIK = 'yes'}">
                                <span class="check">&#10003;</span>
                            </apex:outputPanel>
                        </td>
                    </tr>
                    <tr>
                        <td >Tanggal Lahir</td>
                        <td style="width: 1em;">:</td>
                        <td>{!tanggalLahir}</td>
                    </tr>
                    <tr>
                        <td >Alamat</td>
                        <td style="width: 1em;">:</td>
                        <td>{!addr}</td>
                        <td>
                            <apex:outputPanel rendered="{!centangAlamat = 'yes'}">
                                <span class="check">&#10003;</span>
                            </apex:outputPanel>
                        </td>
                    </tr>
                    <tr>
                        <td >Email</td>
                        <td style="width: 1em;">:</td>
                        <td>{!email}</td>
                        <td>
                            <apex:outputPanel rendered="{!centangEmail = 'yes'}">
                                <span class="check">&#10003;</span>
                            </apex:outputPanel>
                        </td>
                    </tr>
                    <tr>
                        <td >Nama Produk</td>
                        <td style="width: 1em;">:</td>
                        <td>{!prodName}</td>
                    </tr>
                    <tr>
                        <td >Segmentasi</td>
                        <td style="width: 1em;">:</td>
                        <td>{!segmentasi}</td>
                    </tr>
                </table>
            </div>
        </div>

        <div>
            <table class="custom-table">
                <tr>
                    <th>
                        INFORMASI PERPAJAKAN LUAR NEGERI
                    </th>
                </tr>
            </table>
            <div>
                <table class="custom-table-header-value-pajak">
                    <tr>
                        <td >Apakah Anda Melakukan Pelaporan Pajak di Luar Negara Indonesia ?</td>
                        <td style="text-align:start">: {!pajak}</td>
                    </tr>
                </table>
            </div>
        </div>

        <div>
            <table class="custom-table">
                <tr>
                    <th>
                        {!subjectTransactionTable}
                    </th>
                </tr>
            </table>
            <div>
                <apex:outputPanel rendered="{!NOT(ISNULL(subjectDesc))}">
                    <table class="custom-table-header-pernyatan" >
                        <apex:repeat value="{!subjectDesc}" var="per">
                            <tr>
                                <td>
                                    Dengan ini saya mengajukan perubahan data {!per.alasan} dan setuju polis yang saya miliki dilakukan perubahan data sebagai berikut:
                                </td>
                            </tr>
                        </apex:repeat>
                    </table>
                </apex:outputPanel>
                <!-- <apex:outputPanel  rendered="{!NOT(ISNULL(subjectDescCuti))}">
                    <table class="custom-table-header-pernyatan-cuti" >
                        <apex:repeat value="{!subjectDescCuti}" var="per">
                            <tr>
                                <td>
                                    Dengan ini saya mengajukan {!per.subject} dan menyetujui syarat dan ketentuan {!per.subject} yang berlaku.
                                </td>
                            </tr>
                        </apex:repeat>
                    </table>
                </apex:outputPanel> -->
            </div>
            <div>
                <apex:outputPanel rendered="{!NOT(ISNULL(valueFooter))}">
                    <table class="custom-table-header-cuti-premi" >
                        <apex:repeat value="{!valueFooter}" var="per">
                            <tr>
                                <td>
                                    {!per.alasan}
                                </td>
                            </tr>
                        </apex:repeat>
                    </table>
                </apex:outputPanel>
            </div>
            
        </div>
            
        <div>

            <apex:outputPanel rendered="{!NOT(ISNULL(ahliWaris))}">
                <table class="custom-table-header-perubahan-ahli">  
                    <thead>
                        <tr>
                            <th>Nama Lengkap (Sesuai kartu identitas)</th>
                            <th>Tanggal Lahir (tgl/bln/thn)</th>                    
                            <th>Jenis Kelamin (L/P)</th>
                            <th>Nomor Identitas</th>
                            <th>Persentase (%)</th>
                            <th>Hubungan dengan tertanggung/peserta</th>
                        </tr>
                    </thead>
                    <apex:repeat value="{!ahliWaris}" var="per">
                        <tbody>
                            <tr>
                                <td>
                                    {!per.nama}
                                </td>
                                <td>
                                    {!per.tanggal}
                                </td>
                                <td>
                                    {!per.jenisKel}
                                </td>
                                <td>
                                    {!per.nomorIdentitas}
                                </td>
                                <td>
                                    {!per.persentase}
                                </td>
