                            <td style="width: 1em;">:</td>
                            <td>{!per.alasan}</td>
                        </tr>
                    </apex:repeat>
                </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(ISNULL(valueAlasanCuti))}">
