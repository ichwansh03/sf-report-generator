                    } else if (answerVal != "skip" && j == 4 && mapTemp[answerVal] == null){
                        // input 4
                        response.question4 = answerVal;
                        var contentAsw = mapNametoScript[answerVal];
                        response.answer4 = contentAsw != null ? mapNametoScript[answerVal].contentAnswer : null;
                        //response.answer4 = mapNametoScript[answerVal].contentAnswer;
                        if(contentAsw != null /**&& mapNametoScript[contentAsw].fgNote*/){
