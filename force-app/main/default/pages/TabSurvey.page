                        response.answer3 = contentAsw != null ? mapNametoScript[answerVal].contentAnswer : null;
                        //response.answer3 = mapNametoScript[answerVal].contentAnswer;
                        if(contentAsw != null /**&& mapNametoScript[contentAsw].fgNote*/){
                            section = item.section != null ? item.section.replace(/\s/g,'') : "";
                            var note = $("#note"+section).val();
                            console.log('note '+note);
                            response.note = note;
                        }
                        
                        mapTemp[answerVal] = answerVal;
                        console.log(answerVal +"3 "+response.answer3);
