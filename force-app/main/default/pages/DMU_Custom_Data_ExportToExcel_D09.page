<apex:page controller="DMU_Custom_Data_View_Controller" contentType="txt/xml#{!filename}.xls" cache="true">
    <apex:outputText value="{!xlsHeader}"/>
    <Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
    xmlns:o="urn:schemas-microsoft-com:office:office"
    xmlns:x="urn:schemas-microsoft-com:office:excel"
    xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
    xmlns:html="http://www.w3.org/TR/REC-html40">
        <Styles>
            <Style ss:ID="s1">
                <Alignment/>
                <Borders/>
                <Font ss:Bold="1"/>
                <Interior/>
                <NumberFormat/>
                <Protection/>
            </Style>
        </Styles>
        <Worksheet ss:Name="Transaction Statement - Email SMS">
            <Table x:FullColumns="1" x:FullRows="1">
                <Column ss:Width="170"/>
                <Column ss:Width="280"/>
                <Column ss:Width="330"/>
                <Row>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >No Polis</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Polis Holder Name</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Tgl Kirim by Email</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Status Email</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Tgl download by email</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Tgl Kirim by SMS</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Status SMS</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Tgl download by SMS</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >alamat email</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >no HP</Data></Cell>
                    <Cell ss:StyleID="s1"><Data ss:Type="String" >Tgl Issued</Data></Cell>
                </Row>
                <apex:repeat value="{!tseList}" var="ph">
                    <Row>
                        <Cell><Data ss:Type="String">{!ph.policy_no}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.Consignee}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.email_delivery_dt}{!ph.sms_delivery_dt}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.StatusEmail}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.TglDownloadEmail}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.sms_delivery_dt}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.StatusSMS}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.TglDownloadSMS}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.Email}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.NoHP}</Data></Cell>
                        <Cell><Data ss:Type="String">{!ph.TglIssued}</Data></Cell>
                    </Row>
                </apex:repeat>
            </Table>
        </Worksheet>
    </Workbook>
</apex:page>