<apex:page standardController="Call_Line__c" extensions="ClaimNumberController" action="{!getClaimNumber}" tabStyle="Call_Line__c">
    
    <script>
        var isFormDirty = false;
        
        // Detect when user modifies claim inputs
        function attachChangeListeners() {
            var claimSelects = document.querySelectorAll('[id*="claimNumber"]');
            var claimInputs = document.querySelectorAll('[id*="description"]');
            
            console.log('Found claim selects: ' + claimSelects.length);
            console.log('Found claim inputs: ' + claimInputs.length);
            
            claimSelects.forEach(function(select) {
                select.addEventListener('change', function() {
                    console.log('Claim number changed');
                    isFormDirty = true;
                });
            });
            
            claimInputs.forEach(function(input) {
                input.addEventListener('change', function() {
                    console.log('Description changed');
                    isFormDirty = true;
                });
                input.addEventListener('blur', function() {
                    console.log('Description blur - marking dirty');
                    isFormDirty = true;
                });
            });
        }
        
        // Try to intercept parent page save in multiple ways
        function initializeSaveInterceptor() {
            console.log('=== Initializing save interceptor ===');
            attachChangeListeners();
            
            // Method 1: Watch for visibility changes (page is about to unload/save)
            document.addEventListener('visibilitychange', function() {
                console.log('Visibility changed, visibility state: ' + document.visibilityState);
                if (document.visibilityState === 'hidden' && isFormDirty) {
                    console.log('Page may be saving - calling submitSelected');
                    saveClaimsBeforeSave();
                }
            });
            
            // Method 2: Watch for beforeunload (page refresh/navigation)
            window.addEventListener('beforeunload', function(e) {
                console.log('beforeunload triggered, isFormDirty: ' + isFormDirty);
                if (isFormDirty) {
                    console.log('Saving claims before unload');
                    // Try to save synchronously
                    var xmlhttp = new XMLHttpRequest();
                    xmlhttp.open('POST', window.location.href, false); // synchronous
                    xmlhttp.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
                    
                    // Collect claim data
                    var claimData = collectClaimData();
                    console.log('Claim data to save: ' + claimData);
                }
            });
            
            // Method 3: Override form submit if parent tries to submit
            try {
                var parentForm = window.top.document.querySelector('form');
                if (parentForm) {
                    var originalSubmit = parentForm.submit;
                    parentForm.submit = function() {
                        console.log('Parent form submit intercepted');
                        if (isFormDirty) {
                            console.log('Calling saveClaimsBeforeSave before parent submit');
                            saveClaimsBeforeSave();
                        }
                        return originalSubmit.apply(parentForm, arguments);
                    };
                    console.log('Parent form submit intercepted successfully');
                }
            } catch (e) {
                console.log('Could not intercept parent form: ' + e.message);
            }
        }
        
        function collectClaimData() {
            var claimData = [];
            var claimSelects = document.querySelectorAll('[id*="claimNumber"]');
            var claimInputs = document.querySelectorAll('[id*="description"]');
            
            for (var i = 0; i < claimSelects.length; i++) {
                var claimNum = claimSelects[i].value || '';
                var desc = claimInputs[i] ? claimInputs[i].value || '' : '';
                if (claimNum) {
                    claimData.push(claimNum + '|' + desc);
                }
            }
            return claimData.join('~');
        }
        
        // Initialize on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeSaveInterceptor);
        } else {
            initializeSaveInterceptor();
        }
    </script>
    
    <apex:form id="claimForm">
        <!-- Hidden button that will be triggered to save claims -->
        <apex:actionFunction name="saveClaimsBeforeSave" action="{!submitSelected}" rerender="main" status="actStatus" oncomplete="onClaimsSaveComplete()" />
        
        <script>
            function onClaimsSaveComplete() {
                console.log('=== Claim save completed ===');
                isFormDirty = false;
                
                // After saving claims, trigger parent page save
                try {
                    var saveButton = window.top.document.querySelector('[data-action="save"]') ||
                                    window.top.document.querySelector('button[title*="Save"]') ||
                                    window.top.document.querySelector('button[name*="save"]');
                    
                    if (saveButton) {
                        console.log('Found and clicking save button');
                        setTimeout(function() {
                            saveButton.click();
                        }, 500);
                    } else {
                        console.log('Could not find save button');
                    }
                } catch (e) {
                    console.log('Error clicking save button: ' + e.message);
                }
            }
        </script>
        
        <div style="margin-left: 50px; margin-top: 10px;">
            <apex:actionStatus id="actStatus">
                <apex:facet name="start" >
                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.25; z-index: 1000; background-color: black;">
                        &nbsp;
                    </div>
                    <div style="position: fixed; left: 0; top: 0; bottom: 0; right: 0; z-index: 1001; margin: 15% 50%">
                        <div style="display: inline-block; padding: 2px; background-color: #fff; width: 125px;">
                            <img src="/img/loading.gif" style="float: left; margin: 8px;" />
                            <span style="display: inline-block; padding: 10px 0px;">Please Wait...</span>
                        </div>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <apex:outputPanel id="main" rendered="{!isTeleclaim}">
                
                <apex:outputText style="font-weight:bold" value="Insert Claim Number"/>
                <apex:repeat value="{!claimWrappers}" var="cw" id="claimRepeat">
                    <apex:outputPanel layout="block" style="margin-bottom:6px;">
                        <apex:commandLink title="delete row" action="{!removeClaimRow}" rendered="{!claimWrappers.size > 1}" reRender="main">
                            <apex:param name="index" value="{!cw.idx}" assignTo="{!deleteClaim}" />
                            <apex:image url="{!URLFOR($Resource.ErrorIcon)}" width="18" height="18" style="margin-right: 5px" />
                        </apex:commandLink>
                        <apex:selectList id="claimNumber" value="{!cw.claimNumber}" size="1" style="margin-right: 10px">
                            <apex:selectOptions value="{!claimResponses}" />
                        </apex:selectList>
                        <apex:inputText id="description" value="{!cw.description}" html-placeholder="Claim remark" style="margin-right: 10px" />
                        <apex:commandButton value="+" action="{!addClaimRow}" rendered="{!AND(cw.idx == claimWrappers.size - 1, claimWrappers.size < claimResponses.size)}"
                                            reRender="main" />
                    </apex:outputPanel>
                </apex:repeat>
            </apex:outputPanel>
        </div>
    </apex:form>
</apex:page>