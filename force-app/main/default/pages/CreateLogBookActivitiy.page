            <script>
            var j$ = jQuery.noConflict();
            var filesToUpload = [];
            var uploadedFile = 0;
            var fileMaxSize = 10000000;
            var indexPosition;
            var bodyList = [];
            var nameList = [];
            var typeList = [];
            var tmpBody = '';
            
            function uploadFile(fileParam) { 
                filesToUpload.length = 0;
                bodyList.length = 0;
                nameList.length = 0;
                typeList.length = 0;
                j$("input[type=file]").each(function() {
                    if (j$(this)[0].files[0]) {
                        filesToUpload.push(j$(this)[0].files[0]);
                    }
                });
                
                for(var i = 0; i<filesToUpload.length; i++) {
                    if (filesToUpload[i].size <= fileMaxSize) {
                        //nameList.push(filesToUpload[i].name);
                        //typeList.push(filesToUpload[i].type);
                        (function(fileBinary){
                            var fileBinary = filesToUpload[i];
                            var fileReader = new FileReader();
                            fileReader.file = filesToUpload[i];
                            fileReader.onloadend = function(e) {
                                var binary = "";
                                var bytes = new Uint8Array(e.target.result);
                                var length = bytes.byteLength;
                                for (var i = 0; i < length; i++) {
                                    binary += String.fromCharCode(bytes[i]);
                                }
                                //tmpBody = window.btoa(fileReader.result);
                                //tmpBody = (new sforce.Base64Binary(binary)).toString(); 
                                tmpBody = window.btoa(binary);
                                nameList.push(fileBinary.name);
                                typeList.push(fileBinary.type);
                                bodyList.push(tmpBody);
                                indexPosition = 0;  
                                console.log(' ---- Body 2 ----');
                                console.log(bodyList);
                                console.log(' ---- name 2 ----');
                                console.log(nameList);
                                console.log(' ---- type 2 ----');
                                console.log(typeList);
                            }
                            fileReader.readAsArrayBuffer(fileBinary);
                        })(filesToUpload[i]);
                    }
                    else {
                        alert("Maximum file size is 10 MB");
                        fileParam.value='';
                    }
                }  
                
                console.log(' ---- Body 3 ----');
                console.log(bodyList);
                console.log(' ---- name  3----');
                console.log(nameList);
                console.log(' ---- type 3 ----');
                console.log(typeList);
                setTimeout(triggerFile, 2000);
            }
            
            function addRow(tableID) { 
                var table_id = tableID; 
                //alert(table_id);
                var row = '<tr><td><input type="checkbox" onclick="processCheckbox(\'' + table_id + '\');" name="chk" class="fileCheckBox"/</td><td class="fileRows"><input type="file" class="fileInput" style="width: 100%" onchange="uploadFile(this);"/> </td></tr>';
                j$('#'+tableID).append(row);  
            }
            
            function deleteRow(tableID) {
                try {
                    var table_id = tableID; 
                    var table=document.getElementById(tableID);
                    var rowCount=table.rows.length;
                    
                    for(var i=0;i<rowCount;i++) {
                        var row=table.rows[i];
                        var chkbox=row.cells[0].childNodes[0];
                        if(null!=chkbox&&true==chkbox.checked) {
                            table.deleteRow(i);
                            filesToUpload.splice(i, 1);
                            rowCount--;
                            i--;
                        }
                    }
                    processCheckbox(table_id);
                    uploadFile();
                    triggerFile();
                }catch(e) {
                    alert(e);
                }
            }
            
            function processCheckbox(table_id) { 
                j$("._remove").addClass('hide');
                var checkCount=0;
                j$("#"+ table_id + " input[type='checkbox']").each(function() {
                    if(j$(this).is(':checked')) {
                        checkCount++;
                    }
                });      
                if(checkCount >0) {
                    j$("._remove").removeClass('hide');
                }
            }
            
            function triggerFile() {                    
                j$('[id$=listBodyAttachId]').val(bodyList);
                j$('[id$=listNameAttachId]').val(JSON.stringify(nameList, null, 2));
                j$('[id$=listTypeAttachId]').val(JSON.stringify(typeList, null, 2));
                
                console.log(' ---- Body ----');
                console.log(bodyList);
                console.log(' ---- name ----');
                console.log(nameList);
                console.log(' ---- type ----');
                console.log(typeList);
            }
            
