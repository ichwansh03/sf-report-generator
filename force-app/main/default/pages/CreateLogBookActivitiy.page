    }
    function sendMetadataAction(lbdId) {
        var buttonDipcad = document.getElementById('logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:buttonParentCollection:buttonCollection:buttonDipcad');
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.LogBookActivitiyController.sendEmailandMetadata}', 
            lbdId,
            function(result, event) {
                if (event.status) {
                    alert('Pengiriman Dokumen ke DIPCAD sedang berlangsung. Mohon cek status pengiriman pada button Preview.');
                    if (buttonDipcad) {
                        buttonDipcad.disabled = true;
                    }

                    var pollingInterval = setInterval(function() {
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.LogBookActivitiyController.buttonSendEmailandMetadata}',
                            lbdId,
                            function(statusResult, statusEvent) {
                                if (statusEvent.status) {
                                    console.log('Status Dipcad:', statusResult);

                                    if (statusResult === 'Failed') {
                                        if (buttonDipcad) buttonDipcad.disabled = false;
                                        clearInterval(pollingInterval);
                                    } else{
                                        clearInterval(pollingInterval);
                                    }
                                } else {
                                    console.error('Gagal mendapatkan status:', statusEvent.message);
                                    if (buttonDipcad) buttonDipcad.disabled = false;
                                    clearInterval(pollingInterval);
                                }
                            }
                        );
                    }, 5000);
                } else {
                    alert('Terjadi kesalahan teknis! ' + event.message);
                    if (buttonDipcad) {
                        buttonDipcad.disabled = false;
                    }
                }
            }
        );
    }

    function checkAndConfirm(lbdId) {
        // var buttonDipcad = document.getElementById('logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:buttonParentCollection:buttonCollection:buttonDipcad');
        // lbdId = 'a1wBK000000gRYTYA2';
        // console.log('lbdId >> '+lbdId);
        if(lbdId == ''){
            alert('Transaksi dan Dokumen belum tersedia untuk pengiriman ke sistem imaging.');
        }else{
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.LogBookActivitiyController.checkDetail}',
                lbdId,
                function(result, event) {
                    // console.log('result'+result+event);
                    if (event.status) {
                        var isFailed = result;
                        if (isFailed == 0) {
                            // console.log('failed SentoDipcad >> ');
                            alert('Transaksi belum dalam bentuk E-form, proses tidak dapat dilanjutkan.');
                            // buttonDipcad.disabled = false;
                        } else if (isFailed === 2){
                            // console.log('failed SentoDipcad 2 >> ');
                            alert('Email tidak dapat di kirimkan. Pastikan transaksi E-Form sudah selesai dilakukan terlebih dahulu.');
                        }else {
                            // console.log('get SentoDipcad >> ');
                            if (confirm('Apakah Anda yakin ingin mengirim ke Dipcad?')) {
                                sendMetadataAction(lbdId);
                                // sendEmailDipcad(lbdId);
                                // buttonDipcad.disabled = true;
                            }
                        }
                    } else {
                        // buttonDipcad.disabled = false;
                        console.error("AMFS Error fetching values:", event.message);
                    }
                }, 
                {escape: false}
            );
        }
        return false;
    }
