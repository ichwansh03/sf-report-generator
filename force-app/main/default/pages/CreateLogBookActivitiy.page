        var policyName = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:policyNameField");
        var policyProduct = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:policyProductField");
        var emailContact = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionEmailPP:emailPP");
        var phoneContact = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionPhonePP:ContactPP"); 
        var identityNo = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionIdentityItem:identityNoField");
        
        policyName.setAttribute('readonly', 'readonly');
        policyProduct.setAttribute('readonly', 'readonly');
        if(isNonCust && el != null){
            searchPolicy.value = '';
            // policyNo.value = '';
            // policyName.value = '';
            // policyProduct.value = '';
            // if (emailContact != null && emailContact != '') emailContact.value = '';
            // if (phoneContact != null && phoneContact != '') phoneContact.value = '';
        }else{
            isNonCust = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:isNonCustItem:isNonCust");
        }
        if(isNonCust.checked){
            policyNo.removeAttribute('readonly');
