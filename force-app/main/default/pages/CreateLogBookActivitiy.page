    function getParam(){
        var queryString = window.location.search;
        var urlParams = new URLSearchParams(queryString);
        var csSubject = urlParams.get('csSubject');
        if(csSubject!=null){
            var subjectElement = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionSubject:csSubject"); 
            if (subjectElement) {
                subjectElement.value = csSubject;
                // console.log("Nilai 'csSubject' dari URL berhasil diatur ke elemen input."+csSubject);
            } else {
                console.error("Elemen dengan ID 'logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock::logBookActivitiyDetail:csSubject' tidak ditemukan.");
            }
        }
    }
    function setDoc(docInfo){
        // console.log('docInfo',docInfo);
        var docs =  docInfo.split(';');
        var i;
        for (i = 0; i < docs.length; i++) {
            var docData = docs[i];
            var indxA = docData.indexOf("[");
            var indxB = docData.indexOf("]");
            var docDataName = docData.substring(0,indxA);
            var docDataSpecs = docData.substring(indxA+1,indxB);
            var docInput = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:itemDocInfo:docInfo").children;
            var j;
            for (j =0; j < docInput.length; j++) {
                var docInputName = docInput[j].innerHTML;
                if(docInputName.trim() == docDataName){
                    j++;
                    var docInputSpecs = docInput[j].children[0].children[0].children[0].children[0].children;
                    var k;
                    for (k = 0; k < docInputSpecs.length; k++) {
                        var docInputSpec = docInputSpecs[k]; 
                        docInputSpec.children[0].checked = false;
                        var docDataSpec = docDataSpecs.split(',');
                        var l;
                        for (l = 0; l < docDataSpec.length; l++) {
                            // console.log(docInputSpec.children[0].value+'=='+docDataSpec[l])
                            if( docInputSpec.children[0].value == docDataSpec[l]){
                                //console.log('MASUK>>>'+docInputName.trim()+'=>'+docInputSpec.children[0].value+'[v]');
                                docInputSpec.children[0].checked = true;
                            }
                        }
                    }
                }else{
                    j ++;
                }
            }
        }
        console.log(new Date());
    }   
    
