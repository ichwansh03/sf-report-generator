    function cekPolicyHolder(el){
        // var policyHolder = el;
        var policyHolder = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:isPolicyHldr");
        var policyName = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:policyNameField");
        var custName = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:itemCustName:custName");
        var custRelation = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:custRelationItem:custRelation");
        
        if(policyHolder && el != null){
            if(policyHolder.checked){
                custName.value = policyName.value;
                custRelation.value = 'Diri Sendiri';
            }else{
                custName.value = '';
                custRelation.value = '';
            }
        }else{
            policyHolder = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:isPolicyHldr");
        }
        
        if(policyHolder.checked){
            custRelation.setAttribute('disabled', 'disabled');
        }else{
            custRelation.removeAttribute('disabled');
        }
        checkPP();
    }  
    
    // add by Ranti at 11/30/2021
    function checkPP() {  
        var isNonCust = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:isNonCustItem:isNonCust");
        var policyHolder = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:isPolicyHldr");
        //var showPP = (isNonCust.checked == true && policyHolder.checked == false) ? false : true;
        var showPP = (isNonCust.checked == true) ? false : true;
        var emailContact = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionEmailPP:emailPP");
        var phoneContact = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionPhonePP:ContactPP"); 
        var sectionEmailNonPP = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionEmailNonPP:j_id110");
        var sectionPhoneNonPP = document.getElementById("logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:sectionPhoneNonPP:j_id113");
        
        if (showPP == true) {
            if (sectionEmailNonPP != null && sectionEmailNonPP != '') {
                sectionEmailNonPP.value = '';
                sectionEmailNonPP.setAttribute('disabled', 'disabled');
            }
            if (sectionPhoneNonPP != null && sectionPhoneNonPP != '') {
                sectionPhoneNonPP.value = '';
                sectionPhoneNonPP.setAttribute('disabled', 'disabled');
            } 
            
            if (emailContact != null && emailContact != '') { 
                emailContact.removeAttribute('disabled');
            }
            if (phoneContact != null && phoneContact != '') { 
                phoneContact.removeAttribute('disabled');
            }
        } else {
            
            if (sectionEmailNonPP != null && sectionEmailNonPP != '') { 
                sectionEmailNonPP.removeAttribute('disabled');
            }
            if (sectionPhoneNonPP != null && sectionPhoneNonPP != '') { 
                sectionPhoneNonPP.removeAttribute('disabled');
            } 
            
            if (emailContact != null && emailContact != '') {
                // emailContact.value = '';
                emailContact.setAttribute('disabled', 'disabled');
            }
            if (phoneContact != null && phoneContact != '') {
                // phoneContact.value = '';
                phoneContact.setAttribute('disabled', 'disabled');
            }
        }
    }
    
