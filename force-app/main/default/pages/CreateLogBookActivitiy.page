    // Fetch Picklist Values from Apex
    function fetchPicklistValues() {
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.LogBookActivitiyController.getDokumenTambahan}',
            function(result, event) {
                if (event.status) {
                    // console.log("Picklist Values:", result);
                    let select = jQuery("#dokumenTambahan");
                    select.empty(); // Clear existing options
                    
                    // Append new options
                    result.forEach(function(value) {
                        select.append(`<option value="${value}">${value}</option>`);
                    });

                    if (select.data('multiselect-initialized')) {
                        select.multiSelect('refresh');
                    } else {
                        // select.multiSelect();
                        select.multiSelect({
                            selectableHeader: "<input type='text' class='search-input' autocomplete='off' placeholder='Search...'>",
                            selectionHeader: "<input type='text' class='search-input' autocomplete='off' placeholder='Search...'>",
                            afterInit: function(ms) {
                                var that = this,
                                    $selectableSearchDokumen = that.$selectableUl.prev(),
                                    $selectionSearchDokumen = that.$selectionUl.prev(),
                                    selectableSearchStringDokumen = '#'+that.$container.attr('id')+' .ms-elem-selectable:not(.ms-selected)',
                                    selectionSearchStringDokumen = '#'+that.$container.attr('id')+' .ms-elem-selection.ms-selected';

                                that.qs1 = $selectableSearchDokumen.quicksearch(selectableSearchStringDokumen)
                                .on('keydown', function(e) {
                                    if (e.which === 40) {
                                        that.$selectableUl.focus();
                                        return false;
                                    }
                                });
                                
                                that.qs2 = $selectionSearchDokumen.quicksearch(selectionSearchStringDokumen)
                                .on('keydown', function(e) {
                                    if (e.which === 40) {
                                        that.$selectionUl.focus();
                                        return false;
                                    }
                                });
                            },
                            afterSelect: function(values){
                                this.qs1.cache();
                                this.qs2.cache();
                            },
                            afterDeselect: function(values){
                                this.qs1.cache();
                                this.qs2.cache();
                            }
                        });
                        select.data('multiselect-initialized', true);
                    }
                        
                     
                    } else {
                        console.error("Error fetching picklist values:", event.message);
                }
            }, 
            {escape: false}
        );
        
    }

    function fetchFormTambahanValues() {
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.LogBookActivitiyController.getFormTambahan}',
            function(result, event) {
                if (event.status) {
                    // console.log("Picklist Values:", result);
                    let select = jQuery("#formTambahan");
                    select.empty(); // Clear existing options
                    
                    // Append new options
                    result.forEach(function(value) {
                        select.append(`<option value="${value}">${value}</option>`);
                    });

                    if (select.data('multiselect-initialized')) {
                        select.multiSelect('refresh');
                    } else {
                        select.multiSelect();
                        select.data('multiselect-initialized', true);
                    }
                        
                     
                    } else {
                        console.error("Error fetching picklist values:", event.message);
                }
            }, 
            {escape: false}
        );
        
    }

    function updateTextbox() {
        var selectedDokumen = jQuery('#dokumenTambahan').val();
        // console.log('selectedDokumen',selectedDokumen);
        jQuery("[id$=selectedDok]").val(selectedDokumen ? selectedDokumen.join(', ') : '');
