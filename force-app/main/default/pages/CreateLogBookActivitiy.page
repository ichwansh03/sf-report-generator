            document.getElementById('logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:searchPolicySection:searchPolicy').disabled = true;
            document.getElementById('logBookActivitiyPage:logBookActivitiyCreateForm:logBookActivitiyBlock:logBookActivitiyDetail:searchPolicySection:searchPolicy_lkwgt').style.display = 'none';
