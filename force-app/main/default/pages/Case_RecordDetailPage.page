                <apex:outputLabel value="No records to display" rendered="{!listNegative.size == 0}" styleClass="noRowsHeader"></apex:outputLabel> 
                <apex:outputPanel id="pagination">
                    <apex:actionFunction name="negativesAction" action="{!setLoadNegatives}" rerender="out"/>
                    <apex:outputPanel rendered="{!IF(totalRow > 0, TRUE, FALSE)}">
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataFirst}" reRender="negatives">First</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">First</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataPrevious}" reRender="negatives">Previous&nbsp;</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">Previous</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:repeat value="{!list_page}" var="i" id="theRepeat">
                            <apex:commandLink action="{!getDataToPage}" status="stSearch" rendered="{!i != TEXT(current_page)}" value="{!i}" id="theValue" reRender="negatives">
                                <apex:param name="nickName"
                                            value="{!i}"
                                            assignTo="{!to_page}"/>
                            </apex:commandLink>
                            <apex:outputText rendered="{!i == TEXT(current_page)}" value="{!i}"/>
                            &nbsp;|&nbsp;
                        </apex:repeat>
                        
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataNext}" reRender="negatives">Next</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Next</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataLast}" reRender="negatives">Last</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Last</apex:outputText>
                    </apex:outputPanel>
                </apex:outputPanel>
                <br/>
                <apex:outputText style="font-style:italic" id="processTime" value="{!processTime}" escape="false"/><br/>
            </apex:pageblock>         
        
            <!--   <c:SurveyTaken_RelatedList parentId="{!id}" rendered="{!isSurveyTaken_RelatedList}" />  --> 
            <apex:pageblock id="survey" title="Surveys Taken" tabStyle="Case" rendered="{!isSurveyTaken_RelatedList}">
                <apex:actionStatus id="status" >
                    <apex:facet name="start"> 
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel > 
                            <apex:commandButton value="Reload" action="{!loadSurvey}" rerender="survey" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus><br/> 
                <apex:pageBlockTable value="{!listSurveyTaken}" var="em" rendered="{!listSurveyTaken.size != 0}">
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'InquiryAFICase',cs.data.RecordType_Name == 'InquiryALICase',cs.data.RecordType_Name == 'InquiryAMFSCase',cs.data.RecordType_Name == 'SocialPost-AFI',cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="ID"><apex:outputLink value="/apex/SurveyTaken_RecordDetailPage?id={!em.id}">{!em.name}</apex:outputLink> </apex:column>
                    <!-- <apex:column rendered="{!OR(cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Name"><apex:outputLink value="/apex/SurveyTaken_RecordDetailPage?id={!em.id}">{!em.name}</apex:outputLink> </apex:column>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Entity" value="{!em.entity_c}"/>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Status Response" value="{!em.status_Response_c}"/>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Count Response" value="{!em.count_Response_c}"/> 
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Negative Feedback" value="{!em.negative_Feedback_c}"/>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Positif Feedback" value="{!em.positive_Feedback_c}"/> -->
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'InquiryAMFSCase',cs.data.RecordType_Name == 'SocialPost-AFI',cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Survey"><apex:outputLink value="/{!em.survey_c}">{!em.surveyName}</apex:outputLink> </apex:column>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'InquiryAMFSCase',cs.data.RecordType_Name == 'SocialPost-AFI',cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Survey Taken By Contact"><apex:outputLink value="/{!em.contact_c}">{!em.contactName}</apex:outputLink> </apex:column>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'InquiryAMFSCase',cs.data.RecordType_Name == 'SocialPost-AFI',cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Survey Taken By User"><apex:outputLink value="/{!em.createdById}">{!em.createdByName}</apex:outputLink> </apex:column>
                    <apex:column rendered="{!OR(cs.data.RecordType_Name == 'InquiryAMFSCase',cs.data.RecordType_Name == 'SocialPost-AFI',cs.data.RecordType_Name == 'SocialPost-AMFS')}" headerValue="Taken" value="{!em.taken_c}"/> 
                </apex:pageBlockTable> 
                <apex:outputLabel value="No records to display" rendered="{!listSurveyTaken.size == 0}" styleClass="noRowsHeader"></apex:outputLabel> 
                <apex:outputPanel id="pagination">
                    <apex:actionFunction name="surveyAction" action="{!setLoadSurvey}" rerender="out"/>
                    <apex:outputPanel rendered="{!IF(totalRow > 0, TRUE, FALSE)}">
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataFirst}" reRender="survey">First</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">First</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataPrevious}" reRender="survey">Previous&nbsp;</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">Previous</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:repeat value="{!list_page}" var="i" id="theRepeat">
                            <apex:commandLink action="{!getDataToPage}" status="stSearch" rendered="{!i != TEXT(current_page)}" value="{!i}" id="theValue" reRender="survey">
                                <apex:param name="nickName"
                                            value="{!i}"
                                            assignTo="{!to_page}"/>
                            </apex:commandLink>
                            <apex:outputText rendered="{!i == TEXT(current_page)}" value="{!i}"/>
                            &nbsp;|&nbsp;
                        </apex:repeat>
                        
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataNext}" reRender="survey">Next</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Next</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataLast}" reRender="survey">Last</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Last</apex:outputText>
                    </apex:outputPanel>
                </apex:outputPanel>
                <br/>
                <apex:outputText style="font-style:italic" id="processTime" value="{!processTime}" escape="false"/><br/>
            </apex:pageblock> 
        
        
        	<!-- <c:ApprovalHistory_RelatedList parentId="{!id}" rendered="{!isApprovalHistory_RelatedList}" />  --> 
            <apex:pageblock id="ApprovalHistory" title="Approval History" tabStyle="Case" rendered="{!isApprovalHistory_RelatedList}">
                <apex:actionStatus id="status" >
                    <apex:facet name="start">
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel >
                            <apex:commandButton value="Reload" action="{!loadApprovalHistory}" rerender="ApprovalHistory" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus><br/>
                <apex:pageBlockTable value="{!listApprovalCase}" var="app" rendered="{!listApprovalCase.size != 0}">  
                    <apex:column headerValue="Date" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}">
                        <apex:outputText value="Approval Request Submitted" Rendered="{!app.isProcessInstance}"></apex:outputText>
                        <apex:outputText value="{0,date,dd/MM/yyyy hh:mm a}" Rendered="{!app.isProcessInstanceStep}"> <apex:param value="{!app.createdDate}" /> </apex:outputText>
                    </apex:column>
                    <apex:column headerValue="Status" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}"> 
                        <apex:outputText value="{!app.status}" Rendered="{!app.isProcessInstanceStep}"></apex:outputText>
                    </apex:column>
                    <apex:column headerValue="Assigned To" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}"> 
                        <apex:outputLink Rendered="{!app.isProcessInstanceStep}" value="/{!app.assignId}">{!app.assignName}</apex:outputLink> 
                    </apex:column>
                    <apex:column headerValue="Actual Approver" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}"> 
                        <apex:outputLink Rendered="{!app.isProcessInstanceStep}" value="/{!app.actualApproveId}">{!app.actualApproveName}</apex:outputLink> 
                    </apex:column>
                    <apex:column headerValue="Comments" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}"> 
                        <apex:outputText value="{!app.comments}" Rendered="{!app.isProcessInstanceStep}"></apex:outputText>
                    </apex:column>
                    <!-- <apex:column rendered="{!AND(!isInquiryAFICase,!isAFIComplaintCase,!isInquiryALICase, !isRequestALICase,!isALIComplaintCase,!isRequestAMFSCase)}"  headerValue="Overall Status" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}"> -->
                    <apex:column headerValue="Overall Status" style="{!IF(app.isProcessInstance == true,'background-color:#c0be72;border-color:#c0be72;','')}"> 
                        <apex:outputText style="background-color:{!app.colorStatus}; " value="{!app.approvalStatus}" Rendered="{!app.isProcessInstance}"> </apex:outputText>
                    </apex:column>
                </apex:pageBlockTable>
                <apex:outputLabel value="No records to display" rendered="{!listApprovalCase.size == 0}" styleClass="noRowsHeader"></apex:outputLabel>
            </apex:pageblock>
    </apex:form>
</apex:page>