<apex:page controller="Case_CustomPage_ctrl" showHeader="{!isConsole}" sidebar="{!isConsole}" action="{!redirect}">
    <apex:form id="CaseDetail" rendered="{!cs.data.id}">
    
    <style>
        .efhpTitle {
        font-size: 1.8em;
        font-weight: bold;
        color: rgb(73, 75, 78);
        padding-bottom: 7px;
        }
        .efhpRow {
        padding-bottom: 3px;
        }
        .efhpDescription {
        word-wrap: break-word;
        color: #494b4e;
        min-height: 25px;
        }
        .efhpValue a {
        color: #015ba7;
        text-decoration: none;
        overflow: hidden;
        }
        .vl {
        border-left: 1px solid #dbdfe0;
        height: 70px;
        }
    </style>
    <br/>
    <table cellspacing="0" cellpadding="0">
        <tr>
            <td width="50%">
                <table>
                    <tr>
                        <td style="vertical-align: middle;" rowspan="2"><img src="/img/icon/cases32.png"/></td>
                        <td><div><STRONG>Case</STRONG></div></td>
                    </tr>
                    <tr>
                        <td style="vertical-align: bottom;"><div class="efhpTitle">{!cs.data.subject}</div></td>
                    </tr>
                </table>
                <div class="efhpRow ">
                    <div class="efhpValue efhpDescription"> 
                        <apex:outputText value="{!cs.data.Titledescription}" />
                    </div>
                </div>
            </td>
            <td><div class="vl"/></td>
            <td style="padding:10px" width="50%">
                <div><STRONG>Customer</STRONG></div>
                <div class="efhpValue"><a href="/{!cs.data.contactId}">{!cs.data.contact_Name}</a></div>
                {!cs.data.contact_phone}<img src="/img/btn_nodial_inline.gif" width="16" height="10"/>
            </td>
        </tr>
    </table> 
    
    
    <!-- Visuaforce Components Fikri, untuk AMFS di ganti dengan record type yang ada di excel -->     
        
        	<!--Inquiry AFI-->    
            <c:Case_RecordDetailPage_AFI rendered="{!isInquiryAFICase}" />  
        
        	<!--Inquiry AMFS--> 
            <c:Case_RecordDetailPage_AMFS rendered="{!isInquiryAMFSCase}" /> 
        
        	<!--Inquiry ALI--> 
            <c:Case_RecordDetailPage_ALI rendered="{!isInquiryALICase}" /> 
        
        	<!--Complaint ALI --> 
            <c:Case_RecordDetailPage_ALIComplaintCase rendered="{!isALIComplaintCase}" /> 
        	
        	<!--Complaint AMFS --> 
            <c:Case_RecordDetailPage_AMFSComplaintCase rendered="{!isAMFSComplaintCase}" /> 
        	
        	<!--Complaint AFI --> 
            <c:Case_RecordDetailPage_AFIComplaintCase rendered="{!isAFIComplaintCase}" /> 
        	
        	<!--SocialPost AFI --> 
             <c:Case_RecordDetailPage_SocialPostAFI rendered="{!isSocialPostAFI}" /> 
        
        	<!--SocialPost AMFS --> 
            <c:Case_RecordDetailPage_SocialPostAMFS rendered="{!isSocialPostAMFS}" />
        
        	<!-- Request AFI -->
        	<c:Case_RecordDetailPage_RequestAFICase rendered="{!isRequestAFICase}"/>
        
        	<!-- Request ALI -->
        	<c:Case_RecordDetailPage_RequestALICase rendered="{!isRequestALICase}"/>
        
        	<!-- Request AMFS -->
        	<c:Case_RecordDetailPage_RequestAMFSCase rendered="{!isRequestAMFSCase}"/> 

        
        	<!-- Related List -->
        
        	<!-- <c:SocialPost_RelatedList parentId="{!id}" rendered="{!isSocialPost_RelatedList}" />  --> 
        	<apex:pageblock id="SocialPost" title="Social Post" tabStyle="Case" rendered="{!isSocialPost_RelatedList}">
                <apex:actionStatus id="status" >
                    <apex:facet name="start">
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel >
                            <apex:commandButton value="Reload" action="{!loadSocialPost}" rerender="SocialPost" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus><br/>
                <apex:pageBlockTable value="{!listDataSP}" var="po" rendered="{!listDataSP.size != 0}">                 
                    <!--apex:column HeaderValue="Action" width="60"> 
                        <apex:commandLink value="Edit" style="color:#015ba7;" action="{!editContact}" target="_parent" ><apex:param value="{!cont.id}" name="contactId"/> 
                        </apex:commandLink> 
                        &nbsp;|&nbsp; 
                        <apex:commandLink value="Del" onclick="return confirm('Are you sure?')" style="color:#015ba7;" action="{!deleteContact}" target="_parent"><apex:param value="{!cont.id}" name="contactId"/> 
                        </apex:commandLink>
                    </apex:column>-->
                    <apex:column headerValue="Name"><apex:outputLink value="/apex/SocialPost_RecordDetailPage?id={!po.id}">{!po.name}</apex:outputLink> </apex:column>
                    <apex:column headerValue="Social Persona"><apex:outputLink value="{!po.personaId}">{!po.handle}</apex:outputLink> </apex:column>
                    <apex:column headerValue="Headline" value="{!po.Headline}"/>
                    <apex:column headerValue="Who"><apex:outputLink value="{!po.whoId}">{!po.whoName}</apex:outputLink> </apex:column>
                    <apex:column headerValue="Message"> <apex:outputText escape="false" value="{!po.content}"/> </apex:column>
                    <apex:column headerValue="Post Tags" value="{!po.postTags}"/>
                    <apex:column headerValue="Posted Date"><apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!po.posted}" /> </apex:outputText></apex:column>
                    <apex:column headerValue="Created Date"><apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!po.createdDate}" /> </apex:outputText></apex:column>
                    <apex:column headerValue="Notes" value="{!po.Notes}"/>
                </apex:pageBlockTable>
                <apex:outputLabel value="No records to display" rendered="{!listDataSP.size == 0}" styleClass="noRowsHeader"></apex:outputLabel>
                
                <apex:outputPanel id="pagination">
                    <apex:actionFunction name="SocialPostAction" action="{!setLoadSocialPost}" rerender="out"/>
                    <apex:outputPanel rendered="{!IF(totalRow > 0, TRUE, FALSE)}">
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataFirst}" reRender="SocialPost">First</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">First</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataPrevious}" reRender="SocialPost">Previous&nbsp;</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">Previous</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:repeat value="{!list_page}" var="i" id="theRepeat">
                            <apex:commandLink action="{!getDataToPage}" status="stSearch" rendered="{!i != TEXT(current_page)}" value="{!i}" id="theValue" reRender="SocialPost">
                                <apex:param name="nickName"
                                            value="{!i}"
                                            assignTo="{!to_page}"/>
                            </apex:commandLink>
                            <apex:outputText rendered="{!i == TEXT(current_page)}" value="{!i}"/>
                            &nbsp;|&nbsp;
                        </apex:repeat>
                        
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataNext}" reRender="SocialPost">Next</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Next</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataLast}" reRender="SocialPost">Last</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Last</apex:outputText>
                    </apex:outputPanel>
                </apex:outputPanel>
                <br/>
                <apex:outputText style="font-style:italic" id="processTime" value="{!processTime}" escape="false"/><br/>
                
            </apex:pageblock>
         
            <!-- <c:Case_RelatedList_c parentId="{!id}" rendered="{!isCase_RelatedList_c}" /> --> 
            <apex:pageblock id="RelatedCases" title="Related Cases" tabStyle="Case" rendered="{!isCase_RelatedList_c}"  >
                <apex:actionStatus id="status" >
                    <apex:facet name="start">
                        <apex:outputPanel >
                            Loading...<br/>
                        </apex:outputPanel>
                    </apex:facet>
                    <apex:facet name="stop">
                        <apex:outputPanel >
                            <apex:commandButton value="Reload" action="{!loadCases_c}" rerender="RelatedCases" status="status" /><br/>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus>
                <br/>
                <!--AMFS-->
                <apex:pageBlockTable value="{!cases}" var="c" rendered="{!cases.size != 0}">
                    <apex:column headerValue="Case"><apex:outputLink value="/apex/Case_RecordDetailPage?id={!c.id}">{!c.caseNumber}</apex:outputLink> </apex:column>
                    <!-- <apex:column headerValue="Parent Case"><apex:outputLink value="/apex/Case_RecordDetailPage?id={!c.parentId}">{!c.Parent_Case_Number}</apex:outputLink> </apex:column> -->
                    <apex:column headerValue="Subject"><apex:outputLink value="/apex/Case_RecordDetailPage?id={!c.id}">{!c.subject}</apex:outputLink> </apex:column>
                    <apex:column headerValue="Priority" value="{!c.priority}"/>
                    
                    <!--apex:column headerValue="Case Type" value="{!c.case_Type_Config}"/>-->
                    <!--apex:column headerValue="Subject"><apex:outputLink value="/apex/Case_RecordDetailPage?id={!c.id}">{!c.subject}</apex:outputLink> </apex:column>-->
                    <apex:column headerValue="Date/Time Opened"><apex:outputText value="{0,date,M/d/yyyy HH:mm a}"> <apex:param value="{!c.createdDate}" /> </apex:outputText></apex:column>
                    <!-- <apex:column headerValue="Date/Time Closed"><apex:outputText value="{0,date,M/d/yyyy HH:mm a}"> <apex:param value="{!c.ClosedDate}" /> </apex:outputText></apex:column> -->
                    <apex:column headerValue="Status" value="{!c.status}"/>
                   	<apex:column headerValue="Owner"><apex:outputLink value="/{!c.ownerId}">{!c.case_owner}</apex:outputLink> </apex:column>
                    
                     <!-- <apex:column headerValue="Case Origin" value="{!c.origin}"/>
                    <apex:column headerValue="Case Source" value="{!c.Source}"/> -->
                </apex:pageBlockTable>
                <!--AFI--> 
                <apex:outputLabel value="No records to display" rendered="{!cases.size == 0}" styleClass="noRowsHeader"></apex:outputLabel>
                 
                <apex:outputPanel id="pagination">
                    <apex:actionFunction name="RelatedCasesAction" action="{!setLoadCases_c}" rerender="out"/>
                    <apex:outputPanel rendered="{!IF(totalRow > 0, TRUE, FALSE)}">
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataFirst}" reRender="RelatedCases">First</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">First</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != 1}" action="{!getDataPrevious}" reRender="RelatedCases">Previous&nbsp;</apex:commandLink>
                        <apex:outputText rendered="{!current_page == 1}">Previous</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:repeat value="{!list_page}" var="i" id="theRepeat">
                            <apex:commandLink action="{!getDataToPage}" status="stSearch" rendered="{!i != TEXT(current_page)}" value="{!i}" id="theValue" reRender="RelatedCases">
                                <apex:param name="nickName"
                                            value="{!i}"
                                            assignTo="{!to_page}"/>
                            </apex:commandLink>
                            <apex:outputText rendered="{!i == TEXT(current_page)}" value="{!i}"/>
                            &nbsp;|&nbsp;
                        </apex:repeat>
                        
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataNext}" reRender="RelatedCases">Next</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Next</apex:outputText>
                        &nbsp;|&nbsp;
                        <apex:commandLink status="stSearch" rendered="{!current_page != total_page}" action="{!getDataLast}" reRender="RelatedCases">Last</apex:commandLink>
                        <apex:outputText rendered="{!current_page == total_page}">Last</apex:outputText>
                    </apex:outputPanel>
                </apex:outputPanel>
                <br/>
                <apex:outputText style="font-style:italic" id="processTime" value="{!processTime}" escape="false"/><br/>
                
            </apex:pageblock>
        
        	<!-- <c:CaseMilestone_RelatedList parentId="{!id}" rendered="{!isCaseMilestone_RelatedList}" />  -->
