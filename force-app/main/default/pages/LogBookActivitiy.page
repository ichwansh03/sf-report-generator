    function sendRecieptEmail(queue,touchPoint,dateLog,emailPP,emailNonPP,LogId) {
        console.log('dateLog : '+dateLog);
        dateLog = new Date(dateLog);
        console.log('date length :'+dateLog.getDate().length);
        var day = (dateLog.getDate()).length > 1? (dateLog.getDate()) : '0'+(dateLog.getDate());
        var month = (dateLog.getMonth()+1).length > 1? (dateLog.getMonth()+1) : '0'+(dateLog.getMonth()+1);
        var year = dateLog.getFullYear();
        dateLog = year+'-'+month+'-'+day;
        var tabLabel ='Log Book Activity';
        
        console.log('emailPP = '+emailPP);
        console.log('emailNonPP = '+emailNonPP);
        if ((emailPP == null || emailPP == '') && (emailNonPP == null || emailNonPP == '')) {
            alert('Email PP ataupun Non PP belum diinput, silahkan mengirimkan e-receipt menggunakan metode lain');
            return false;
        }
        
        var conf = confirm("Are You Sure Want to Send?");
        if(conf) {
            
            console.log('masuk');
            console.log('queue = '+queue);
            console.log('touchPoint = '+touchPoint);
            console.log('dateLog = '+dateLog); 
            sendNotif(queue, touchPoint, dateLog,'Email',LogId);
            
            searchLog();
            
            return false;
        }
    }
    
