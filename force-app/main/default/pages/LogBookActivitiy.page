    function openPDF(queue,touchPoint,dateLog) {
        console.log('dateLog : '+dateLog);
        dateLog = new Date(dateLog);
        console.log('date length :'+dateLog.getDate().length);
        var day = (dateLog.getDate()).length > 1? (dateLog.getDate()) : '0'+(dateLog.getDate());
        var month = (dateLog.getMonth()+1).length > 1? (dateLog.getMonth()+1) : '0'+(dateLog.getMonth()+1);
        var year = dateLog.getFullYear();
        dateLog = year+'-'+month+'-'+day;
        var recordUrl ='/apex/LogBookActivitiyPDF?queue='+ queue+'&touchPoint='+touchPoint+'&dateLog='+dateLog;
        var tabLabel ='Log Book Activity';
        
        if (sforce.console.isInConsole()) {
            callOpenSubtab(recordUrl, tabLabel);
        } else {
            javascript:var x=window.open(recordUrl,'_blank');
        }
    }
    
    function openCaseDetail(id, caseNo) {            
        var recordUrl ='/'+ id;
        var tabLabel = caseNo;
        
        if (sforce.console.isInConsole()) {
            callOpenSubtab(recordUrl, tabLabel);
        } else {
            javascript:var x=window.open(recordUrl,'_blank');
        }
    }
    
    // console method for opening tab
    function callOpenSubtab(recordUrl, tabLabel) {
        
        var openSuccess = function(result) {
            //Report whether we succeeded in opening the subtab
            if (result.success == true) {
                console.log('subtab successfully opened');
            } else {
                console.log('subtab cannot be opened');
            }
        };
        sforce.console.openPrimaryTab(null, recordUrl, true, tabLabel, openSuccess, tabLabel);
    }
    
    function convert(str) {
        var date = new Date(str),
            mnth = ("0" + (date.getMonth() + 1)).slice(-2),
            day = ("0" + date.getDate()).slice(-2);
        return [date.getFullYear(), mnth, day].join("-");
    }
    
