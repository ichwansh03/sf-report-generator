    <apex:form id="logBookActivitiyForm">
        <!-- TIM MII AT 27/06/2022 --> 
        <apex:actionFunction name="sendNotif" action="{!sendNotif}" rerender="none">
            <apex:param name="paramQueue" assignTo="{!paramQueue}" value="" />
            <apex:param name="paramTouchPoint" assignTo="{!paramTouchPoint}" value="" />
            <apex:param name="paramDateLog" assignTo="{!paramDateLog}" value="" /> 
            <apex:param name="sendType" assignTo="{!sendType}" value="" /> 
            <apex:param name="lbdId" assignTo="{!lbdId}" value="" />  
        </apex:actionFunction>  
        
        <!-- <apex:actionFunction name="sendEmailtoDipcad" action="{!sendEmailtoDipcad}" rerender="none">
            <apex:param name="lbdId" assignTo="{!lbdId}" value="" />  
        </apex:actionFunction> -->
        
        <apex:actionFunction name="searchLog" action="{!inquirySearch}" reRender="logBookTable, msg" status="pageStatus" > 
        </apex:actionFunction>  
        <!-- END OF TIM MII AT 27/06/2022 -->
        
        <apex:sectionHeader title="{!$ObjectType.Log_Book_Activitiy__c.label}"/>
        <apex:pagemessages id="msg"/>
        <apex:pageBlock >
            <apex:pageBlockSection columns="2">
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Date" for="logDate"/>
                    <apex:inputText value="{!logBookDate}" id="logDate"/>
                </apex:pageblockSectionItem>
                
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Policy Number" for="policyNo"/>
                    <apex:inputText id="policyNo" value="{!logBookDetail.Policy_Number__c}"/>
                </apex:pageblockSectionItem>
                
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Touch Point" for="touchPoint"/>
                    <apex:selectList value="{!logBook.Touch_Point__c}" size="1" id="touchPoint">
                        <apex:selectOptions value="{!touchPoints}"/>
                    </apex:selectList>
                </apex:pageblockSectionItem>
                
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Policy Name Holder" for="policyNmHolder"/>
                    <apex:inputText id="policyNmHolder" value="{!logBookDetail.Policy_Name_Holder__c}"/>
                </apex:pageblockSectionItem>
                
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Queue Number" for="queueNo"/>
                    <apex:inputText id="queueNo" value="{!logBook.Queue_No__c}"/>
                </apex:pageblockSectionItem>
                
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Customer Name" for="custName"/>
                    <apex:inputText id="custName" value="{!logBookDetail.Customer_Name__c}"/>
                </apex:pageblockSectionItem>
                
                <apex:pageblockSectionItem />
                
                <apex:pageblockSectionItem >
                    <apex:outputLabel value="Kind Of Transaction" for="kindOfTrx"/>
                    <apex:selectList value="{!logBookDetail.Kind_Of_Transaction__c}" size="1" id="kindOfTrx">
                        <apex:selectOptions value="{!kindOfTransaction}"/>
                    </apex:selectList>
                </apex:pageblockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection columns="1" >
                <apex:pageBlockSectionItem >
                    <apex:outputPanel >
                        <div style="text-align: center">
                            <apex:commandLink id="searchLog" styleClass="btn" value="Search" action="{!inquirySearch}" reRender="logBookTable, msg" status="pageStatus" onclick="checkTimeout();"/>
                        </div>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection columns="1">
                <apex:actionStatus id="pageStatus">
                    <apex:facet name="start">
                        <apex:outputPanel >
                            <div style="text-align: center">
                                <img src="/img/loading32.gif" width="25" height="25" />
                            </div>
                        </apex:outputPanel>
                    </apex:facet>
                </apex:actionStatus>
                <apex:pageBlockTable value="{!listDetail}" var="activitiy" border="1" id="logBookTable">
                    <apex:column headerValue="Date">
                        <apex:outputField id="bookDate" value="{!activitiy.Log_Book_Activitiy__r.Log_Book_Date__c}"/>
                    </apex:column>
                    <apex:column headerValue="Queue Number" >
                        <apex:outputField value="{!activitiy.Log_Book_Activitiy__r.Queue_No__c}"/>
                    </apex:column>
                    <apex:column headerValue="Policy Number" >
                        <apex:commandLink value="{!activitiy.Policy_Number__c}" onclick="openLogbookDetail('{!activitiy.id}', 'd');"/>
                    </apex:column>
                    <apex:column headerValue="Policy Name Holder">
                        <apex:outputField value="{!activitiy.Policy_Name_Holder__c}"/>
                    </apex:column>
                    <apex:column headerValue="Customer Name">
                        <apex:outputField value="{!activitiy.Customer_Name__c}"/>
                    </apex:column>
                    <apex:column headerValue="Transaction Type">
                        <apex:outputField value="{!activitiy.Kind_Of_Transaction__c}"/>
                    </apex:column>
                    <apex:column headerValue="Case No">
                        <apex:commandLink value="{!activitiy.Log_Case__r.CaseNumber}" onclick="openCaseDetail('{!activitiy.Log_Case__c}', '{!activitiy.Log_Case__r.CaseNumber}');"/>
                    </apex:column>
                    <apex:column headerValue="Status Send"> 
                        <span>  
                            <apex:outputField value="{!activitiy.Log_Book_Activitiy__r.Status_send__c}" rendered="{!activitiy.Department__c != 'CCC'}"/>
                            <apex:outputLabel rendered="{!AND(activitiy.Log_Book_Activitiy__r.Status_send__c != null, activitiy.Department__c != 'CCC')}">&nbsp;-&nbsp;</apex:outputLabel>
                            <apex:outputField value="{!activitiy.Log_Book_Activitiy__r.Sequence_SMS__c}" rendered="{!AND(activitiy.Log_Book_Activitiy__r.Status_send__c == 'SMS', activitiy.Department__c != 'CCC')}"/>
                            <apex:outputField value="{!activitiy.Log_Book_Activitiy__r.Sequence_Email__c}" rendered="{!AND(activitiy.Log_Book_Activitiy__r.Status_send__c == 'Email', activitiy.Department__c != 'CCC') }"/>
                        </span> 
                    </apex:column>
                    <apex:column headerValue="Metadata">
                        <apex:outputText value="Pending" rendered="{!ISBLANK(activitiy.Status_to_Metadata__c)}" />
                        <apex:outputField value="{!activitiy.Status_to_Metadata__c}" rendered="{!NOT(ISBLANK(activitiy.Status_to_Metadata__c))}" />
                    </apex:column>
                    <apex:column headerValue="Modified Date">
                        <apex:outputField value="{!activitiy.LastModifiedDate}"/>
                    </apex:column>
                    <apex:column headerValue="Action">
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="Open Contact" onclick="openContact('{!activitiy.Contact_Policy__c}','{!activitiy.Customer_Name__c}');" />
                        &nbsp;&nbsp;
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="Edit" onclick="openLogbookDetail('{!activitiy.id}', 'e');" />
                        &nbsp;&nbsp;
                        <!-- MII hana 15/11/22  -->
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="EditQ" action="{!URLFOR($Page.CreateLogBookActivitiy, null, [type='Walk-In', logbookactivitiyid=activitiy.log_book_activitiy__r.id, policyNo=activitiy.Policy_Number__c,editQ='true'], true)}"/>
                        
                        &nbsp;&nbsp;
                        
                        
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="ICF" onclick="openICF('{!activitiy.Policy_Number__c}','{!activitiy.Log_Book_Activitiy__r.Queue_No__c}');"/>
                        <apex:variable value="{!activitiy.Log_Book_Activitiy__r.Log_Book_Date__c}" var="logDates"/>
                        &nbsp;&nbsp;
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="Preview Receipt" onclick="openPDF('{!activitiy.Log_Book_Activitiy__r.Queue_No__c}','{!activitiy.Log_Book_Activitiy__r.Touch_Point__c}','{!activitiy.Log_Book_Activitiy__r.Log_Book_Date__c}');"
                                          rendered="{!activitiy.Department__c != 'CCC'}">
                        </apex:commandLink>
                        &nbsp;&nbsp; 
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="Send Email" onclick="sendRecieptEmail('{!activitiy.Log_Book_Activitiy__r.Queue_No__c}','{!activitiy.Log_Book_Activitiy__r.Touch_Point__c}','{!activitiy.Log_Book_Activitiy__r.Log_Book_Date__c}','{!activitiy.Email_PP__c}','{!activitiy.Email_Non_PP__c}','{!activitiy.id}');"
                                          
                                          rendered="{!activitiy.Department__c != 'CCC'}" reRender="logBookTable">
                        </apex:commandLink> 
                        &nbsp;&nbsp;
                        <!-- <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="Resend Email to DIPCAD" onclick="sendtoDipcad('{!activitiy.id}');"
                                          rendered="{!activitiy.Department__c != 'CCC'}" reRender="logBookTable">
                        </apex:commandLink> 
                        &nbsp;&nbsp; -->
                        <apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
                                          value="Send SMS" onclick="sendRecieptSMS('{!activitiy.Log_Book_Activitiy__r.Queue_No__c}','{!activitiy.Log_Book_Activitiy__r.Touch_Point__c}','{!activitiy.Log_Book_Activitiy__r.Log_Book_Date__c}','{!activitiy.Phone_PP__c}','{!activitiy.Phone_Non_PP__c}','{!activitiy.id}');"
                                          rendered="{!activitiy.Department__c != 'CCC'}" reRender="logBookTable">
                        </apex:commandLink>
                        
                        <!-- action="{!sendNotif}" -->
