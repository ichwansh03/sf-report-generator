<apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
value="Save Receipt" action="{!previewPDF}">
<apex:param name="queue" value="{!activitiy.Log_Book_Activitiy__r.Queue_No__c}"/>
<apex:param name="touchPoint" value="{!activitiy.Log_Book_Activitiy__r.Touch_Point__c}"/>
<apex:param name="isInsert" value="true"/>
</apex:commandLink>
-->
                        <!--
<apex:commandLink styleClass="btn" style="text-decoration:none;padding:1px;"
value="Print Receipt" action="{!generatePDF}" target="_blank">
</apex:commandLink>
-->
                    </apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>
            
            <apex:pageBlockButtons >
                <apex:commandButton value="New Walk In" action="{!URLFOR($Page.CreateLogBookActivitiy, null, [type='Walk-In'], true)}" />
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>
</apex:page>