<apex:page controller="SurveyTaken_CustomPage_ctrl" showHeader="true" sidebar="true" action="{!redirect}">
     <style>
        .efhpTitle {
        font-size: 1.8em;
        font-weight: bold;
        color: rgb(73, 75, 78);
        padding-bottom: 7px;
        }
        .efhpRow {
        padding-bottom: 3px;
        }
        .efhpDescription {
        word-wrap: break-word;
        color: #494b4e;
        min-height: 25px;
        }
        .efhpValue a {
        color: #015ba7;
        text-decoration: none;
        overflow: hidden;
        }
        .vl {
        border-left: 1px solid #dbdfe0;
        height: 70px;
        }
    </style>
   
    <table>
        <tr>
            <td style="vertical-align: middle;" rowspan="2"><img src="/img/icon/hands32.png"/></td>
            <td><div><STRONG>Survey Taken</STRONG></div></td>
        </tr>
        <tr>
            <td style="vertical-align: bottom;"><div class="efhpTitle">{!detail.data.name}</div></td>
        </tr>
    </table>
    
    <apex:form id="formId">
        <apex:pageMessages />        
        <apex:pageBlock id="STDetail" mode="maindetail" title="">
            <apex:pageBlockSection title="Survey Taken Detail" columns="2" collapsible="true" showHeader="true"> 
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="ID"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.name}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Owner"></apex:outputLabel>
                    <apex:outputPanel ><img style="vertical-align: bottom;" width="15" height="15" src="/profilephoto/005/T"/>&nbsp;<apex:outputLink value="/{!detail.data.ownerId}" >{!detail.data.ownerName}</apex:outputLink>  </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Survey Taken By Contact"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!detail.data.contact_c}" >{!detail.data.ContactName}</apex:outputLink>  </apex:outputPanel>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Entity"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.entity_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c != 'AMFS',true,false)}">
                    <apex:outputLabel value="Ext Id"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.ext_Id_c}"/>
                </apex:pageBlockSectionItem> 
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c == 'AMFS',true,false)}">
                    <apex:outputLabel value="Case"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!detail.data.case_c}" >{!detail.data.caseNumber}</apex:outputLink>  </apex:outputPanel> 
                </apex:pageBlockSectionItem> 
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Type"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.type_c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockSection columns="1" collapsible="false" showHeader="false"> 
                
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c == 'AMFS',true,false)}">
                    <apex:outputLabel value="Survey"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!detail.data.survey_c}" >{!detail.data.surveyName}</apex:outputLink>  </apex:outputPanel> 
                </apex:pageBlockSectionItem> 
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c == 'AMFS',true,false)}">
                    <apex:outputLabel value="Taken"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.taken_c}"/> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c == 'AMFS',true,false)}">
                    <apex:outputLabel value="Survey Taken By User"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!detail.data.createdById}" >{!detail.data.createdName}</apex:outputLink>  </apex:outputPanel> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c == 'AMFS',true,false)}">
                    <apex:outputLabel value="Ext Id"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.ext_Id_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Negative Feedback"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.negative_Feedback_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Agent Name"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.agent_Name_c}"/> 
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Policy No"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.policy_No_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Email & SMS Log"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="{!detail.data.email_SMS_Log_c}" > {!detail.data.email_SMS_Log_name} </apex:outputLink></apex:outputPanel>
                </apex:pageBlockSectionItem>
                <!-- <apex:pageBlockSectionItem >
                    <apex:outputLabel value="ICF Non CCC"></apex:outputLabel>
                    
                    <apex:outputPanel ><apex:outputLink value="{!detail.data.icF_Non_CCC_c}" > {!detail.data.ICFNonCCCName} </apex:outputLink></apex:outputPanel> 
                </apex:pageBlockSectionItem> -->
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="MOT"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.moT_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Insurance Type"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.insurance_Type_c}"/>
                </apex:pageBlockSectionItem>
               <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Email SMS Log Created Date"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputText value="{0,date,M/d/yyyy}"> <apex:param value="{!detail.data.email_SMS_Log_Created_Date_c}" /> </apex:outputText>
                    </apex:outputLabel> 
                </apex:pageBlockSectionItem> 
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Positive Feedback"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.positive_Feedback_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Status Response"></apex:outputLabel>
                    <apex:outputText value="{!detail.data.status_Response_c}"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem rendered="{!IF(detail.data.entity_c == 'AMFS',true,false)}">
                    <apex:outputLabel value="Log Book Activitiy Detail"></apex:outputLabel>
                    <apex:outputPanel ><apex:outputLink value="/{!detail.data.log_Book_Activitiy_Detail_c}" > {!detail.data.logBookDetail} </apex:outputLink></apex:outputPanel> 
                </apex:pageBlockSectionItem> 
            </apex:pageBlockSection>
            <apex:pageBlockSection columns="2" collapsible="false" showHeader="false">  
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Created By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputPanel > 
                            <apex:outputLink value="/{!detail.data.createdById}" >{!detail.data.createdName}</apex:outputLink>  , &nbsp;
                            <apex:outputText value="{0,date,M/d/yyyy h:m a}"> <apex:param value="{!detail.data.createdDate}" /> 
                       </apex:outputText>
                        </apex:outputPanel> 
                    </apex:outputLabel> 
                    
                </apex:pageBlockSectionItem> 
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Last Modified By"></apex:outputLabel>
                    <apex:outputLabel >
                        <apex:outputPanel >
                            <apex:outputLink value="/{!detail.data.lastModifiedById}" >{!detail.data.modifiedName}</apex:outputLink>, &nbsp;
                            <apex:outputText value="{0,date,M/d/yyyy hh:mm a}"> <apex:param value="{!detail.data.lastModifiedDate}" /> 
                       </apex:outputText></apex:outputPanel> 
                    </apex:outputLabel> 
                </apex:pageBlockSectionItem> 
                
               <!-- <div class="pbBottomButtons">
                    <table border="0" cellpadding="0" cellspacing="0">
                        <tbody>
                            <tr>
                                <td class="pbTitle">
                                    <img src="/img/s.gif" alt="" width="1" height="1" class="minWidth" title=""/>
                                </td>
                                <td class="pbButtonb" id="bottomButtonRow">
