                </div> -->
            </apex:pageBlockSection> 
        </apex:pageBlock>
        <apex:pageblock id="surveyResponse" title="Survey_Responses" tabStyle="Case">  
            <apex:pageBlockTable value="{!listSurveyResponse}"  var="lst"> 

                <apex:column headerValue="Response ID"><apex:outputLink value="/{!lst.id}" >{!lst.Name}</apex:outputLink> </apex:column> 
                <apex:column headerValue="Survey" value="{!lst.Survey__c}"/>  
                 <apex:column headerValue="Answer 1" value="{!lst.Answer_1__c}"/>  
                 <apex:column headerValue="Question 1" value="{!lst.Question_1__c}"/>  
                 <apex:column headerValue="Answer 2" value="{!lst.Answer_2__c}"/>  
                 <apex:column headerValue="Question 2" value="{!lst.Question_2__c}"/>  
                 <apex:column headerValue="Negative Answer" value="{!lst.Negative_Answer__c}"/>  
                 <apex:column headerValue="Negative Question" value="{!lst.Negative_Question__c}"/>  
                 <apex:column headerValue="Negative Result" value="{!lst.Negative_Result__c}"/>  
            </apex:pageBlockTable>  
        </apex:pageblock> 
    </apex:form>
</apex:page>