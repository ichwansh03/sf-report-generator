                                    <input value="Delete" class="btn" name="del" title="Delete" type="button" onclick="if ((Modal.confirm &amp;&amp; Modal.confirm('Are you sure?')) || (!Modal.confirm &amp;&amp; window.sfdcConfirm('Are you sure?'))) navigateToUrl('/setup/own/deleteredirect.jsp?delID=a0N0K00002l72WG&amp;retURL=%2Fa0N%2Fo&amp;_CONFIRMATIONTOKEN=VmpFPSxNakF5TVMweE1TMHhOVlF3Tmpvd016bzBPQzQ1TWpCYSxzMjd5SzhBRzEyaWpzeUtWUWNfaDlTLE5HTmhOamM1&amp;failRetURL=%2Fa0N0K00002l72WG','DETAIL','del');"/>
                                    <input value=" Clone " class="btn" name="clone" title="Clone" type="button" onclick="navigateToUrl('/a0N0K00002l72WG/e?clone=1&amp;retURL=%2Fa0N0K00002l72WG','DETAIL','clone');"/>
                                </td>
