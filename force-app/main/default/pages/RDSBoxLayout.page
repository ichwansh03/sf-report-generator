<apex:page controller="RDSBoxController">
    <apex:form >
        <apex:pageMessages />
        <script>
        
        function handleSearch(event) {
        	if (event.keyCode == 13) {
                event.preventDefault();
            	SearchAction()
         	}
        }
        </script>
        <apex:pageBlock id="rdsList">
            <apex:pageBlockSection columns="4">
                <apex:outputText value="No.Box Documentation" style="font-size: 18px; font-weight: bold;"/>
                <apex:outputText ></apex:outputText>
                <apex:outputText ></apex:outputText>
                <apex:commandButton id="btnExport" value="Export" action="{!exportRDS}" style="font-size: 12px; padding: 5px 10px; height: 40px; width: 100px;"/>
            </apex:pageBlockSection>
            <br/>
            <apex:actionStatus id="actStatus">
                <apex:facet name="start" >
                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.25; z-index: 1000; background-color: black;">
                        &nbsp;
                    </div>
                    <div style="position: fixed; left: 0; top: 0; bottom: 0; right: 0; z-index: 1001; margin: 15% 50%">
                        <div style="display: inline-block; padding: 2px; background-color: #fff; width: 125px;">
                            <img src="/img/loading.gif" style="float: left; margin: 8px;" />
                            <span style="display: inline-block; padding: 10px 0px;">Please Wait...</span>
                        </div>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <apex:pageBlockSection columns="4">
                <apex:pageBlockSectionItem >
                    Show entries:
                    <apex:selectList id="selectSize" value="{!selectEntries}" size="1">
                        <apex:selectOption itemValue="25" itemLabel="25"/>
                        <apex:selectOption itemValue="50" itemLabel="50"/>
                        <apex:selectOption itemValue="100" itemLabel="100"/>
                        <apex:actionSupport event="onchange" action="{!entries}" reRender="rdsList" status="actStatus"/>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                <apex:outputText />
                <apex:outputText />
                <apex:pageBlockSectionItem >
                    <apex:inputText value="{!searchRDS}" id="search" html-placeholder="Search by Polis/Antrian" onkeydown="handleSearch(event)"/>
                    <apex:actionFunction name="SearchAction" action="{!searchRDSBox}" reRender="rdsList" status="actStatus"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <br/>
            <apex:pageBlockTable value="{!boxs}" var="rds">
                <apex:column value="{!rds.Policy_No__c}" headerValue="No.Polis"/>
                <apex:column value="{!rds.Queue_No__c}" headerValue="No.Antrian"/>
                <apex:column value="{!rds.No_Box__c}" headerValue="No.Box"/>
            </apex:pageBlockTable>
            <br/>
            <apex:panelGrid columns="8" style="line-height:2em" border="1">
                <apex:commandButton status="notifyRDS" reRender="rdsList" value="|<" title="First" action="{!first}" disabled="{!NOT(listRDS.hasPrevious)}" styleClass="btn"/>
                <apex:commandButton status="notifyRDS" reRender="rdsList" value="<<" title="Previous" action="{!previous}" disabled="{!NOT(listRDS.hasPrevious)}" styleClass="btn"/>
                <apex:commandButton status="notifyRDS" reRender="rdsList" value=">>" title="Next" action="{!next}" styleClass="btn"/>
                <apex:commandButton status="notifyRDS" reRender="rdsList" value=">|" title="Last" action="{!last}" disabled="{!NOT(listRDS.hasNext)}" styleClass="btn"/>
                <apex:actionStatus id="notifyRDS" startText="Loading..." stopText=" "></apex:actionStatus>
                <apex:outputText >
                    Page {!pageNumber} to
                    {!listRDS.pageSize} of {!resultSize} records
                </apex:outputText>
            </apex:panelGrid>
        </apex:pageBlock>
    </apex:form>
</apex:page>