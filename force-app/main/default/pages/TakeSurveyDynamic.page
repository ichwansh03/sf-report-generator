    //Added by Dimas Support MII 23/04/2025
    function enforceMaxLength(field, maxLength) {
        if (field.value.length > maxLength) {
            field.value = field.value.substring(0, maxLength);
        }
    }
    
    function updateCharCount(field, maxLength) {
        var countSpan = document.getElementById('charCount');
        countSpan.textContent = field.value.length;
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        const textarea = document.querySelector('.comment-box');
        updateCharCount(textarea, 255);
    });
         
