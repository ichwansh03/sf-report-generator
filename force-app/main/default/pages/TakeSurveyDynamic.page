        function syncAnswer(elem) {
            var ansRowElementName = elem.id;
            var ansRowElementIndex = ansRowElementName.replace(/\D/g, ''); 
            //var ansRowElementIndex = ansRowElementName.substring(8,9);
            var ansRowElementValue = elem.value;
            
            console.log('ansRowElementName:',ansRowElementName);
            console.log('ansRowElementIndex:',ansRowElementIndex);
            console.log('ansRowElementValue:',ansRowElementValue);
            var ansOriginalElementId = 'takeSurveyDynamic:theForm:pbMainQuestion:aQPreview:' + ansRowElementIndex + ':pblock:rdSelectRow';
            console.log('ansOriginalElementId:',ansOriginalElementId);
            $("input[type='radio'][name$='" + ansOriginalElementId + "'][value='" + ansRowElementValue + "']").prop('checked',true);
            
            var getDependency = $("#setDisplay"+ansRowElementIndex).attr("name").substring(4);
            console.log('val:',getDependency);
            if(getDependency == 'true'){
                if(ansRowElementValue <= 6){
                    NextRowElementIndex = parseInt(ansRowElementIndex) + 1;
                    NextRowElementIndex2 = parseInt(ansRowElementIndex) + 2;
                    NextRowElementIndex3 = parseInt(ansRowElementIndex) + 3;
                }
                if(ansRowElementValue == '7' || ansRowElementValue == '8'){
                    NextRowElementIndex = parseInt(ansRowElementIndex) + 2;
                    NextRowElementIndex2 = parseInt(ansRowElementIndex) + 1;
                    NextRowElementIndex3 = parseInt(ansRowElementIndex) + 3;
                }
                if(ansRowElementValue > 8){
                    NextRowElementIndex = parseInt(ansRowElementIndex) + 3;
                    NextRowElementIndex2 = parseInt(ansRowElementIndex) + 1;
                    NextRowElementIndex3 = parseInt(ansRowElementIndex) + 2;
                }
                $("#setDisplay"+NextRowElementIndex).css("display", "block");
                $("#setDisplay"+NextRowElementIndex2).css("display", "none");
                $("#setDisplay"+NextRowElementIndex3).css("display", "none");
            }
        }  
        	
