    function checkOptionOthers(elem) { 
        var ansRowElementValue = elem.value;
        console.log('elem:',elem);
        console.log('ansRowElementValue:',ansRowElementValue);
        
        if(ansRowElementValue == '0' || ansRowElementValue == '1') {
            $("#setDisplay4").css("display", "block");
            $("#questionNumber5").text('6.');
            $("#questionNumber6").text('7.');
