<apex:page id="pgSurveyManagerPage" standardController="Survey__c" extensions="SurveyManagerController" showHeader="true">
    <apex:stylesheet value="{!$Page.labs_survey_css}" />
    <script src="/soap/ajax/34.0/connection.js"></script>
    <script id="clientEventHandlersJS" language="javascript">
        function readURL(inputParam, fieldParam) {
            if (inputParam.files && inputParam.files[0]) {
                var fReader = new FileReader();
                var imgElementId = 'pgSurveyManagerPage:formConfigureId:pbConfigureId:pbAnswerImage:' + fieldParam;
                var imgElement = document.getElementById(imgElementId);
                fReader.onload = function (e) {
                    imgElement.src = e.target.result;
                }
                
                fReader.readAsDataURL(inputParam.files[0]);
            }
        }
        
        function doUpdateImage(param, field) {
            readURL(param, field);
        }
    </script>
    <style>
        .activeTab {background-color: #236FBD; color:white; background-image:none}
        .inactiveTab { background-color: lightgrey; color:black; background-image:none}
    </style>
    
    <div id="labs_container">
        <h2><apex:outputtext value="{!Survey__c.Name}" id="surveyTitle" /></h2>
    </div>
    
    <!-- TAB PANEL --> 
    <apex:tabPanel switchType="client" selectedTab="name1" id="SurveyTabPanel" tabClass="activeTab" inactiveTabClass="inactiveTab">
        <!-- SHARE -->
        <apex:tab label="{!$Label.LABS_SF_Share}" name="name1" id="tabOne">
            <c:viewShareSurveyComponent surveyId="{!Survey__c.Id}" id="shareComp" />
            <apex:actionSupport event="ontabenter" rerender="shareComp"/>
        </apex:tab>
        
        <!-- EDIT -->
        <apex:tab label="{!$Label.LABS_SF_Edit}" name="name4" id="tabFour">
            <apex:iframe src="SurveyPage?id={!Survey__c.Id}" scrolling="true" id="editSurvey" />                           
        </apex:tab>
        
        <!-- CONFIGURE -->
        <apex:tab label="{!$Label.LABS_SF_HeaderAndThankYou}" name="name2" id="tabTwo">
            <apex:actionSupport event="ontabenter" rerender="errors, pbSurveyInformationId"/>
            <apex:form id="formConfigureId">
                <apex:pageBlock mode="edit" id="pbConfigureId">
                    <apex:pageBlockButtons >
                        <apex:commandButton action="{!save}" id="saveButton" value="{!$Label.LABS_SF_Save}"/>
                    </apex:pageBlockButtons>
                    
                    <apex:actionRegion id="arId" renderRegionOnly="false">
                    <apex:pageMessages id="errors"/>
                    <apex:pageBlockSection id="pbSurveyInformationId" columns="1" title="Survey Configuration" showHeader="true" >
                        
                        <apex:inputField value="{!Survey__c.Name}" />
                        <apex:inputField value="{!Survey__c.Hide_Survey_Name__c}" />
                        <apex:outputField value="{!Survey__c.Status__c}" />
                        <apex:outputField value="{!Survey__c.RecordTypeId}" />
                        <apex:outputField value="{!Survey__c.Current_Survey__c}" rendered="{!isMaster == true}" />
                        <apex:outputField value="{!Survey__c.Master_Survey__c}" rendered="{!isMaster == false}" />
                        <apex:outputField value="{!Survey__c.Entity__c}" rendered="{!isMaster == true}" />
                        <apex:inputField value="{!Survey__c.Entity__c}" rendered="{!isMaster == false}" />  
                        <apex:outputField value="{!Survey__c.Survey_Type__c}" rendered="{!isMaster == true}" />
                        <apex:inputField value="{!Survey__c.Survey_Type__c}" rendered="{!isMaster == false}" >
                        <apex:inputField value="{!Survey__c.Format_Skala__c}"/>

                            <apex:actionSupport event="onchange" action="{!refreshMasterSurvey}" reRender="errors, pbSurveyInformationId" status="status" immediate="false" />
                        </apex:inputField>
                        <apex:inputField value="{!Survey__c.Answer_Type__c}" />
                    </apex:pageBlockSection>
                    </apex:actionRegion>
                    
                    <apex:pageBlockSection columns="1" >
                        <apex:inputField value="{!Survey__c.Survey_Header__c}" />
                        <apex:inputField value="{!Survey__c.Thank_You_Text__c}" />
                        <apex:inputField value="{!Survey__c.Survey_Container_CSS__c}"  style="width: 70%;" rendered="{!editCSS}"/>
                    </apex:pageBlockSection>
                    
                    <apex:pageBlockSection columns="2" id="pbAnswerImage" title="Answer Image" showHeader="true">
                        <apex:panelGrid columns="3" id="panelAns1">
                            <apex:outputLabel value="Answer 1"/>
                            <apex:image id="img1" value="{!if(imgURL1!=null, imgURL1, $Resource.no_image)}" url="{!if(imgURL1!=null, imgURL1, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId1" value="{!imgValue1}" onchange="doUpdateImage(this, 'img1')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns6">
                            <apex:outputLabel value="Answer 6 " style="margin-right: 10px;"/>
                            <apex:image id="img6" value="{!if(imgURL6!=null, imgURL6, $Resource.no_image)}" url="{!if(imgURL6!=null, imgURL6, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId6" value="{!imgValue6}" onchange="doUpdateImage(this, 'img6')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns2">
                            <apex:outputLabel value="Answer 2"/>
                            <apex:image id="img2" value="{!if(imgURL2!=null, imgURL2, $Resource.no_image)}" url="{!if(imgURL2!=null, imgURL2, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId2" value="{!imgValue2}" onchange="doUpdateImage(this, 'img2')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns7">
                            <apex:outputLabel value="Answer 7 " style="margin-right: 10px;"/>
                            <apex:image id="img7" value="{!if(imgURL7!=null, imgURL7, $Resource.no_image)}" url="{!if(imgURL7!=null, imgURL7, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId7" value="{!imgValue7}" onchange="doUpdateImage(this, 'img7')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns3">
                            <apex:outputLabel value="Answer 3"/>
                            <apex:image id="img3" value="{!if(imgURL3!=null, imgURL3, $Resource.no_image)}" url="{!if(imgURL3!=null, imgURL3, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId3" value="{!imgValue3}" onchange="doUpdateImage(this, 'img3')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns8">
                            <apex:outputLabel value="Answer 8 " style="margin-right: 10px;"/>
                            <apex:image id="img8" value="{!if(imgURL8!=null, imgURL8, $Resource.no_image)}" url="{!if(imgURL8!=null, imgURL8, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId8" value="{!imgValue8}" onchange="doUpdateImage(this, 'img8')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns4">
                            <apex:outputLabel value="Answer 4"/>
                            <apex:image id="img4" value="{!if(imgURL4!=null, imgURL4, $Resource.no_image)}" url="{!if(imgURL4!=null, imgURL4, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId4" value="{!imgValue4}" onchange="doUpdateImage(this, 'img4')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns9">
                            <apex:outputLabel value="Answer 9 " style="margin-right: 10px;" />
                            <apex:image id="img9" value="{!if(imgURL9!=null, imgURL9, $Resource.no_image)}" url="{!if(imgURL9!=null, imgURL9, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId9" value="{!imgValue9}" onchange="doUpdateImage(this, 'img9')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns5">
                            <apex:outputLabel value="Answer 5"/>
                            <apex:image id="img5" value="{!if(imgURL5!=null, imgURL5, $Resource.no_image)}" url="{!if(imgURL5!=null, imgURL5, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId5" value="{!imgValue5}" onchange="doUpdateImage(this, 'img5')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns10">
                            <apex:outputLabel value="Answer 10" style="margin-right: 5px;"/>
                            <apex:image id="img10" value="{!if(imgURL10!=null, imgURL10, $Resource.no_image)}" url="{!if(imgURL10!=null, imgURL10, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId10" value="{!imgValue10}" onchange="doUpdateImage(this, 'img10')"/>
                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAnsBlank">

                        </apex:panelGrid>
                        <apex:panelGrid columns="3" id="panelAns11">
                            <apex:outputLabel value="Answer 11" style="margin-right: 5px;"/>
                            <apex:image id="img11" value="{!if(imgURL11!=null, imgURL11, $Resource.no_image)}" url="{!if(imgURL11!=null, imgURL11, $Resource.no_image)}" width="48" height="48"/>
                            <apex:inputFile id="inputImgId11" value="{!imgValue11}" onchange="doUpdateImage(this, 'img11')"/>
                        </apex:panelGrid>
                    </apex:pageBlockSection>
                </apex:pageBlock>
            </apex:form>
        </apex:tab>
        
        <!-- RESULT -->
        <!--
        <apex:tab label="{!$Label.LABS_SF_Results}" name="name3" id="tabThree">
            <c:viewSurveyResultsComponent surveyId="{!Survey__c.Id}" />
            <apex:actionSupport event="onclick" rerender="tabThree"/>
        </apex:tab>
        -->
    </apex:tabPanel>
</apex:page>