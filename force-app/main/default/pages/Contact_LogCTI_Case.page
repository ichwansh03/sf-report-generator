<apex:page standardController="Contact" extensions="Contact_LogCTI_Case" >
    <apex:include pageName="PageJS"/>
    <apex:pageBlock >
    	<apex:pageBlockTable value="{!MappingAction}" var="val">
            <apex:column headerValue="Date" ><apex:outputText value="{0, date, dd MMMM yyyy}"><apex:param value="{!val.thisdate}" /></apex:outputText></apex:column>
            <apex:column headerValue="History Call"><apex:repeat value="{!val.listcti}" var="cti"><apex:outputLink value="/{!cti.id}" onClick="consolelink('/{!cti.id}', '_blank');return false;">{!cti.name}</apex:outputLink> <br/></apex:repeat></apex:column>
            <apex:column headerValue="Case"><apex:repeat value="{!val.listcs}" var="cs"><apex:outputLink value="/{!cs.id}" onClick="consolelink('/{!cs.id}', '_blank');return false;">{!cs.casenumber}</apex:outputLink><br/></apex:repeat></apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
</apex:page>