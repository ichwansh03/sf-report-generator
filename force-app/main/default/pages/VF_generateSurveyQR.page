<apex:page standardController="Contact" extensions="generateSurveyQR" showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" language="en-US" contentType="text/html; charset=utf-8" cache="false">
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        </script>
    
    <style>
        .qrCode-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 10px;
        background-color: #f1f1f1;
        height: 360px;
        }
        
        .qrCode-image {
        width: 200px;
        height: 200px;
        }
        
        .custom-link {
        display: inline-block;
        padding: 8px 16px;
        background-color: transparent;
        color: black;
        text-decoration: none;
        border: 1px solid black;
        border-radius: 4px;
        }
        
        .custom-link:hover {
        background-color: #0056b3;
        color: white;
        border-color: #0056b3;
        }
    </style>
    <apex:outputPanel styleClass="qrCode-container">
        <apex:image value="{!generateQRCode}" styleClass="qrCode-image" /><br/><br/>
        <apex:outputLink value="{!surveyUrl}" target="_blank" styleClass="custom-link">Survey Here</apex:outputLink>
    </apex:outputPanel>
    
    
</apex:page>