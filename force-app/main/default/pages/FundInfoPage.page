        function loadDataPagingFundPriceHistory(policyNo, entity, policyApp, startDateTime, endDateTime, fundCode, 
                rowPerPage, startOfRecords, numberOfRecords, pageNumber ) {
                    console.log(policyNo + '-' + entity + '-' + policyApp + '-' + startDateTime + '-' + endDateTime + '-' + 
                                rowPerPage + '-' + startOfRecords + '-' + numberOfRecords + '-' + pageNumber);
                    var fundPriceHistoryHolderObj = document.getElementById('{!$Component.formid.blockid.fundPriceHistoryHolder}');
                    console.log('starting load data paging fund price history');
                    displayLoading('loadingimgFundPriceHistory'); //indah 30juli2018 add loadingbar

                    if (fundPriceHistoryPaging[pageNumber] != null || fundPriceHistoryPaging[pageNumber] != undefined) {
                        fundPriceHistoryHolderObj.value = fundPriceHistoryPaging[pageNumber];
                        // console.log(':' + fundPriceHistoryPaging[pageNumber]);
                        refreshFundPriceHistory(); refreshPageMessages();
                        hideLoading('loadingimgFundPriceHistory'); //indah 30juli2018 add loadingbar
                    } else {
                        Visualforce.remoting.Manager.invokeAction(
                            // param : String policyNo, String entity, String policyApp, 
                            // String startDateTime, String endDateTime, Integer rowPerPage, Integer startOfRecords, Integer numberOfRecords, Integer pageNumber
                            '{!$RemoteAction.RemoteDataController.getRemoteDataProductFundDetail}',
                                policyNo, entity, policyApp, 'Fund', startDateTime, endDateTime, fundCode, rowPerPage, startOfRecords, numberOfRecords, pageNumber,
                            function (result, event) {
                                if (event.status) {
                                    //alert(result);
                                    // displayLoading('loadingimgFundPriceHistory'); //indah 30juli2018 add loadingbar
                                    fundPriceHistoryPaging[pageNumber] = result;
                                    // console.log('loadDataPagingFundPriceHistory :' + fundPriceHistoryPaging[pageNumber]);
                                    fundPriceHistoryHolderObj.value = result;
                                    refreshFundPriceHistory(); refreshPageMessages();
                                    hideLoading('loadingimgFundPriceHistory'); //indah 30juli2018 add loadingbar
                                    console.log('end of load data paging fund price history')
                                }
                            }, {escape: true}
                        );
                    }
                }

        var listOfFundHistory = new Array();

        function loadFundTransaction () {
            //console.log(convertDate(dpFTStart.value) + ' - ' + convertDate(dpFTEnd.value));
            
            //loadDataPagingFundHistory(policyNo, entity, policyApp, startDateTime, endDateTime, 100, 1, 100, 1 );
            if(dpFTStart.value != '' && dpFTEnd.value != ''){
                fundHistoryPaging[1] = null;
                pagerFundH.showPage(1);
                listOfFundHistory = new Array();
                var pagingNewFundHistoryDiv = document.getElementById('pagingNewFundHistoryDiv');
                pagingNewFundHistoryDiv.style = 'display:block;'
            }else{
                alert("Start Transaction & End Transaction can't be null");
            }
        }

        function nextLoadFundTransaction () {
            var fundHistoryLastDate = document.getElementById('{!$Component.formid.blockid.fundtransaction.fundHistoryLastDate}').value;
            console.log('cek fund history value next : '+fundHistoryLastDate);
            fundHistoryPaging[1] = null;
            listOfFundHistory.push(fundHistoryLastDate);
            pagerFundH.showPage(fundHistoryLastDate);
        }

        function prevLoadFundTransaction () {
            var fundHistoryLastDate = listOfFundHistory.pop();
            fundHistoryLastDate = listOfFundHistory.pop();
            console.log('cek fund history value prev : '+fundHistoryLastDate);
            fundHistoryPaging[1] = null;
            if(fundHistoryLastDate == null || typeof fundHistoryLastDate == 'undefined'){
                pagerFundH.showPage(1);
            }else{
                pagerFundH.showPage(fundHistoryLastDate);
            }
        }
        
        function loadFundPriceHistory () {
            fundPriceHistoryPaging[1] = null;
            pagerFundPH.showPage(1);
        }
    
        
    
        function openNewSubTabX(tabName) {
           sforce.console.getEnclosingPrimaryTabId(openSubtab);
        }

        function openNewTabXX(tabName) {
           alert("go");
        }
    
        function openNewTab(tabName, arg2, arg3, arg4) {
            //alert("go");
            switch (tabName) {
                case 'GENERATEFUND' :
                    urlRequestNewTab = '/apex/FundInfoPagePDF?parentId=' + parentId 
                    + '&contactID=' + contactID + '&sessionID=' + '{!sessionID}' + '&policyNo=' + policyNo + '&entity=' + entity + '&policyApp=' + policyApp + '&startDateTime=' + startDateTime + '&endDateTime=' + endDateTime;
                    titleSubTab = 'GENERATE FUND';
                    break;
            }
            if (sforce.console.isInConsole()) {
                sforce.console.getEnclosingPrimaryTabId(openSubTab);
            } else {
                //window.location.href = urlRequestNewTab;
                //window.parent.location.href=(urlRequestNewTab);
                javascript:var x=window.open(urlRequestNewTab,'_blank');
            }
        }
    </script>
    

