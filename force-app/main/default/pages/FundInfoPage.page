  <script type="text/javascript"> 
        var Imtech = {};
        Imtech.Pager = function() {
            this.datasetname = '';
            this.pagername = '';
            this.paragraphsPerPage = 100;
            this.currentPage = 1;
            this.pagingControlsContainer = '';
            //this.pagingContainerPath = '#content';
            this.pagingInfoContainer = '';
            this.numberOfRecords = 0;
            
            this.firstPage = 1;
            this.previousPage = 1;
            this.nextPage = 2;
            this.numPages = 5;
            this.lastDataPage = 0;
            this.lastPage = this.numPages;
            this.showPage = function(page) {
                
                //alert('page selected : ' + page);
                var startOfRecords = 0;
                
                // Set start time
                var start_time = new Date().getTime();
                
                switch (this.datasetname) {
                    case "FundHistory":
                        if(page == 1){
                            // first load
                            //alert('r');
                            startOfRecords = (this.numberOfRecords * (page - 1)) + 1;
                            //loadDataPagingFundHistory(policyNo, entity, policyApp, '', '', 0, startOfRecords, numberOfRecords, page) ; break;
                            console.log(convertDate(dpFTStart.value) + ' - ' + convertDate(dpFTEnd.value));
                            
                            startDateTime = dpFTStart.value + ' 00:00:00';
                            endDateTime = dpFTEnd.value + ' 23:59:59';
                            console.log(' date start  '+ startDateTime + '; date end  '+ endDateTime);
                            loadDataPagingFundHistory(policyNo, entity, policyApp, startDateTime, endDateTime, this.numberOfRecords, startOfRecords, this.numberOfRecords, this.currentPage, page, 1, 1 ); break;
                        }else{
                            // next load
                            startOfRecords = (this.numberOfRecords * (1 - 1)) + 1;
                            console.log(convertDate(dpFTStart.value) + ' - ' + convertDate(page));
                            
                            startDateTime = dpFTStart.value + ' 00:00:00';
                            endDateTime = page + ' 23:59:59';

                            console.log(' date start  '+ startDateTime + '; date end  '+ endDateTime);
                            loadDataPagingFundHistory(policyNo, entity, policyApp, startDateTime, endDateTime, this.numberOfRecords, startOfRecords, this.numberOfRecords, this.currentPage, 1, 1, 1 ); break;
                        }
                        
                    case "FundDetail":
                        //alert('s');
                        startOfRecords = (this.numberOfRecords * (page - 1)) + 1;
                        loadDataPagingFundDetail(policyNo, entity, policyApp, '', '', this.numberOfRecords, startOfRecords, this.numberOfRecords, this.currentPage, page, 1, 0) ; break;

                        
                    case "FundPriceHistory":
                        //alert('t');
                        startOfRecords = (this.numberOfRecords * (page - 1)) + 1;
                        startDateTime = dpFPHStart.value + ' 00:00:00';
                        endDateTime = dpFPHEnd.value + ' 23:59:59';
                        var fundCode = txtFPHFundCode.value;
                        
                        console.log ('FundPriceHistory ', policyNo + '-' + entity + '-' + policyApp + '-' + startDateTime + '-' + endDateTime + '-' + fundCode + '-' + startOfRecords + '-' + this.numberOfRecords + '-' );
                        loadDataPagingFundPriceHistory(policyNo, entity, policyApp, startDateTime, endDateTime, fundCode, this.numberOfRecords, startOfRecords, this.numberOfRecords, page, 1, 1) ; break;
    
                }

                var request_time = new Date().getTime() - start_time;
                var request_times = new Date().getTime() + ' - ' + start_time + ' : ' +request_time;
                
                //renderControls(this.pagingControlsContainer, page, this.numPages, this.pagername, request_times, this.lastDataPage);
                if(page == 1){
                    this.currentPage = page;
                }else{
                    this.currentPage = 1;
                }
            }
            
            this.reRenderControls = function () {
                console.log('lastDataPage : ' + this.lastDataPage);
                renderControls(this.pagingControlsContainer, this.currentPage, this.numPages, this.pagername, '', this.lastDataPage);
                //this.currentPage = page;
            }
        
            var renderControls = function(container, currentPage, numPages, pagername, requestTime, lastDataPage ) {
                /*
                var firstPage = 1;
                var previousPage = currentPage==1 ? 1 : currentPage - 1 ;
                var nextPage = currentPage + 1;
                var lastPage = numPages;
                */
                console.log (' ** in renderControls **');
                var firstPage = 1;
                var previousPage = currentPage == 1 ? 1 : currentPage - 1 ;
                //var nextPage = currentPage==numPages ? numPages : currentPage + 1;
                var nextPage = currentPage + 1;
                var lastPage = numPages;
                
                var pagingControls = '';
                var htmlBtnStatus ='';
                
                //pagingControls += '<img id="loadingimg' + pagername + '" style="display:none" src="/img/loading.gif" /> ' ;
                pagingControls += '<ul class="pagination">' ;
                
                if (currentPage == 1) {htmlBtnStatus = ' class="disabled" ';} else {htmlBtnStatus = ' href="#" ';}
                pagingControls += '<li> <a ' + htmlBtnStatus + ' onclick="' + pagernam +'.showPage(' + firstPag + '); return false;"> First </a> </li> ';
                pagingControls += '<li> <a ' + htmlBtnStatus + ' onclick="' + pagernam +'.showPage(' + previousPag + '); return false;"> Previous </a> </li>';
                
                var j = 0;
                var penambah = currentPage - 2;
                if (currentPage == 1) {penambah = 0;}
                
                for (var i = 1; i <= numPages; i++) {
                    //console.log('<li><a href="#" onclick="pager.showPage(' + j + '); return false;">' + j + '</a></li>');
                    j = i + penambah;
                    if (j != currentPage) {
                        if (j > lastDataPage && lastDataPage != 0) {
                            //pagingControls += '<li>' + j + '</li>';
                            pagingControls += '<li><a class="disabled" >' + j + '</a></li>';
                        } else {
                            pagingControls += '<li><a href="#" onclick="' + pagername +'.showPage(' + j + '); return false;">' + j + '</a></li>';
                        }
                    } else {
                        pagingControls += '<li><a class="active" >' + j + '</a></li>';
                    }
                }
                
                if ( currentPage >= lastDataPage && lastDataPage != 0) {
                    pagingControls += '<li><a class="disabled"> Next </a> </li>';
                }
                else {
                    pagingControls += '<li> <a href="#" onclick="' + pagername +'.showPage(' + nextPage + '); return false;"> Next </a> </li>';
                }
                pagingControls += '</ul>';
        
                $(container).html(pagingControls);
            }
            
            this.renderInfo = function(info) {
                info = '<small><i>' + info + '</i></small>';
                $( this.pagingInfoContainer).html(info);
            }
        }

    </script>
    
