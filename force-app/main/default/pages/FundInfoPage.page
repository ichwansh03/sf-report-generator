        $("#dpFTStart").on("change", function () {
            var fromdate = $(this).val();
        });
        $("#dpFTEnd").datepicker(
            {dateFormat: 'yy-mm-dd', appendText: " (yyyy-mm-dd)", changeMonth: true, changeYear: true}
