        function loadDataPagingFundHistory(policyNo, entity, policyApp, startDateTime, endDateTime, 
                rowPerPage, startOfRecords, numberOfRecords, currentPage, pageNumber, show, extra) {
                    console.log('parameters: ' + policyNo + '-' + entity + '-' + policyApp + '-' + startDateTime + '-' + endDateTime + '-' + rowPerPage + '-' + startOfRecords + '-' + numberOfRecords + '-' + pageNumber + '-' + show + '-' + extra);
                    var fundHistoryHolderObj = document.getElementById('{!$Component.formid.blockid.fundHistoryHolder}');

                    var start_time = null;
                    var end_time = null;
                    var duration = null;
                    
                    if (fundHistoryPaging[pageNumber] != null || fundHistoryPaging[pageNumber] != undefined) {
                        
                        if (show == 1 && currentPage == pageNumber) {
                            pagerFundH.lastDataPage = 0{!fundHistoryLastPageNo};
                            pagerFundH.reRenderControls();
                        }
                        else if (show == 1 && currentPage != pageNumber) {
                            start_time = performance.now();//new Date().getTime(); 
                            displayLoading('loadingimgFundHistory');
                            
                            console.log('set var on sfdc');
                            fundHistoryHolderObj.value = fundHistoryPaging[pageNumber];
                            //console.log('jadi:' + fundHistoryPaging[pageNumber]); 
                            refreshFundHistory(); refreshPageMessages();
                            hideLoading('loadingimgFundHistory');
                            
                            end_time = performance.now();//new Date().getTime();
                            duration = end_time - start_time;
                            duration = duration.toFixed(3);
                            pagerFundH.renderInfo('Load duration : ' + duration + ' milliseconds');
                            console.log('duration : ' + duration);
                            
                        }
                        // lazy loading for next page ::
                        var nextPageNumber = pageNumber + 1;
                        console.log('extra : ' + extra);
                        if (extra > 0 && (fundHistoryPaging[nextPageNumber] == null || fundHistoryPaging[nextPageNumber] == undefined)) {
                            extra = extra - 1;
                            console.log('masuk : ' + nextPageNumber);
                            startOfRecords = (numberOfRecords * (nextPageNumber - 1)) + 1;
                            loadDataPagingFundHistory(policyNo, entity, policyApp, startDateTime, endDateTime, rowPerPage, startOfRecords, numberOfRecords, currentPage, nextPageNumber, 0, extra) ;
                        }

                    } else {
                        //alert ('getRemoteDataFundHistory, extra: ' + extra + ', show : ' + show);
                        if (show == 1) {displayLoading('loadingimgFundHistory');}
                        start_time = performance.now(); //new Date().getTime(); 
                        Visualforce.remoting.Manager.invokeAction(
                            // param : 
