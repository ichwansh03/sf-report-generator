<apex:page standardController="LiveChatButton" extensions="LiveChatConfigController" showHeader="true" standardStylesheets="false" sidebar="false" docType="html-5.0" applyBodyTag="False">

    <apex:includeScript value="{!URLFOR($Resource.Jquery)}"  />
    
    <style>
        .ct{
        text-align:center;
        }
    </style>
    <script type="text/javascript">
    function cancel(){
        var urlRequestNewTab = '/apex/LiveChatConfig';
        javascript:var x=window.open(urlRequestNewTab,'_self');
    }
    </script>
    
    <body class="slds-scope">
        <apex:sectionHeader title="Live Chat Edit Messages"/>
        <apex:pageMessages escape="false" id="errorMsgId"/>
        <apex:form >
            <apex:pageBlock >
                <apex:pageBlockSection columns="1">
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Channel"></apex:outputLabel>
                        <apex:inputText disabled="true" value="{!channel}"/>
                    </apex:pageBlockSectionItem>
                    <apex:pageBlockSectionItem >
                        <apex:outputLabel value="Live Chat Status Agent {!msgstatuses} Message :"/>
                        <apex:inputTextarea value="{!messages}" required="true"/>
                    </apex:pageBlockSectionItem>
                </apex:pageBlockSection>
                <apex:pageBlockButtons location="bottom">
                    <apex:commandButton style="display:{!IF(msgstatuses == 'Active','','none')}" value="Save" action="{!saveMessageActive}" styleClass="slds-button slds-button_brand"/>
                    <apex:commandButton style="display:{!IF(msgstatuses == 'Inactive','','none')}" value="Save" action="{!saveMessageInactive}" styleClass="slds-button slds-button_brand"/>
                    <apex:commandButton value="Back" action="{!URLFOR($Page.LiveChatConfig)}" immediate="true" styleClass="slds-button slds-button_brand"/>
                </apex:pageBlockButtons>
            </apex:pageBlock>
        </apex:form>
    </body>
</apex:page>