<apex:page controller="Purecloud_Manual_Service" docType="html-5.0">
    <apex:form id="formid" >
        <apex:pageMessages id="msgid" />
        <apex:pageBlock id="pbid">
            <apex:pageBlockButtons >
                <apex:commandButton action="{!action}" value="Action" reRender="formid" />
            </apex:pageBlockButtons>
            <apex:pageBlockSection >
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Category Service</apex:outputLabel>
                    <apex:selectList value="{!Pilihan}" size="1">
                        <apex:selectOptions value="{!CategoryService}" />
                        <apex:actionSupport event="onchange" reRender="ChooseUser"/>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem ></apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockSection >
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Tanggal</apex:outputLabel>
                    <apex:input type="date" value="{!tgl}" />
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:outputPanel id="ChooseUser">
            <apex:pageBlockSection rendered="{!IF(Pilihan=='Call Agent Status',true,false)}">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Entity</apex:outputLabel>
                    <apex:inputField id="UserEntity" value="{!ChooseUser.Entity__c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockSection rendered="{!IF(Pilihan=='Call Agent Status',true,false)}">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel >Each User?</apex:outputLabel>
                    <apex:inputField id="contactName" value="{!ChooseUser.User__c}"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            </apex:outputPanel>
            
            <!--
            <apex:outputPanel id="conId">
            <apex:pageBlockSection rendered="{!Pilihan == 'Purecloud IVR Survey Result'}" >
            	<apex:pageBlockSectionItem >
                    <apex:outputLabel >Conversation ID</apex:outputLabel>
                    <apex:input type="text" value="{!conversationId}"  required="true"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>    
            </apex:outputPanel>
            !-->
        </apex:pageBlock>
    </apex:form>
</apex:page>