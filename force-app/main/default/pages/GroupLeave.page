        <apex:repeat value="{!mapMW}" var="key" >
            <apex:pageBlock title="{!key}" id="pgblock" >
                <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                    <thead>
                        <tr class="slds-line-height_reset">
                            <th class="slds-text-title_caps" scope="col">
                                <div class="slds-truncate" title="Agent Name" style="width: 100px;">Agent Name</div>
                            </th>
                            <th class="slds-text-title_caps" scope="col">
                                <div class="slds-truncate" title="Agent Name" style="width: 100px;">Role</div>
                            </th>
                            <th class="slds-text-title_caps" scope="col">
                                <div class="slds-truncate" title="Available" style="width: 100px;">Available</div>
                            </th>
                            <th class="slds-text-title_caps" scope="col">
                                <div class="slds-truncate" title="Reason" style="width: 100px;">Status</div>
                            </th>
                            <th class="slds-text-title_caps" scope="col">
                                <div class="slds-truncate" title="Description" style="width: 100px;">Description</div>
                            </th>
                            <th class="slds-text-title_caps" scope="col">
                                <div class="slds-truncate" title="Edit" style="width: 100px;">Edit</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat value="{!mapMW[key]}" var="agents" id="pgblocktb">
                            <tr class="slds-hint-parent">
                                <td data-label="Agent Name">
                                    <div class="slds-truncate">
                                        <apex:outputText value="{!agents.agentName}" id="name"/>
                                    </div>
                                </td>
                                <td data-label="Role">
                                    <div class="slds-truncate">
                                        <apex:outputText value="{!agents.role}" id="id"/>
                                    </div>
                                </td>
                                <td data-label="Available">
                                    <div class="slds-truncate">
                                        <apex:inputCheckbox value="{!agents.isAvailable}" id="active" disabled="true"/>
                                       <!-- <div class="slds-form-element">
                                            <label class="slds-checkbox_toggle slds-grid" >
                                                <input name="checkbox-toggle-2" type="checkbox" aria-describedby="checkbox-toggle-2" value="{!agents.isAvailable}" />
                                                <span id="checkbox-toggle-2" class="slds-checkbox_faux_container" aria-live="assertive" >
                                                    <span class="slds-checkbox_faux"></span>
                                                    <span class="slds-checkbox_on" value="{!agents.isAvailable}">Available</span>
                                                    <span class="slds-checkbox_off" value="{!agents.isAvailable}">Not Available</span>
                                                </span>
                                            </label>
                                            
                                        </div>-->
                                    </div>
                                </td>
                                <td data-label="Reason">
                                    <div class="slds-truncate">
                                        <apex:outputText value="{!agents.leaveStatus}" id="rs"/>
                                    </div>
                                </td>
                                <td data-label="Description">
                                    <div class="slds-truncate" title="Description">{!agents.description}</div>
                                </td>
                                
                                <td data-label="Amount">
                                    <apex:outputPanel rendered="{!agents.isAvailable}">
                                        <div class="slds-truncate" >
                                            <!--<button class="slds-button slds-button_outline-brand" onclick="editLeave('{!agents.agentid}')">Edit</button>-->
                                            <input type="button" Class="slds-button slds-button_neutral" id="buttonEditId{!agents.agentid}" value="Edit" onclick="openLookupPopup('{!agents.agentid}', '{!agents.agentName}')" oncomplete="window.location.top.load();"/>
                                        </div>
                                    </apex:outputPanel>
                                </td>
                            </tr>
                        </apex:repeat>
                        
                    </tbody>
                </table>
            </apex:pageBlock>
        </apex:repeat>
