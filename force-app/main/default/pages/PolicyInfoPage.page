                                    assNotesHolderObj.value = result;
                                    
                                    if (classType == 'POS') {
                                        refreshAssNotesPOS();
                                    } else if (classType == 'PA') {
                                        refreshAssNotesPA();
                                    } else if (classType == 'UW') {
                                        refreshAssNotesUW();
                                    } else if (classType == 'OTH') {
                                        refreshAssNotesOTH();
                                    }
                                    
                                    refreshPageMessages();
                                }
                            }, {escape: true}
                        );
                    }
                }

